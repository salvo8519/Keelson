# {{ project_name }}: development, checks and deployment commands.
# Run `make` or `make help` for the list. Each target documents itself with `## text` on its
# line, and sections start with `##@`: the help is read from this file, so it cannot drift.

.DEFAULT_GOAL := help
SHELL := /bin/bash

.PHONY: help quickstart install bootstrap dev seed dev-down dev-logs dev-rebuild docker-clean \
	dev-frontend prod-local prod-local-down prod-local-logs prod prod-down prod-logs \
	run run-prod routes test test-cov lint format openapi openapi-check client \
	db-init db-migrate db-upgrade db-downgrade db-current db-history \
	create-admin user-create user-list celery-worker celery-beat celery-flower \
	taskiq-worker taskiq-scheduler docker-db docker-db-stop docker-redis docker-redis-stop \
	docker-shell skills skills-check skills-scan i18n-extract i18n-check docs docs-serve \
	docs-check upgrade upgrade-dry-run clean

help: ## Show this help
	@awk 'BEGIN {FS = ":.*## "} \
		/^##@/ {printf "\n%s\n", substr($$0, 5); next} \
		/^[a-zA-Z0-9_-]+:.*## / {printf "  make %-20s %s\n", $$1, $$2}' $(MAKEFILE_LIST)
	@echo ""
{%- if enable_docker %}

DEV = docker compose -f docker-compose.dev.yml $(COMPOSE_DEV_PROFILES)
PROD = docker compose --env-file backend/.env -f docker-compose.prod.yml
PROD_LOCAL = docker compose --env-file .env.prod-local -f docker-compose.prod.yml -f docker-compose.prod-local.yml

# Wait until PostgreSQL accepts connections in the stack run by $(1).
define _wait_for_db
	@echo "Waiting for PostgreSQL..."
	@for i in $$(seq 1 30); do \
		if $(1) exec -T db pg_isready -U postgres >/dev/null 2>&1; then echo "  database ready"; exit 0; fi; \
		printf '.'; sleep 2; \
	done; \
	echo "  the database did not start within 60 seconds; see the logs"; exit 1
endef

backend/.env:
	cp backend/.env.example backend/.env
	@echo "Created backend/.env from backend/.env.example (development values)."

##@ Getting started

quickstart: backend/.env dev{% if use_jwt %} seed{% endif %} ## First run from a fresh clone: configuration, dev stack, migrations{% if use_jwt %}, an admin user{% endif %}
	@echo ""
	@echo "Ready. Next:"
{%- if use_frontend %}
	@echo "  make dev-frontend     the web interface on http://localhost:{{ frontend_port }}"
{%- endif %}
	@echo "  make test             the backend test suite"
	@echo "  make prod-local       the production stack on this machine"
	@echo "  make help             every command"
{%- endif %}

install: ## Install the backend locally (no Docker) and write the API contract
	uv sync --directory backend --dev
	cd backend && uv run python ../scripts/openapi.py export
{%- if enable_precommit %}
	@if git rev-parse --git-dir > /dev/null 2>&1; then \
		uv run --directory backend pre-commit install; \
	else \
		echo "Not a git repository: pre-commit hooks not installed (git init, then make install)"; \
	fi
{%- endif %}
{%- if enable_docker %}

##@ Development stack (Docker, source mounted, reload on change)

dev: backend/.env ## Build and start the development stack, apply migrations (idempotent)
	$(DEV) build app
	@if ! $(DEV) up -d; then \
		echo "First start failed: removing stale containers and retrying once (volumes kept)"; \
		$(DEV) down --remove-orphans; \
		$(DEV) up -d; \
	fi
	$(call _wait_for_db,$(DEV))
	$(DEV) exec -T app {{ project_slug }} db upgrade
	@echo ""
	@echo "Development stack ready:"
	@echo "  API            http://localhost:{{ backend_port }}"
	@echo "  API reference  http://localhost:{{ backend_port }}/docs"
{%- if use_frontend %}
	@echo "  Frontend       make dev-frontend, or: cd frontend && bun dev"
{%- endif %}
{%- if use_jwt %}

seed: ## Create the development administrator (admin@example.com / admin123), once
	@if $(DEV) exec -T app {{ project_slug }} user list 2>/dev/null | grep -q "admin@example.com"; then \
		echo "admin@example.com already exists"; \
	else \
		$(DEV) exec -T app {{ project_slug }} user create \
			--email admin@example.com --password admin123 --superuser \
		&& echo "Created admin@example.com / admin123 (development only: never in production)"; \
	fi

bootstrap: dev seed ## Same as quickstart, without creating backend/.env
{%- else %}

bootstrap: dev ## Same as quickstart, without creating backend/.env
{%- endif %}

dev-down: ## Stop the development stack
	$(DEV) down

dev-logs: ## Follow the logs of the development stack
	$(DEV) logs -f

dev-rebuild: ## Rebuild the backend image from scratch and restart it
	$(DEV) build --no-cache app
	$(DEV) up -d --force-recreate app

docker-clean: ## Remove the development stack with its volumes (deletes local data)
	$(DEV) down -v --remove-orphans
{%- if use_frontend %}

dev-frontend: ## Build and serve the frontend on http://localhost:{{ frontend_port }} (after make dev)
	docker compose -f docker-compose.frontend.yml up -d --build
{%- endif %}

docker-shell: ## Open a shell in the backend container
	$(DEV) exec app /bin/bash

##@ Production stack on this machine (a rehearsal, not a deployment)

# Keelson: written with umask 077, so only the owner can read the secrets.
.env.prod-local:
	@umask 077; python3 -c "import secrets; t = secrets.token_hex; \
	print('# Generated by make prod-local: random local secrets, never committed.'); \
	print(f'SECRET_KEY={t(32)}'); print(f'API_KEY={t(32)}'); \
	print(f'POSTGRES_PASSWORD={t(24)}'); print(f'POSTGRES_APP_PASSWORD={t(24)}'); \
	print(f'REDIS_PASSWORD={t(24)}'); print(f'DATA_ENCRYPTION_KEYS={t(32)}'){% if enable_prometheus %}; \
	print(f'PROMETHEUS_AUTH_TOKEN={t(32)}'){% endif %}{% if include_traefik_service or include_traefik_labels %}; \
	print('# Read by docker-compose.prod.yml; Traefik is not started by the rehearsal.'); \
	print('DOMAIN=localhost'); print('ACME_EMAIL=unused@localhost.invalid'); \
	print('TRAEFIK_DASHBOARD_AUTH=unused'){% endif %}{% if use_telegram or use_slack %}; \
	print(f'CHANNEL_ENCRYPTION_KEY={t(32)}'){% endif %}{% if use_celery %}; \
	print(f'FLOWER_PASSWORD={t(16)}'){% endif %}{% if enable_file_storage %}; \
	print(f'GARAGE_RPC_SECRET={t(32)}'); print(f'GARAGE_ADMIN_TOKEN={t(32)}'); \
	print(f'S3_ACCESS_KEY=GK{t(12)}'); print(f'S3_SECRET_KEY={t(32)}'){% endif %}" > $@
	@echo "Generated .env.prod-local with random secrets (ignored by git)."

prod-local: backend/.env .env.prod-local ## Build and start the production stack on localhost (production settings, plain HTTP)
	$(PROD_LOCAL) up -d --build
	$(call _wait_for_db,$(PROD_LOCAL))
	$(PROD_LOCAL) exec -T app {{ project_slug }} db upgrade
	@echo ""
	@echo "Production stack running on this machine (ENVIRONMENT=production):"
	@echo "  API       http://localhost:{{ backend_port }}  (the reference at /docs is off in production)"
{%- if use_frontend %}
	@echo "  Frontend  http://localhost:{{ frontend_port }}"
{%- endif %}

prod-local-down: ## Stop the local production stack (volumes kept)
	$(PROD_LOCAL) down

prod-local-logs: ## Follow the logs of the local production stack
	$(PROD_LOCAL) logs -f

##@ Production (Docker Compose with Traefik and TLS, secrets in backend/.env)

prod: ## Build and start the production stack, apply migrations
	@test -f backend/.env || (echo "backend/.env is missing: copy backend/.env.example and set real secrets" && exit 1)
	$(PROD) up -d --build
	$(call _wait_for_db,$(PROD))
	$(PROD) exec -T app {{ project_slug }} db upgrade
	@echo "Production stack running behind Traefik (DOMAIN and ACME_EMAIL in backend/.env)."

prod-down: ## Stop the production stack
	$(PROD) down

prod-logs: ## Follow the logs of the production stack
	$(PROD) logs -f
{%- endif %}

##@ Backend without Docker

run: ## Start the API with reload on change
	uv run --directory backend {{ project_slug }} server run --reload

run-prod: ## Start the API as in production (no reload)
	uv run --directory backend {{ project_slug }} server run --host 0.0.0.0 --port {{ backend_port }}

routes: ## List the API routes
	uv run --directory backend {{ project_slug }} server routes
{%- if use_celery %}

celery-worker: ## Start a Celery worker
	uv run --directory backend {{ project_slug }} celery worker

celery-beat: ## Start the Celery scheduler
	uv run --directory backend {{ project_slug }} celery beat

celery-flower: ## Start Flower, the Celery monitor, on http://localhost:5555
	uv run --directory backend {{ project_slug }} celery flower
{%- endif %}
{%- if use_taskiq %}

taskiq-worker: ## Start a Taskiq worker
	uv run --directory backend {{ project_slug }} taskiq worker

taskiq-scheduler: ## Start the Taskiq scheduler
	uv run --directory backend {{ project_slug }} taskiq scheduler
{%- endif %}
{%- if enable_docker %}

docker-db: ## Start only PostgreSQL in Docker, for a backend run on the host
	docker compose up -d db

docker-db-stop: ## Stop that PostgreSQL
	docker compose stop db
{%- if enable_redis %}

docker-redis: ## Start only Redis in Docker, for a backend run on the host
	docker compose up -d redis

docker-redis-stop: ## Stop that Redis
	docker compose stop redis
{%- endif %}
{%- endif %}

##@ Quality

test: ## Run the backend tests (PostgreSQL tests need a database: make docker-db)
	uv run --directory backend pytest tests/ -v

test-cov: ## Run the backend tests with a coverage report (htmlcov/)
	uv run --directory backend pytest tests/ -v --cov=app --cov-report=html --cov-report=term-missing

lint: ## Lint, format check and type check of the backend
	uv run --directory backend ruff check app tests cli
	uv run --directory backend ruff format app tests cli --check
	uv run --directory backend ty check

format: ## Format the backend and apply safe lint fixes
	uv run --directory backend ruff format app tests cli
	uv run --directory backend ruff check app tests cli --fix

##@ API contract (openapi/openapi.json)

openapi: ## Write the API contract from the code
	cd backend && uv run python ../scripts/openapi.py export

openapi-check: ## Fail when the API contract does not match the code
	cd backend && uv run python ../scripts/openapi.py check
{%- if use_frontend %}

client: ## Write the contract, then regenerate the frontend API client from it
	./scripts/generate-client.sh
{%- endif %}

##@ Database

db-init: ## Start PostgreSQL{% if enable_docker %} (Docker){% endif %} and apply the migrations
{%- if enable_docker %}
	docker compose up -d db
	@sleep 5
{%- endif %}
	cd backend && uv run {{ project_slug }} db upgrade

db-migrate: ## Create a migration from the model changes (asks for a message)
	@read -p "Migration message: " msg; \
	uv run --directory backend {{ project_slug }} db migrate -m "$$msg"

db-upgrade: ## Apply the migrations
	uv run --directory backend {{ project_slug }} db upgrade

db-downgrade: ## Revert the last migration
	uv run --directory backend {{ project_slug }} db downgrade

db-current: ## Show the current migration
	uv run --directory backend {{ project_slug }} db current

db-history: ## Show the migration history
	uv run --directory backend {{ project_slug }} db history
{%- if use_jwt %}

##@ Users

create-admin: ## Create an administrator (interactive)
	uv run --directory backend {{ project_slug }} user create-admin

user-create: ## Create a user (interactive)
	uv run --directory backend {{ project_slug }} user create

user-list: ## List the users
	uv run --directory backend {{ project_slug }} user list
{%- endif %}

##@ Agent skills, translations and documentation

skills: ## Install the agent skills of the components (pinned, verified, scanned)
	python3 scripts/agent_skills.py install

skills-check: ## Fail when an installed skill is missing, stale or changed
	python3 scripts/agent_skills.py check

skills-scan: ## Show the content scan of the installed skills
	python3 scripts/agent_skills.py scan

i18n-extract: ## Update the message catalogs from the code
	uv run --directory backend python -m app.core.i18n_catalog extract

i18n-check: ## Fail when a message is untranslated
	uv run --directory backend python -m app.core.i18n_catalog check

DOCS_RUN = uv run --no-project --with-requirements docs/requirements.txt python
DOCS_LANG ?= en

docs: ## Build the documentation site (every language, strict, reference from the code)
	cd backend && uv run python ../scripts/docs_reference.py
	$(DOCS_RUN) scripts/docs.py build

docs-serve: ## Preview the documentation (DOCS_LANG=it for the Italian edition)
	cd backend && uv run python ../scripts/docs_reference.py
	$(DOCS_RUN) scripts/docs.py serve --lang $(DOCS_LANG)

docs-check: ## Fail when a translation is missing or older than its English page
	$(DOCS_RUN) scripts/i18n.py check

##@ Maintenance

upgrade: ## Bring in the latest template changes (Copier, three-way merge)
	uvx copier update --trust $(ARGS)

upgrade-dry-run: ## Preview the template changes without applying them
	uvx copier update --trust --pretend $(ARGS)

clean: ## Remove caches and coverage files
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name .pytest_cache -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name .ruff_cache -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name .ty_cache -exec rm -rf {} + 2>/dev/null || true
	rm -rf htmlcov/ .coverage coverage.xml
