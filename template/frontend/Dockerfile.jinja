# Keelson: static build of the React frontend, served by nginx with client-side routing.
FROM oven/bun:{{ bun_version }} AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
# The API address is baked into the bundle at build time; it must be reachable by the browser.
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}
RUN bun run build

FROM nginx:1.29-alpine
ARG VITE_API_URL=http://localhost:8000
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/security-headers.conf
# The Content Security Policy allows API calls to the origin (scheme, host, port) of VITE_API_URL.
RUN API_ORIGIN="$(printf '%s' "$VITE_API_URL" | sed -E 's#^(https?://[^/]+).*#\1#')" \
    && sed -i "s#__API_ORIGIN__#${API_ORIGIN}#" /etc/nginx/security-headers.conf \
    && nginx -t
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
