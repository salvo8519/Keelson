{%- if enable_teams and use_postgresql %}
"""Tenant isolation enforced by PostgreSQL row level security (Keelson).

The first test needs no database: every table with an ``organization_id`` column must be
isolated or explicitly exempted, so a new table cannot be forgotten.

The others run against a real PostgreSQL, in a throwaway schema, and are skipped when none
is reachable (``POSTGRES_*`` settings). They prove the barrier is in the database: a raw SQL
query without any filter, run by a session bound to one organization, sees only that
organization's rows.
"""

import uuid
from unittest.mock import AsyncMock, MagicMock, patch

import asyncpg
import pytest
from sqlalchemy import text
from sqlalchemy.engine import make_url
from sqlalchemy.exc import DBAPIError
from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine

from app.core.config import settings
{%- if use_sqlmodel %}
from sqlmodel import SQLModel as _Base
{%- else %}
from app.db.base import Base as _Base
{%- endif %}
import app.db.models  # noqa: F401  (registers every table on the metadata)
from app.db.tenancy import (
    TENANT_ROLE,
    TENANT_SETTING,
    TENANT_TABLES,
    UNISOLATED_TABLES,
    bind_organization,
    bound_organization,
    grant_statements,
    policy_statements,
)


def test_every_table_with_an_organization_is_isolated_or_exempted() -> None:
    with_org = {
        table.name for table in _Base.metadata.tables.values() if "organization_id" in table.c
    }
    forgotten = with_org - set(TENANT_TABLES) - set(UNISOLATED_TABLES)
    assert not forgotten, f"add these tables to TENANT_TABLES or UNISOLATED_TABLES: {forgotten}"


@pytest.mark.anyio
@pytest.mark.parametrize("with_header", [False, True])
async def test_active_organization_binds_the_request_session(with_header: bool) -> None:
    """Every route that depends on ActiveOrg runs under the row level security of that org."""
    from app.api import deps

    org = MagicMock(id=uuid.uuid4())
    user = MagicMock(id=uuid.uuid4())
    db = MagicMock()
    with (
        patch.object(deps.organization_repo, "get_personal_for_user", AsyncMock(return_value=org)),
        patch.object(deps.organization_repo, "get_by_id", AsyncMock(return_value=org)),
        patch.object(deps.member_repo, "get", AsyncMock(return_value=MagicMock())),
        patch.object(deps, "bind_organization", AsyncMock()) as bind,
    ):
        resolved = await deps.get_active_organization(
            user=user, db=db, x_organization_id=org.id if with_header else None
        )
    assert resolved is org
    bind.assert_awaited_once_with(db, org.id)


def _dsn() -> str:
    return make_url(settings.DATABASE_URL).set(drivername="postgresql").render_as_string(
        hide_password=False
    )


async def _postgres_reachable() -> bool:
    try:
        connection = await asyncpg.connect(_dsn(), timeout=3)
    except (OSError, asyncpg.PostgresError):
        return False
    await connection.close()
    return True


@pytest.fixture
async def sessions():
    """A session factory on a throwaway schema with one isolated table, ``notes``."""
    if not await _postgres_reachable():
        pytest.skip("No live PostgreSQL for the row level security tests")
    schema = f"rls_{uuid.uuid4().hex[:12]}"
    admin = create_async_engine(settings.DATABASE_URL)
    async with admin.begin() as connection:
        await connection.execute(text(f'CREATE SCHEMA "{schema}"'))
        await connection.execute(text(f'SET LOCAL search_path TO "{schema}"'))
        await connection.execute(
            text(
                "CREATE TABLE notes (id uuid PRIMARY KEY, organization_id uuid, body text NOT NULL)"
            )
        )
        for statement in grant_statements(schema) + policy_statements("notes"):
            await connection.execute(text(statement))
    engine = create_async_engine(
        settings.DATABASE_URL, connect_args={"server_settings": {"search_path": schema}}
    )
    try:
        yield async_sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
    finally:
        await engine.dispose()
        async with admin.begin() as connection:
            await connection.execute(text(f'DROP SCHEMA "{schema}" CASCADE'))
        await admin.dispose()


async def _insert(session: AsyncSession, organization_id: uuid.UUID | None, body: str) -> None:
    await session.execute(
        text("INSERT INTO notes (id, organization_id, body) VALUES (:id, :org, :body)"),
        {"id": uuid.uuid4(), "org": organization_id, "body": body},
    )


async def _bodies(session: AsyncSession) -> set[str]:
    return set((await session.execute(text("SELECT body FROM notes"))).scalars())


@pytest.mark.anyio
async def test_bound_session_sees_only_its_organization(sessions) -> None:
    org_a, org_b = uuid.uuid4(), uuid.uuid4()
    async with sessions() as unbound:
        await _insert(unbound, org_a, "a")
        await _insert(unbound, org_b, "b")
        await _insert(unbound, None, "personal")
        await unbound.commit()

    async with sessions() as session:
        await bind_organization(session, org_a)
        assert bound_organization(session) == org_a
        assert await _bodies(session) == {"a", "personal"}

    async with sessions() as unbound:
        assert await _bodies(unbound) == {"a", "b", "personal"}


@pytest.mark.anyio
async def test_binding_survives_a_commit(sessions) -> None:
    """A new transaction of a bound session is restricted again (after_begin listener)."""
    org_a, org_b = uuid.uuid4(), uuid.uuid4()
    async with sessions() as unbound:
        await _insert(unbound, org_b, "b")
        await unbound.commit()

    async with sessions() as session:
        await bind_organization(session, org_a)
        await _insert(session, org_a, "a")
        await session.commit()
        assert await _bodies(session) == {"a"}


@pytest.mark.anyio
async def test_bound_session_cannot_write_for_another_organization(sessions) -> None:
    org_a, org_b = uuid.uuid4(), uuid.uuid4()
    async with sessions() as session:
        await bind_organization(session, org_a)
        with pytest.raises(DBAPIError, match="row-level security"):
            await _insert(session, org_b, "intruder")


@pytest.mark.anyio
async def test_a_session_is_bound_to_one_organization(sessions) -> None:
    async with sessions() as session:
        await bind_organization(session, uuid.uuid4())
        with pytest.raises(ValueError, match="another organization"):
            await bind_organization(session, uuid.uuid4())


@pytest.mark.anyio
async def test_binding_does_not_leak_to_the_next_user_of_a_connection(sessions) -> None:
    async with sessions() as session:
        await bind_organization(session, uuid.uuid4())
        await session.execute(text("SELECT 1"))
    async with sessions() as session:
        role = (await session.execute(text("SELECT current_user"))).scalar_one()
        setting = (
            await session.execute(text("SELECT current_setting(:name, true)"), {"name": TENANT_SETTING})
        ).scalar_one()
        assert role != TENANT_ROLE
        assert not setting
