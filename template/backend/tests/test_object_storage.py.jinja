    iter_bytes,
)

pytestmark = pytest.mark.anyio

BUCKET = "acme-objects"


async def _read(storage: file_storage.BaseFileStorage, key: str) -> bytes:
    return b"".join([chunk async for chunk in storage.read(key)])


@pytest.fixture
def s3_storage(monkeypatch: pytest.MonkeyPatch):
    for name in ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"):
        monkeypatch.setenv(name, "testing")
    with mock_aws():
        boto3.client("s3", region_name="us-east-1").create_bucket(Bucket=BUCKET)
        # The client the application builds (signature version 4), against moto.
        yield S3FileStorage(S3Config(bucket=BUCKET, region="us-east-1"))


@pytest.fixture(params=["local", "s3"])
def storage(request: pytest.FixtureRequest, tmp_path: Path, s3_storage: S3FileStorage):
    return LocalFileStorage(tmp_path) if request.param == "local" else s3_storage


async def test_content_is_hashed_while_it_is_written(storage) -> None:
    data = os.urandom(3 * 1024 * 1024 + 7)
    written = await storage.write("org/o/obj", iter_bytes(data, chunk_size=65536))
    assert written.size == len(data)
    assert written.sha256 == hashlib.sha256(data).hexdigest()
    assert await _read(storage, "org/o/obj") == data
    assert await storage.exists("org/o/obj")


async def test_content_over_the_limit_leaves_nothing(storage) -> None:
    with pytest.raises(ObjectTooLargeError):
        await storage.write("user/u/big", iter_bytes(b"x" * 2048, chunk_size=512), max_size=1024)
    assert not await storage.exists("user/u/big")
    assert [key async for key, _ in storage.list_keys("user/")] == []


async def test_missing_content_is_reported(storage) -> None:
    with pytest.raises(FileNotFoundError):
        await _read(storage, "org/o/absent")


async def test_an_owner_is_erased_by_prefix(storage) -> None:
    for key in ("user/a/1", "user/a/2", "user/b/1"):
        await storage.write(key, iter_bytes(b"data"))
    assert await storage.delete_prefix("user/a/") == 2
    assert sorted([key async for key, _ in storage.list_keys("user/")]) == ["user/b/1"]


async def test_large_objects_are_sent_in_parts_and_a_failure_aborts_the_upload(
    s3_storage: S3FileStorage,
) -> None:
    data = os.urandom(S3_PART_SIZE + 1024)
    written = await s3_storage.write("org/o/large", iter_bytes(data))
    assert written.sha256 == hashlib.sha256(data).hexdigest()
    head = s3_storage.client.head_object(Bucket=BUCKET, Key="org/o/large")
    assert head["ETag"].strip('"').endswith("-2"), "a multipart upload of two parts"

    with pytest.raises(ObjectTooLargeError):
        await s3_storage.write("org/o/too-large", iter_bytes(data), max_size=S3_PART_SIZE + 1)
    pending = s3_storage.client.list_multipart_uploads(Bucket=BUCKET).get("Uploads", [])
    assert pending == [], "the multipart upload is aborted"
    assert not await s3_storage.exists("org/o/too-large")


async def test_presigned_urls_are_short_lived(s3_storage: S3FileStorage) -> None:
    await s3_storage.write("org/o/doc", iter_bytes(b"pdf"))
    url = await s3_storage.presigned_url(
        "org/o/doc", content_type="application/pdf", content_disposition='inline; filename="a.pdf"', ttl=120
    )
    assert url and "X-Amz-Expires=120" in url and "X-Amz-Signature=" in url


def test_local_paths_cannot_escape_the_storage_root(tmp_path: Path) -> None:
    storage = LocalFileStorage(tmp_path / "media")
    with pytest.raises(ValueError):
        storage._resolve_safe_path("../outside")


def test_credentials_do_not_appear_in_the_representation() -> None:
    config = S3Config(bucket="b", region="r", access_key="AKIDEXAMPLE", secret_key="s3cr3t-value")
    assert "s3cr3t-value" not in repr(config) and "AKIDEXAMPLE" not in repr(config)


def test_the_backend_follows_the_settings(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    monkeypatch.setattr(settings, "MEDIA_DIR", tmp_path)
    monkeypatch.setattr(settings, "STORAGE_BACKEND", None)
    monkeypatch.setattr(settings, "S3_ENDPOINT", None)
    monkeypatch.setattr(settings, "S3_ACCESS_KEY", "")
    assert get_file_storage().name == "local", "local disk when S3 is not configured"
    monkeypatch.setattr(settings, "S3_ENDPOINT", "http://garage:3900")
    assert settings.storage_backend == "s3"
    assert get_file_storage().name == "s3"
    monkeypatch.setattr(settings, "STORAGE_BACKEND", "local")
    assert get_file_storage().name == "local", "an explicit choice wins"
    with pytest.raises(ValueError):
        get_file_storage("ftp")


async def test_partial_local_files_are_listed_for_the_cleanup(tmp_path: Path) -> None:
    storage = LocalFileStorage(tmp_path)
    leftover = tmp_path / "org" / "o" / ".obj.1234.part"
    leftover.parent.mkdir(parents=True)
    leftover.write_bytes(b"half")
    old = time.time() - 3600
    os.utime(leftover, (old, old))
    keys = [key async for key, _ in storage.list_keys("org/")]
    assert keys == ["org/o/.obj.1234.part"]


# --- Garage bootstrap ------------------------------------------------------------------------

ACCESS_KEY = "GK" + "a1" * 12
SECRET_KEY = "b2" * 32


class FakeGarage:
    """One Garage node behind the version 2 administration API."""

    def __init__(self) -> None:
        self.layout_version = 0
        self.roles: list[dict] = []
        self.keys: set[str] = set()
        self.buckets: dict[str, str] = {}
        self.grants: list[dict] = []
        self.calls: list[str] = []

    def handle(self, request: httpx.Request) -> httpx.Response:
        path = request.url.path.removeprefix("/v2/")
        self.calls.append(path)
        body = json.loads(request.content) if request.content else {}
        if path == "GetClusterStatus":
            return httpx.Response(200, json={"layoutVersion": self.layout_version, "nodes": [{"id": "node1"}]})
        if path == "GetClusterLayout":
            return httpx.Response(200, json={"version": self.layout_version, "roles": self.roles})
        if path == "UpdateClusterLayout":
            self.staged = body["roles"]
            return httpx.Response(200, json={})
        if path == "ApplyClusterLayout":
            assert body["version"] == self.layout_version + 1
            self.layout_version, self.roles = body["version"], self.staged
            return httpx.Response(200, json={})
        if path == "GetKeyInfo":
            found = request.url.params["id"] in self.keys
            return httpx.Response(200 if found else 404, json={})
        if path == "ImportKey":
            self.keys.add(body["accessKeyId"])
            return httpx.Response(200, json={})
        if path == "GetBucketInfo":
            alias = request.url.params["globalAlias"]
            if alias not in self.buckets:
                return httpx.Response(404, json={})
            return httpx.Response(200, json={"id": self.buckets[alias]})
        if path == "CreateBucket":
            self.buckets[body["globalAlias"]] = uuid.uuid4().hex
            return httpx.Response(200, json={"id": self.buckets[body["globalAlias"]]})
        if path == "AllowBucketKey":
            self.grants.append(body)
            return httpx.Response(200, json={})
        return httpx.Response(400, json={"code": "InvalidRequest"})


async def test_garage_bootstrap_prepares_a_node_once() -> None:
    garage = FakeGarage()
    async with httpx.AsyncClient(transport=httpx.MockTransport(garage.handle), base_url="http://garage:3903") as client:
        first = await bootstrap_garage(client, bucket="acme", access_key=ACCESS_KEY, secret_key=SECRET_KEY)
        second = await bootstrap_garage(client, bucket="acme", access_key=ACCESS_KEY, secret_key=SECRET_KEY)
    assert first == ["layout", "key", "bucket"]
    assert second == [], "idempotent: a second start changes nothing"
    assert garage.roles[0]["id"] == "node1"
    grant = garage.grants[-1]
    assert grant["accessKeyId"] == ACCESS_KEY and grant["bucketId"] == garage.buckets["acme"]
    assert grant["permissions"] == {"read": True, "write": True, "owner": False}


async def test_garage_bootstrap_refuses_keys_garage_cannot_import() -> None:
    async with httpx.AsyncClient(transport=httpx.MockTransport(FakeGarage().handle), base_url="http://g") as client:
        with pytest.raises(GarageError):
            await bootstrap_garage(client, bucket="acme", access_key="minioadmin", secret_key="x")


# The values of garage/development.env, published with the project.
DEVELOPMENT_GARAGE_ENV = Path(__file__).resolve().parents[2] / "garage" / "development.env"


def _published(name: str) -> str:
    lines = DEVELOPMENT_GARAGE_ENV.read_text(encoding="utf-8").splitlines()
    return next(line.partition("=")[2].strip() for line in lines if line.startswith(f"{name}="))


@pytest.fixture
def garage_reached(monkeypatch: pytest.MonkeyPatch) -> list[str]:
    """The administration API, replaced: records that the bootstrap got past its checks."""
    reached: list[str] = []

    async def wait(client: httpx.AsyncClient, timeout: float) -> None:
        reached.append("garage")

    async def bootstrap(client: httpx.AsyncClient, **kwargs: object) -> list[str]:
        return []

    monkeypatch.setattr(storage_commands, "_wait_for_garage", wait)
    monkeypatch.setattr(storage_commands, "bootstrap_garage", bootstrap)
    return reached


def _bootstrap(env: dict[str, str]) -> tuple[int, str]:
    result = CliRunner().invoke(garage_bootstrap, [], env=env)
    return result.exit_code, result.output


@pytest.mark.parametrize("environment", ["staging", "production"])
def test_deployed_garage_bootstrap_refuses_the_published_development_secrets(
    environment: str, monkeypatch: pytest.MonkeyPatch, garage_reached: list[str]
) -> None:
    """An operator who copies garage/development.env to production gets no stack."""
    monkeypatch.setattr(settings, "ENVIRONMENT", environment)
    code, output = _bootstrap(
        {"GARAGE_ADMIN_TOKEN": _published("GARAGE_ADMIN_TOKEN"), "GARAGE_RPC_SECRET": _published("GARAGE_RPC_SECRET")}
    )
    assert code == 1
    assert "GARAGE_ADMIN_TOKEN, GARAGE_RPC_SECRET must be set to real secrets" in output
    assert garage_reached == [], "refused before Garage is called"


@pytest.mark.parametrize("weak", ["GARAGE_ADMIN_TOKEN", "GARAGE_RPC_SECRET"])
def test_deployed_garage_bootstrap_refuses_each_weak_secret(
    weak: str, monkeypatch: pytest.MonkeyPatch, garage_reached: list[str]
) -> None:
    monkeypatch.setattr(settings, "ENVIRONMENT", "production")
    env = {"GARAGE_ADMIN_TOKEN": secrets.token_hex(32), "GARAGE_RPC_SECRET": secrets.token_hex(32), weak: "0" * 64}
    code, output = _bootstrap(env)
    assert code == 1
    assert f"{weak} must be set to real secrets" in output
    assert garage_reached == []


def test_deployed_garage_bootstrap_refuses_an_empty_admin_token(
    monkeypatch: pytest.MonkeyPatch, garage_reached: list[str]
) -> None:
    monkeypatch.setattr(settings, "ENVIRONMENT", "production")
    code, output = _bootstrap({"GARAGE_ADMIN_TOKEN": " ", "GARAGE_RPC_SECRET": secrets.token_hex(32)})
    assert code == 1
    assert "GARAGE_ADMIN_TOKEN must be set to real secrets" in output


def test_deployed_garage_bootstrap_runs_with_real_secrets(
    monkeypatch: pytest.MonkeyPatch, garage_reached: list[str]
) -> None:
    monkeypatch.setattr(settings, "ENVIRONMENT", "production")
    code, output = _bootstrap({"GARAGE_ADMIN_TOKEN": secrets.token_hex(32), "GARAGE_RPC_SECRET": secrets.token_hex(32)})
    assert code == 0, output
    assert garage_reached == ["garage"]


def test_development_garage_bootstrap_accepts_the_published_secrets(
    monkeypatch: pytest.MonkeyPatch, garage_reached: list[str]
) -> None:
    monkeypatch.setattr(settings, "ENVIRONMENT", "local")
    code, output = _bootstrap(
        {"GARAGE_ADMIN_TOKEN": _published("GARAGE_ADMIN_TOKEN"), "GARAGE_RPC_SECRET": _published("GARAGE_RPC_SECRET")}
    )
    assert code == 0, output
    assert garage_reached == ["garage"]
