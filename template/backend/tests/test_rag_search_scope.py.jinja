"""Knowledge bases of one organization stay out of reach of another (Keelson).

The vector store has no row level security: access to a collection is decided by the
knowledge bases the user can see in the active organization.
"""

from collections.abc import AsyncGenerator
from unittest.mock import AsyncMock, MagicMock
from uuid import uuid4

import pytest
from httpx import ASGITransport, AsyncClient

from app.api import deps
from app.core.config import settings
from app.main import app
from app.services.knowledge_base import KnowledgeBaseService

SEARCH = f"{settings.API_V1_STR}/rag/search"


@pytest.fixture
async def search_client() -> AsyncGenerator[tuple[AsyncClient, MagicMock], None]:
    """A member of an organization whose only visible knowledge base is ``ours``."""
    kb_service = MagicMock()
    kb_service.list_accessible_collection_names = AsyncMock(return_value=["ours"])
    retrieval = MagicMock()
    retrieval.retrieve = AsyncMock(return_value=[])
    retrieval.retrieve_multi = AsyncMock(return_value=[])
    app.dependency_overrides[deps.get_current_user] = lambda: MagicMock(id=uuid4())
    app.dependency_overrides[deps.get_active_organization] = lambda: MagicMock(id=uuid4())
    app.dependency_overrides[deps.get_knowledge_base_service] = lambda: kb_service
    app.dependency_overrides[deps.get_retrieval_service] = lambda: retrieval
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
        yield client, retrieval
    app.dependency_overrides.clear()


@pytest.mark.anyio
@pytest.mark.parametrize(
    "body",
    [
        {"query": "salaries", "collection_name": "theirs"},
        {"query": "salaries", "collection_names": ["ours", "theirs"]},
        {"query": "salaries"},  # the upstream default collection, shared by nobody here
    ],
)
async def test_search_refuses_collections_outside_the_organization(
    search_client: tuple[AsyncClient, MagicMock], body: dict
) -> None:
    client, retrieval = search_client
    response = await client.post(SEARCH, json=body)
    assert response.status_code == 404
    retrieval.retrieve.assert_not_called()
    retrieval.retrieve_multi.assert_not_called()


@pytest.mark.anyio
async def test_search_reaches_the_organization_collections(
    search_client: tuple[AsyncClient, MagicMock],
) -> None:
    client, retrieval = search_client
    response = await client.post(SEARCH, json={"query": "policy", "collection_name": "ours"})
    assert response.status_code == 200
    retrieval.retrieve.assert_awaited_once()


@pytest.mark.anyio
async def test_former_members_lose_the_organization_knowledge_bases(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """A conversation kept after leaving an organization no longer reaches its knowledge bases."""
    from app.services import knowledge_base as module

    organization_id, user_id, kb_id = uuid4(), uuid4(), uuid4()
    get_accessible = AsyncMock(return_value=[])
    monkeypatch.setattr(module.member_repo, "get", AsyncMock(return_value=None))
    monkeypatch.setattr(module.knowledge_base_repo, "get_accessible", get_accessible)
    service = KnowledgeBaseService(MagicMock())

    await service.resolve_collection_names_for_ids(
        kb_ids=[kb_id], user_id=user_id, organization_id=organization_id
    )
    assert get_accessible.await_args.kwargs["organization_id"] is None

    monkeypatch.setattr(module.member_repo, "get", AsyncMock(return_value=MagicMock()))
    await service.resolve_collection_names_for_ids(
        kb_ids=[kb_id], user_id=user_id, organization_id=organization_id
    )
    assert get_accessible.await_args.kwargs["organization_id"] == organization_id
