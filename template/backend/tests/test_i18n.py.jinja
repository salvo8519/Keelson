OTHER_LANGUAGES = [language for language in i18n.SUPPORTED_LANGUAGES if language != "en"]


@pytest.mark.parametrize(
    ("header", "expected"),
    [
        (None, None),
        ("", None),
        ("en-US,en;q=0.9", "en"),
        ("de-DE", None),
        ("de;q=1.0, en;q=0.5", "en"),
        ("fr", None),
    ],
)
def test_negotiate(header: str | None, expected: str | None) -> None:
    assert negotiate(header) == expected


@pytest.mark.skipif(not OTHER_LANGUAGES, reason="English only")
def test_negotiate_prefers_the_highest_quality() -> None:
    other = OTHER_LANGUAGES[0]
    assert negotiate(f"en;q=0.4, {other};q=0.8") == other
    assert negotiate(f"{other}-XX") == other


def test_a_stronger_source_wins() -> None:
    i18n.reset_language()
    for language, source, expected in [
        ("en", LanguageSource.HEADER, "en"),
        (*(OTHER_LANGUAGES[:1] or ["en"]), LanguageSource.USER, (OTHER_LANGUAGES[:1] or ["en"])[0]),
        ("en", LanguageSource.ORGANIZATION, (OTHER_LANGUAGES[:1] or ["en"])[0]),
        ("xx", LanguageSource.USER, (OTHER_LANGUAGES[:1] or ["en"])[0]),
    ]:
        set_language(language, source)
        assert i18n.current_language() == expected
    i18n.reset_language()


def test_every_message_is_translated() -> None:
    """A new error message needs its translations: run `make i18n-extract` and translate."""
    assert untranslated(extract()) == {}


@pytest.mark.anyio
@pytest.mark.parametrize("language", ["en", *OTHER_LANGUAGES])
async def test_errors_are_problem_details_in_the_requested_language(language: str) -> None:
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
        response = await client.get(
            f"{settings.API_V1_STR}/users/me", headers={"Accept-Language": language}
        )
    assert response.status_code == 401
    assert response.headers["content-type"].startswith("application/problem+json")
    assert response.headers["content-language"] == language
    body = response.json()
    assert body["status"] == 401
    assert body["detail"] == i18n.gettext("Not authenticated", language)
    assert body["title"] == i18n.gettext("Unauthorized", language)
    if language != "en":
        assert body["detail"] != "Not authenticated"
