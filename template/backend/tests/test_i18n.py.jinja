# Emails ------------------------------------------------------------------------------------

PLACEHOLDER = re.compile(r"\[\[\w+\]\]")
# Templates of features outside the Keelson profile (billing, credits) are not translated.
TRANSLATED_EMAILS = [
    EmailKey.WELCOME,
    EmailKey.EMAIL_VERIFICATION,
    EmailKey.MAGIC_LINK,
    EmailKey.PASSWORD_RESET,
    EmailKey.INVITATION,
    EmailKey.NEWSLETTER_WELCOME,
]


@pytest.mark.parametrize("language", OTHER_LANGUAGES)
@pytest.mark.parametrize("key", TRANSLATED_EMAILS)
@pytest.mark.parametrize("ext", ["html", "txt"])
def test_emails_are_translated_with_the_same_placeholders(language: str, key: EmailKey, ext: str) -> None:
    english = (_DIST_DIR / f"{key.value}.{ext}").read_text(encoding="utf-8")
    translated_path = _DIST_DIR / language / f"{key.value}.{ext}"
    assert translated_path.is_file(), f"missing translation {translated_path}"
    translated = translated_path.read_text(encoding="utf-8")
    assert set(PLACEHOLDER.findall(translated)) == set(PLACEHOLDER.findall(english))
    if ext == "txt":
        assert translated.startswith("Subject: ")


def test_untranslated_emails_fall_back_to_english() -> None:
    assert template_path("welcome", "txt", "xx") == _DIST_DIR / "welcome.txt"


@pytest.mark.parametrize("language", ["en", *OTHER_LANGUAGES])
def test_rendered_email_has_no_placeholder_left(language: str) -> None:
    subject, html, text = render_email(
        EmailKey.MAGIC_LINK.value,
        {"name": "Ada", "magic_url": "https://example.com/m", "expires_in": "15", "app_name": "App"},
        language,
    )
    for part in (subject, html, text):
        assert "[[" not in part


@pytest.mark.parametrize(
    ("duration", "expected"),
    [(timedelta(hours=1), "1 hour"), (timedelta(hours=2), "2 hours"), (timedelta(minutes=15), "15 minutes")],
)
def test_duration_text(duration: timedelta, expected: str) -> None:
    assert duration_text(duration, "en") == expected
    for language in OTHER_LANGUAGES:
        assert duration_text(duration, language) != expected


class _Recorder:
    def __init__(self) -> None:
        self.messages: list[EmailMessage] = []

    async def send(self, message: EmailMessage) -> SendResult:
        self.messages.append(message)
        return SendResult(provider_message_id="test", accepted=True)


@pytest.mark.anyio
@pytest.mark.parametrize("language", ["en", *OTHER_LANGUAGES])
async def test_magic_link_email_uses_its_template_and_the_recipient_language(language: str) -> None:
    provider = _Recorder()
    service = EmailService(provider=provider)
    await service.send_magic_link(to="ada@example.com", name="Ada", magic_url="https://example.com/m", language=language)
    (message,) = provider.messages
    assert "https://example.com/m" in message.html
    assert EmailKey.MAGIC_LINK.value in message.tags
    assert template_path(EmailKey.MAGIC_LINK.value, "html", language).read_text(encoding="utf-8").split("[[")[0] in message.html
