"""API keys against a real PostgreSQL (Keelstone): lifecycle, audit and isolation.

Runs in a throwaway schema with the full metadata; skipped when no database is reachable.
"""

import uuid
from datetime import UTC, datetime, timedelta

import pytest
from sqlalchemy import func, select, text
from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine

import app.db.models  # noqa: F401  (registers every table on the metadata)
from app.core import audit
from app.core.config import settings
from app.core.exceptions import AuthenticationError, AuthorizationError
from app.db.base import Base
from app.db.models.audit_log import AppAdminAuditLog
from app.db.models.organization import Organization
from app.db.models.user import User
from app.schemas.api_key import ApiKeyCreate
from app.services.api_key import ApiKeyService
from tests.postgres import require_postgres, segregated_database

pytestmark = pytest.mark.anyio


@pytest.fixture
async def sessions(monkeypatch):
    """System sessions on a segregated database: the service logic of API keys (creation,
    authentication by prefix, rotation) runs as the system does; the isolation of keys between
    organizations is attacked in tests/test_segregation_postgres.py."""
    await require_postgres("API key")
    async with segregated_database() as db:
        # Refusals are audited in a system session of their own: the segregated one here.
        monkeypatch.setattr(audit, "system_session", lambda reason: db.system())
        yield db.system


async def _org_and_user(session: AsyncSession) -> tuple[Organization, User]:
    user = User(email=f"{uuid.uuid4().hex}@example.com", hashed_password="x", full_name="Owner")
    session.add(user)
    await session.flush()
    org = Organization(name="Acme", slug=uuid.uuid4().hex[:20], created_by_user_id=user.id)
    session.add(org)
    await session.flush()
    return org, user


async def _create(session, org, user, **fields):
    data = ApiKeyCreate(name="ci", scopes=["agent:run"], **fields)
    return await ApiKeyService(session).create(organization_id=org.id, user_id=user.id, data=data)


async def test_create_authenticate_and_audit(sessions) -> None:
    async with sessions() as session:
        org, user = await _org_and_user(session)
        key, token = await _create(session, org, user)
        await session.commit()
        assert token not in key.secret_hash

    async with sessions() as session:
        found = await ApiKeyService(session).authenticate(token)
        assert found.id == key.id and found.last_used_at is not None
        actions = (await session.execute(select(AppAdminAuditLog.action))).scalars().all()
        assert "api_key.created" in actions


async def test_refusals_of_one_key_are_audited_once_a_minute(sessions) -> None:
    """Refused requests cannot flood the audit log or the system connections (second review)."""
    async with sessions() as session:
        org, user = await _org_and_user(session)
        key, token = await _create(session, org, user)
        await session.commit()
    wrong = token[:-1] + ("A" if token[-1] != "A" else "B")
    for _ in range(5):
        async with sessions() as session:
            with pytest.raises(AuthenticationError):
                await ApiKeyService(session).authenticate(wrong)
    async with sessions() as session:
        denied = await session.scalar(
            select(func.count()).where(
                AppAdminAuditLog.action == "api_key.denied", AppAdminAuditLog.target_id == str(key.id)
            )
        )
    assert denied == 1


