async def test_wrong_secret_is_refused_and_audited(sessions) -> None:
    """The refusal survives the rollback of the request that raised it."""
    async with sessions() as session:
        org, user = await _org_and_user(session)
        key, token = await _create(session, org, user)
        await session.commit()
    async with sessions() as session:
        with pytest.raises(AuthenticationError):
            await ApiKeyService(session).authenticate(token[:-1] + ("A" if token[-1] != "A" else "B"))
        await session.rollback()
    async with sessions() as session:
        denied = await session.scalar(
            select(func.count()).where(AppAdminAuditLog.action == "api_key.denied")
        )
    assert denied == 1


async def test_revoked_and_expired_keys_are_refused(sessions) -> None:
    async with sessions() as session:
        org, user = await _org_and_user(session)
        service = ApiKeyService(session)
        key, token = await _create(session, org, user)
        await service.revoke(organization_id=org.id, key_id=key.id, user_id=user.id)
        with pytest.raises(AuthenticationError):
            await service.authenticate(token)

        soon = datetime.now(UTC) + timedelta(seconds=1)
        _, short_lived = await _create(session, org, user, expires_at=soon)
        await service.authenticate(short_lived)
        key_row = await service.authenticate(short_lived)
        key_row.expires_at = datetime.now(UTC) - timedelta(seconds=1)
        await session.flush()
        with pytest.raises(AuthenticationError):
            await service.authenticate(short_lived)


async def test_rotation_keeps_the_old_key_for_the_grace_period(sessions) -> None:
    async with sessions() as session:
        org, user = await _org_and_user(session)
        service = ApiKeyService(session)
        old, old_token = await _create(session, org, user)
        new, new_token = await service.rotate(
            organization_id=org.id, key_id=old.id, user_id=user.id, grace=timedelta(hours=1)
        )
        assert new.scopes == old.scopes and new.id != old.id
        assert (await service.authenticate(old_token)).id == old.id
        assert (await service.authenticate(new_token)).id == new.id

        newer, _ = await service.rotate(
            organization_id=org.id, key_id=new.id, user_id=user.id, grace=timedelta(0)
        )
        with pytest.raises(AuthenticationError):
            await service.authenticate(new_token)


async def test_missing_scope_is_refused(sessions) -> None:
    from app.api.deps import ApiKeyPrincipal, require_api_scopes

    async with sessions() as session:
        org, user = await _org_and_user(session)
        key, _ = await _create(session, org, user)
        principal = ApiKeyPrincipal(
            key=key,
            label=f"api_key:{key.id}",
            organization_id=org.id,
            scopes=frozenset(key.scopes),
            expires_at=None,
        )
        check = require_api_scopes("knowledge:write")
        with pytest.raises(AuthorizationError):
            await check(principal, ApiKeyService(session))
        assert await require_api_scopes("agent:run")(principal, ApiKeyService(session)) is principal
