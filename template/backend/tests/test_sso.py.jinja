    assert (await client.get("/api/v1/oauth/other/login")).status_code == 404


@pytest.mark.anyio
async def test_the_callback_sends_a_one_time_code_never_the_tokens(
    client: AsyncClient, providers, users, mock_redis: MagicMock, monkeypatch: pytest.MonkeyPatch
) -> None:
    claims = {"sub": "oid-1", "email": "ada@example.com"}
    provider_client = MagicMock()
    provider_client.authorize_access_token = AsyncMock(return_value={"userinfo": claims})
    monkeypatch.setattr(routes, "client", lambda _name: provider_client)

    response = await client.get("/api/v1/oauth/entra/callback?code=x&state=y")

    assert response.status_code in (302, 307)
    target = urlparse(response.headers["location"])
    assert target.path == "/auth/callback"
    code = parse_qs(target.query)["code"][0]
    assert "token" not in target.query
    users.get_or_create_oauth_user.assert_awaited_once_with(
        provider="entra",
        provider_id="oid-1",
        email="ada@example.com",
        full_name=None,
        email_verified=False,
    )
    key, user_id = mock_redis.set.call_args.args[:2]
    assert key == "oauth:code:" + hashlib.sha256(code.encode()).hexdigest()
    assert mock_redis.set.call_args.kwargs["ttl"] == routes.CODE_TTL_SECONDS


@pytest.mark.anyio
async def test_a_refused_identity_returns_to_the_sign_in_page_with_a_reason(
    client: AsyncClient, providers, users, monkeypatch: pytest.MonkeyPatch
) -> None:
    provider_client = MagicMock()
    provider_client.authorize_access_token = AsyncMock(
        return_value={"userinfo": {"sub": "1", "email": "a@other.com"}}
    )
    monkeypatch.setattr(routes, "client", lambda _name: provider_client)

    response = await client.get("/api/v1/oauth/entra/callback")

    target = urlparse(response.headers["location"])
    assert (target.path, parse_qs(target.query)["error"]) == ("/login", ["domain_not_allowed"])
    users.get_or_create_oauth_user.assert_not_awaited()


@pytest.mark.anyio
async def test_the_code_is_exchanged_once_for_session_cookies(
    client: AsyncClient, users, mock_redis: MagicMock
) -> None:
    from app.core.config import settings

    user = SimpleNamespace(id=uuid4(), is_active=True, token_epoch=0)
    users.get_by_id = AsyncMock(return_value=user)
    mock_redis.raw = MagicMock()
    mock_redis.raw.getdel = AsyncMock(side_effect=[str(user.id), None])
    body, headers = {"code": "c" * 43}, {"Origin": settings.CORS_ORIGINS[0]}

    first = await client.post("/api/v1/oauth/exchange", json=body, headers=headers)
    second = await client.post("/api/v1/oauth/exchange", json=body, headers=headers)

    assert first.status_code == 204 and first.content == b"", "no token in the body"
    assert any("HttpOnly" in c for c in first.headers.get_list("set-cookie"))
    assert second.status_code == 401


def _account(**fields: object) -> SimpleNamespace:
    base = {
        "id": uuid4(),
        "hashed_password": None,
        "oauth_provider": None,
        "oauth_id": None,
        "is_app_admin": False,
    }
    return SimpleNamespace(**{**base, **fields})


@pytest.mark.anyio
@pytest.mark.parametrize(
    ("account", "email_verified"),
    [
        (_account(hashed_password="$argon2id$x"), True),
        (_account(oauth_provider="google", oauth_id="g-1"), True),
        (_account(is_app_admin=True), True),
        (_account(), False),
    ],
    ids=["has-a-password", "linked-elsewhere", "platform-admin", "address-not-verified-by-token"],
)
async def test_an_existing_account_is_not_taken_over_by_a_provider_identity(
    monkeypatch: pytest.MonkeyPatch, account: SimpleNamespace, email_verified: bool
) -> None:
    from app.services import user as user_module
    from app.services.user import UserService

    repo = MagicMock()
    repo.get_by_oauth = AsyncMock(return_value=None)
    repo.get_by_email = AsyncMock(return_value=account)
    repo.update = AsyncMock()
    monkeypatch.setattr(user_module, "user_repo", repo)

    with pytest.raises(SignInRefused) as refused:
        await UserService(MagicMock()).get_or_create_oauth_user(
            provider="entra",
            provider_id="oid-1",
            email="ada@example.com",
            email_verified=email_verified,
        )
    assert refused.value.code == "account_exists"
    repo.update.assert_not_awaited()


@pytest.mark.anyio
async def test_an_account_without_password_or_identity_is_linked_by_a_verified_address(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    from app.services import user as user_module
    from app.services.user import UserService

    account = _account()
    repo = MagicMock()
    repo.get_by_oauth = AsyncMock(return_value=None)
    repo.get_by_email = AsyncMock(return_value=account)
    repo.update = AsyncMock(return_value=account)
    monkeypatch.setattr(user_module, "user_repo", repo)

    await UserService(MagicMock()).get_or_create_oauth_user(
        provider="entra", provider_id="oid-1", email="ada@example.com", email_verified=True
    )

    assert repo.update.call_args.kwargs["update_data"] == {
        "oauth_provider": "entra",
        "oauth_id": "oid-1",
    }


