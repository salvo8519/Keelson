async def _kb_id(world: World, name: str) -> uuid.UUID:
    (kb,) = [row[0] for row in await _system(world, "SELECT id FROM knowledge_bases WHERE name = :n", n=name)]
    return kb


def _document(name: str, kb: uuid.UUID | None, org: uuid.UUID | None) -> dict:
    return {"collection_name": name, "filename": "x.txt", "filetype": "txt", "organization_id": org,
            "knowledge_base_id": kb}


async def _allowed_insert(world: World, principal: Principal, table: str, **values: object) -> uuid.UUID:
    """The legitimate counterpart of a refused insert."""
    with acting_as(principal):
        async with world.db.app() as session:
            created = await _insert(session, table, **values)
            await session.commit()
    return created


async def _seed(world: World, table: str, **values: object) -> uuid.UUID:
    async with world.db.system() as session:
        created = await _insert(session, table, **values)
        await session.commit()
    return created


async def test_a_document_cannot_be_planted_in_another_tenants_knowledge_base(world: World) -> None:
    """The own organization on the row does not open a knowledge base the user cannot write."""
    member = _user(world, world.a2, world.org_a)
    for target in ("kb_org_b", "kb_app", "kb_a1"):
        await _refused_insert(world, member, "rag_documents",
                              **_document(target, await _kb_id(world, target), world.org_a))
    # Nor does a writable knowledge base carry a document into another organization.
    await _refused_insert(world, member, "rag_documents",
                          **_document("kb_org_a", await _kb_id(world, "kb_org_a"), world.org_b))
    await _allowed_insert(world, member, "rag_documents",
                          **_document("kb_org_a", await _kb_id(world, "kb_org_a"), world.org_a))


async def test_a_viewer_reads_the_organization_content_and_does_not_change_it(world: World) -> None:
    await _system(world, "UPDATE organization_members SET role = 'viewer' WHERE user_id = :u", u=world.a2)
    viewer, owner = _user(world, world.a2, world.org_a), _user(world, world.a1, world.org_a)
    kb_org_a = await _kb_id(world, "kb_org_a")
    await _seed(world, "rag_documents", **_document("kb_org_a", kb_org_a, world.org_a))
    source = await _seed(world, "sync_sources", organization_id=world.org_a, name="drive",
                         connector_type="local", collection_name="kb_org_a", config={})
    assert await _ids(world, viewer, "knowledge_bases", "name") == {"kb_org_a", "kb_app"}
    assert len(await _ids(world, viewer, "rag_documents")) == 1
    assert await _ids(world, viewer, "sync_sources") == {source}

    await _refused_insert(world, viewer, "knowledge_bases", scope="org", organization_id=world.org_a,
                          name="v", collection_name="v")
    await _refused(world, viewer, "UPDATE knowledge_bases SET name = 'taken' WHERE id = :k", k=kb_org_a)
    await _refused_insert(world, viewer, "rag_documents", **_document("kb_org_a", kb_org_a, world.org_a))
    await _refused_insert(world, viewer, "rag_documents", **_document("kb_org_a", None, world.org_a))
    await _refused(world, viewer, "DELETE FROM rag_documents")
    await _refused_insert(world, viewer, "sync_sources", organization_id=world.org_a, name="x",
                          connector_type="local", config={})
    await _refused(world, viewer, "UPDATE sync_sources SET name = 'taken'")
    await _refused(world, viewer, "DELETE FROM sync_sources")
    await _refused_insert(world, viewer, "sync_logs", source="local", collection_name="kb_org_a",
                          sync_source_id=source)
    await _refused(world, viewer, "DELETE FROM knowledge_bases WHERE id = :k", k=kb_org_a)
    # The owner keeps every right the viewer lacks.
    await _allowed_insert(world, owner, "sync_logs", source="local", collection_name="kb_org_a",
                          sync_source_id=source)
    await _allowed(world, owner, "UPDATE sync_sources SET name = 'renamed'")
    await _allowed(world, owner, "DELETE FROM knowledge_bases WHERE id = :k", k=kb_org_a)


async def test_a_personal_knowledge_base_keeps_its_documents_and_sources_private(world: World) -> None:
    """An upload into a personal knowledge base carries the active organization; the other
    members of that organization still do not read its documents, sources or sync logs."""
    owner, member = _user(world, world.a1, world.org_a), _user(world, world.a2, world.org_a)
    kb_a1 = await _kb_id(world, "kb_a1")
    document = await _seed(world, "rag_documents", **_document("kb_a1", kb_a1, world.org_a))
    source = await _seed(world, "sync_sources", organization_id=world.org_a, name="drive",
                         connector_type="local", collection_name="kb_a1", config={})
    log = await _seed(world, "sync_logs", source="local", collection_name="kb_a1", sync_source_id=source)
    assert await _ids(world, member, "knowledge_bases", "name") == {"kb_org_a", "kb_app"}
    assert document not in await _ids(world, member, "rag_documents")
    assert source not in await _ids(world, member, "sync_sources")
    assert log not in await _ids(world, member, "sync_logs")
    await _refused(world, member, "UPDATE sync_sources SET name = 'taken' WHERE id = :s", s=source)
    await _refused(world, member, "DELETE FROM sync_sources WHERE id = :s", s=source)
    # The owner of the knowledge base keeps them.
    assert document in await _ids(world, owner, "rag_documents")
    assert source in await _ids(world, owner, "sync_sources")
    assert log in await _ids(world, owner, "sync_logs")
    # Documents and sources outside any knowledge base stay with the organization.
    loose = await _seed(world, "rag_documents", **_document("loose", None, world.org_a))
    shared = await _seed(world, "sync_sources", organization_id=world.org_a, name="shared",
                         connector_type="local", config={})
    assert loose in await _ids(world, member, "rag_documents")
    assert shared in await _ids(world, member, "sync_sources")


async def test_content_is_not_created_with_a_privileged_or_foreign_value(world: World) -> None:
    """Frozen columns stop UPDATE only; an INSERT must not set them to what the system grants."""
    member = _user(world, world.a2, world.org_a)
    await _refused_insert(world, member, "knowledge_bases", scope="org", organization_id=world.org_a,
                          name="d", collection_name="d", is_default=True)
    await _allowed_insert(world, member, "knowledge_bases", scope="org", organization_id=world.org_a,
                          name="n", collection_name="n")
    kb_org_a = await _kb_id(world, "kb_org_a")
    # A document of a writable knowledge base names that knowledge base's collection only.
    await _refused_insert(world, member, "rag_documents", **_document("kb_org_b", kb_org_a, world.org_a))
    # A sync source feeds a knowledge base its author may write, not another tenant's.
    for target in ("kb_org_b", "kb_a1", "kb_app"):
        await _refused_insert(world, member, "sync_sources", organization_id=world.org_a, name="x",
                              connector_type="local", collection_name=target, config={})
    own = await _allowed_insert(world, member, "sync_sources", organization_id=world.org_a, name="x",
                                connector_type="local", collection_name="kb_org_a", config={})
    await _refused(world, member, "UPDATE sync_sources SET collection_name = 'kb_org_b' WHERE id = :s", s=own)
