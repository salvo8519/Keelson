async def test_a_delete_refused_by_the_database_is_not_reported_as_done(world: World) -> None:
    """The application's documents are visible to a member, and not deletable by one."""
    from unittest.mock import AsyncMock, MagicMock

    from app.core.exceptions import NotFoundError
    from app.services.knowledge_base import KnowledgeBaseService
    from app.services.rag.ingestion import IngestionService
    from app.services.rag_document import RAGDocumentService

    kb_app = await _kb_id(world, "kb_app")
    document = await _seed(world, "rag_documents", **_document("kb_app", kb_app, None))
    store = MagicMock(delete_document=AsyncMock(), delete_collection=AsyncMock(),
                      list_collections=AsyncMock(return_value=["kb_app"]))
    with acting_as(_user(world, world.a2, world.org_a)):
        async with world.db.app() as session:
            with pytest.raises(NotFoundError):
                await RAGDocumentService(session).delete_document(
                    str(document), IngestionService(processor=MagicMock(), vector_store=store)
                )
        async with world.db.app() as session:
            with pytest.raises(NotFoundError):
                await KnowledgeBaseService(session).delete(
                    kb_app, user_id=world.a2, organization_id=world.org_a, is_app_admin=True, vector_store=store
                )
    store.delete_document.assert_not_awaited()
    store.delete_collection.assert_not_awaited()
    assert await _system(world, "SELECT count(*) FROM rag_documents WHERE id = :d", d=document) == [(1,)]
