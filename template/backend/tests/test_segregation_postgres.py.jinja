"""Segregation of users and organizations enforced by PostgreSQL (Keelstone).

The first tests need no database: every table of the project must have policies or be closed
with a stated reason, so a new table cannot be forgotten. The others attack every table
against a real PostgreSQL, through the role of the application login: two organizations,
their members, an outsider, an API key, and a request with no principal at all.
"""

import uuid
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta

import pytest
from sqlalchemy import text
from sqlalchemy.exc import DBAPIError
from sqlalchemy.ext.asyncio import AsyncSession

import app.db.models  # noqa: F401  (registers every table on the metadata)
from app.db.base import Base
from app.db.tenancy import CLOSED_TABLES, POLICIES, TENANT_ROLE, UNISOLATED_TABLES, Principal, login_statements
from tests.postgres import SegregatedDatabase, acting_as, require_postgres, segregated_database

pytestmark = pytest.mark.anyio


def test_the_application_login_name_cannot_carry_sql() -> None:
    for name in ('app"; DROP ROLE postgres; --', "App", "x" * 64, ""):
        with pytest.raises(ValueError, match="POSTGRES_APP_USER"):
            login_statements(name, "secret")


def test_every_table_has_policies_or_a_reason_to_be_closed() -> None:
    tables = set(Base.metadata.tables)
    unaccounted = tables - set(POLICIES) - set(UNISOLATED_TABLES) - set(CLOSED_TABLES)
    assert not unaccounted, f"tables without segregation rules: {sorted(unaccounted)}"


@dataclass
class World:
    """Organization A (owner a1, member a2), organization B (owner b1), outsider c."""

    db: SegregatedDatabase
    a1: uuid.UUID
    a2: uuid.UUID
    b1: uuid.UUID
    c: uuid.UUID
    org_a: uuid.UUID
    org_b: uuid.UUID
    conv_a1: uuid.UUID
    conv_a2: uuid.UUID
    conv_b1: uuid.UUID
    objects: dict[str, uuid.UUID]


async def _insert(session: AsyncSession, table: str, **values: object) -> uuid.UUID:
    """A row with the model's defaults (Core insert applies them, raw SQL would not)."""
    values.setdefault("id", uuid.uuid4())
    await session.execute(Base.metadata.tables[table].insert().values(**values))
    return values["id"]  # type: ignore[return-value]


