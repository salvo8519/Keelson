# --- Ownership and privileges cannot be rewritten ----------------------------------------


async def test_a_share_cannot_be_moved_to_a_conversation_its_author_does_not_own(world: World) -> None:
    owner = _user(world, world.a1, world.org_a)
    # a1 shared conv_a1 with c; moving the share would give c a2's conversation.
    await _refused(world, owner, "UPDATE conversation_shares SET conversation_id = :c", c=world.conv_a2)
    await _refused(world, owner, "UPDATE conversation_shares SET shared_by = :u", u=world.a2)
    assert await _ids(world, _user(world, world.c), "conversations") == {world.conv_a1}
    await _allowed(world, owner, "UPDATE conversation_shares SET permission = 'edit'")


async def test_a_conversation_keeps_its_owner_its_organization_and_its_visibility(world: World) -> None:
    owner = _user(world, world.a1, world.org_a)
    for change, params in (
        ("user_id = :v", {"v": world.a2}),
        ("organization_id = :v", {"v": world.org_b}),
        ("is_demo = true", {}),
    ):
        await _refused(world, owner, f"UPDATE conversations SET {change} WHERE id = :c", c=world.conv_a1, **params)
    await _allowed(world, owner, "UPDATE conversations SET title = 'renamed' WHERE id = :c", c=world.conv_a1)


async def test_password_hashes_are_hidden_from_the_application(world: World) -> None:
    """Co-members read each other's profile, never a password hash (column privileges)."""
    acting = _user(world, world.a1, world.org_a)
    for statement in ("SELECT hashed_password FROM users WHERE id = :u", "SELECT * FROM users WHERE id = :u"):
        with acting_as(acting):
            async with world.db.app() as session:
                with pytest.raises(DBAPIError, match="permission denied"):
                    await session.execute(text(statement), {"u": world.a2})
    with acting_as(acting):
        async with world.db.app() as session:
            email = await session.scalar(text("SELECT email FROM users WHERE id = :u"), {"u": world.a2})
    assert email is not None


async def test_a_user_cannot_grant_itself_privileges(world: World) -> None:
    acting = _user(world, world.a2, world.org_a)
    for change in ("is_app_admin = true", "role = 'admin'", "is_active = true", "oauth_id = 'x'"):
        await _refused(world, acting, f"UPDATE users SET {change} WHERE id = :u", u=world.a2)
    await _allowed(world, acting, "UPDATE users SET full_name = 'A two' WHERE id = :u", u=world.a2)


async def test_a_user_cannot_revive_ended_sessions_or_change_the_address(world: World) -> None:
    """The session version (and the magic-link epoch, which voids e-mail links) only grows, and
    the address changes only through its confirmation."""
    acting = _user(world, world.a2, world.org_a)
{%- if enable_email %}
    growing = ("token_epoch", "magic_link_epoch")
{%- else %}
    growing = ("token_epoch",)
{%- endif %}
    for column in growing:
        await _allowed(world, acting, f"UPDATE users SET {column} = {column} + 2 WHERE id = :u", u=world.a2)
        with acting_as(acting):
            async with world.db.app() as session:
                with pytest.raises(DBAPIError, match=column):
                    await session.execute(
                        text(f"UPDATE users SET {column} = {column} - 1 WHERE id = :u"), {"u": world.a2}
                    )
    for change in ("email = 'someone@example.com'", "email_verified = true"):
        await _refused(world, acting, f"UPDATE users SET {change} WHERE id = :u", u=world.a2)


async def test_an_admin_manages_members_and_viewers_only(world: World) -> None:
    await _system(world, "UPDATE organization_members SET role = 'admin' WHERE user_id = :u", u=world.a2)
    admin = _user(world, world.a2, world.org_a)
    await _refused(world, admin, "UPDATE organization_members SET role = 'owner' WHERE user_id = :u", u=world.a2)
    await _refused(world, admin, "UPDATE organization_members SET role = 'member' WHERE user_id = :u", u=world.a1)
    await _refused(world, admin, "DELETE FROM organization_members WHERE user_id = :u", u=world.a1)
    for role in ("owner", "admin"):
        await _refused_insert(world, admin, "organization_members", organization_id=world.org_a, user_id=world.c, role=role)
    with acting_as(admin):
        async with world.db.app() as session:
            await _insert(session, "organization_members", organization_id=world.org_a, user_id=world.c, role="member")
            await session.commit()
    # The owner may promote, and hand over ownership.
    owner = _user(world, world.a1, world.org_a)
    await _allowed(world, owner, "UPDATE organization_members SET role = 'admin' WHERE user_id = :u", u=world.c)


async def test_a_creator_becomes_owner_once_and_cannot_come_back(world: World) -> None:
    creator = _user(world, world.c)
    org = uuid.uuid4()
    with acting_as(creator):
        async with world.db.app() as session:
            await _insert(session, "organizations", id=org, name="C", slug="org-c", created_by_user_id=world.c)
            await _insert(session, "organization_members", organization_id=org, user_id=world.c, role="owner")
            await session.commit()
    # a1 created organization A; once removed, it cannot add itself back as owner.
    await _system(world, "DELETE FROM organization_members WHERE user_id = :u AND organization_id = :o",
                  u=world.a1, o=world.org_a)
    await _refused_insert(world, _user(world, world.a1), "organization_members",
                          organization_id=world.org_a, user_id=world.a1, role="owner")


