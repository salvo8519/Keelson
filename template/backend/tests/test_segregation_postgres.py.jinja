async def _ids(world: World, principal: Principal | None, table: str, column: str = "id") -> set:
    with acting_as(principal):
        async with world.db.app() as session:
            return set((await session.execute(text(f"SELECT {column} FROM {table}"))).scalars())


async def _refused(world: World, principal: Principal, statement: str, **params: object) -> None:
    """The statement is refused by a policy, or touches no row."""
    with acting_as(principal):
        async with world.db.app() as session:
            try:
                result = await session.execute(text(statement), params)
                await session.commit()
            except DBAPIError as error:
                assert "row-level security" in str(error) or "permission denied" in str(error)
                return
            assert result.rowcount == 0, f"{statement} changed {result.rowcount} row(s)"


async def _refused_insert(world: World, principal: Principal, table: str, **values: object) -> None:
    """A row the principal may not create (the model's defaults fill the other columns)."""
    with acting_as(principal):
        async with world.db.app() as session:
            with pytest.raises(DBAPIError, match=r"row-level security|permission denied"):
                await _insert(session, table, **values)
                await session.commit()


async def _allowed(world: World, principal: Principal, statement: str, **params: object) -> None:
    """The legitimate counterpart of an attack: the statement changes a row."""
    with acting_as(principal):
        async with world.db.app() as session:
            result = await session.execute(text(statement), params)
            await session.commit()
    assert result.rowcount == 1, f"{statement} changed {result.rowcount} row(s)"


async def _system(world: World, statement: str, **params: object) -> list:
    async with world.db.system() as session:
        result = await session.execute(text(statement), params)
        rows = list(result) if result.returns_rows else []
        await session.commit()
    return rows


def _user(world: World, user: uuid.UUID, org: uuid.UUID | None = None) -> Principal:
    return Principal(user_id=user, organization_id=org)


# --- No principal: nothing ---------------------------------------------------------------


async def test_a_request_without_principal_sees_nothing(world: World) -> None:
    for table in sorted(POLICIES):
        if table in Base.metadata.tables:
            assert await _ids(world, None, table, "1") == set(), table


# --- Personal data -----------------------------------------------------------------------


async def test_conversations_are_private_to_their_author_even_in_the_same_organization(world: World) -> None:
    assert await _ids(world, _user(world, world.a1, world.org_a), "conversations") == {world.conv_a1}
    owner_view = await _ids(world, _user(world, world.a1, world.org_a), "messages", "conversation_id")
    assert owner_view == {world.conv_a1}, "the organization's owner does not read a member's chats"


async def test_shared_conversations_are_readable_not_writable_with_view_permission(world: World) -> None:
    outsider = _user(world, world.c)
    assert await _ids(world, outsider, "conversations") == {world.conv_a1}
    await _refused(
        world, outsider,
        "INSERT INTO messages (id, conversation_id, role, content) VALUES (:id, :c, 'user', 'x')",
        id=uuid.uuid4(), c=world.conv_a1,
    )


async def test_nobody_writes_into_another_users_conversation(world: World) -> None:
    for target in (world.conv_a2, world.conv_b1):
        await _refused(
            world, _user(world, world.a1, world.org_a),
            "INSERT INTO messages (id, conversation_id, role, content) VALUES (:id, :c, 'user', 'x')",
            id=uuid.uuid4(), c=target,
        )
        await _refused(world, _user(world, world.a1, world.org_a),
                       "UPDATE conversations SET title = 'taken' WHERE id = :c", c=target)
        await _refused(world, _user(world, world.a1, world.org_a),
                       "DELETE FROM messages WHERE conversation_id = :c", c=target)


async def test_conversations_cannot_be_created_for_someone_else_or_another_organization(world: World) -> None:
    acting = _user(world, world.a1, world.org_a)
    await _refused(world, acting, "INSERT INTO conversations (id, user_id) VALUES (:id, :u)", id=uuid.uuid4(), u=world.b1)
    await _refused(
        world, acting,
        "INSERT INTO conversations (id, user_id, organization_id) VALUES (:id, :u, :o)",
        id=uuid.uuid4(), u=world.a1, o=world.org_b,
    )


async def test_slash_commands_belong_to_their_user(world: World) -> None:
    assert await _ids(world, _user(world, world.a1), "user_slash_commands", "user_id") == {world.a1}


# --- Organization data -------------------------------------------------------------------


async def test_organizations_and_members_are_visible_to_members_only(world: World) -> None:
    acting = _user(world, world.a1, world.org_a)
    assert await _ids(world, acting, "organizations") == {world.org_a}
    assert await _ids(world, acting, "organization_members", "user_id") == {world.a1, world.a2}
    assert await _ids(world, acting, "users") == {world.a1, world.a2}


async def test_nobody_joins_an_organization_by_writing_a_membership(world: World) -> None:
    await _refused(
        world, _user(world, world.c),
        "INSERT INTO organization_members (id, organization_id, user_id, role) VALUES (:id, :o, :u, 'owner')",
        id=uuid.uuid4(), o=world.org_a, u=world.c,
    )
    # A plain member cannot promote itself either.
    await _refused(
        world, _user(world, world.a2, world.org_a),
        "UPDATE organization_members SET role = 'owner' WHERE user_id = :u", u=world.a2,
    )


async def test_api_keys_and_invitations_need_owner_or_admin(world: World) -> None:
    owner, member = _user(world, world.a1, world.org_a), _user(world, world.a2, world.org_a)
    assert await _ids(world, owner, "api_keys", "organization_id") == {world.org_a}
    assert await _ids(world, member, "api_keys") == set()
    assert await _ids(world, owner, "invitations", "organization_id") == {world.org_a}
    assert await _ids(world, member, "invitations") == set()


