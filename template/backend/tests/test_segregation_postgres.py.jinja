async def test_any_password_creates_a_working_application_login(world: World) -> None:
    """Quotes and dollar quotes in the password stay data (they used to end the DO block)."""
    import asyncpg

    from app.core.config import settings

    user, password = f"keelstone_login_{uuid.uuid4().hex[:8]}", "p'w$$; DROP TABLE users; --$$x"
    async with world.db.system() as session:
        for statement in login_statements(user, password):
            await session.execute(text(statement))
        await session.commit()
    try:
        connection = await asyncpg.connect(
            host=settings.POSTGRES_HOST, port=settings.POSTGRES_PORT, user=user,
            password=password, database=settings.POSTGRES_DB,
        )
        assert await connection.fetchval("SELECT current_user") == user
        await connection.close()
    finally:
        async with world.db.system() as session:
            await session.execute(text(f'DROP ROLE "{user}"'))
            await session.commit()
