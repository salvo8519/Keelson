async def test_tables_created_later_stay_closed_to_the_application(world: World) -> None:
    """The pgvector store creates its tables at run time with the owner login."""
    await _system(world, "CREATE TABLE vectors_late (id int, payload text)")
    await _system(world, "INSERT INTO vectors_late VALUES (1, 'secret')")
    with acting_as(_user(world, world.a1, world.org_a)):
        async with world.db.app() as session:
            with pytest.raises(DBAPIError, match="permission denied"):
                await session.execute(text("SELECT * FROM vectors_late"))
    open_tables = await _system(
        world,
        "SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace"
        " WHERE c.relkind IN ('r', 'p') AND n.nspname = current_schema()"
        " AND NOT c.relrowsecurity AND has_table_privilege(:role, c.oid, 'SELECT')",
        role=TENANT_ROLE,
    )
    assert open_tables == [], f"tables open to the application without row level security: {open_tables}"


