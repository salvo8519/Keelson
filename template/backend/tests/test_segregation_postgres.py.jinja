async def test_the_audit_log_is_append_only_for_the_application(world: World) -> None:
    acting = _user(world, world.a1, world.org_a)
    assert await _ids(world, acting, "app_admin_audit_logs") == set()
    with acting_as(acting):
        async with world.db.app() as session:
            await session.execute(
                text("INSERT INTO app_admin_audit_logs (id, actor_user_id, action) VALUES (:id, :u, 'test')"),
                {"id": uuid.uuid4(), "u": world.a1},
            )
            await session.commit()
    await _refused(world, acting, "DELETE FROM app_admin_audit_logs")
    forged = "INSERT INTO app_admin_audit_logs (id, actor_user_id, action) VALUES (:id, :u, 'x')"
    await _refused(world, acting, forged, id=uuid.uuid4(), u=world.b1)
    service = Principal(organization_id=world.org_a, service=True)
    await _refused(
        world,
        service,
        "INSERT INTO app_admin_audit_logs (id, actor_user_id, organization_id, action)"
        " VALUES (:id, :u, :org, 'x')",
        id=uuid.uuid4(),
        u=world.a1,
        org=world.org_b,
    )


# --- Stored objects (contents of documents and chat files) -----------------------------


async def test_stored_objects_are_visible_to_their_owner_only(world: World) -> None:
    objects = world.objects
    assert await _ids(world, _user(world, world.a1, world.org_a), "stored_objects") == {
        objects["a1_personal"],
        objects["org_a"],
    }
    assert await _ids(world, _user(world, world.a2, world.org_a), "stored_objects") == {
        objects["org_a"]
    }, "a member does not see another member's personal objects"
    assert await _ids(world, _user(world, world.b1, world.org_b), "stored_objects") == {
        objects["org_b"]
    }
    assert await _ids(world, _user(world, world.c), "stored_objects") == set()
    service = Principal(organization_id=world.org_a, service=True)
    assert await _ids(world, service, "stored_objects") == {objects["org_a"]}


async def test_an_own_object_cannot_point_at_another_owners_bytes(world: World) -> None:
    """The key names the bytes a download streams: it is derived from the owner and frozen."""
    acting = _user(world, world.a2, world.org_a)
    foreign_key = f"org/{world.org_b}/{world.objects['org_b']}"
    await _refused_insert(
        world, acting, "stored_objects", organization_id=world.org_a, size=1,
        content_type="application/pdf", backend="local", storage_key=foreign_key, status="available",
    )
    for column, value in (("storage_key", foreign_key), ("previous_key", foreign_key), ("backend", "s3")):
        await _refused(world, acting, f"UPDATE stored_objects SET {column} = :v WHERE id = :id",
                       v=value, id=world.objects["org_a"])
    own = uuid.uuid4()
    with acting_as(acting):
        async with world.db.app() as session:
            await _insert(session, "stored_objects", id=own, organization_id=world.org_a, size=1,
                          content_type="application/pdf", backend="local",
                          storage_key=f"org/{world.org_a}/{own}", status="pending")
            await session.commit()
    await _allowed(world, acting, "UPDATE stored_objects SET status = 'available', size = 2 WHERE id = :id", id=own)


async def test_nobody_creates_changes_or_deletes_another_owners_object(world: World) -> None:
    acting = _user(world, world.a2, world.org_a)
    insert = (
        "INSERT INTO stored_objects (id, organization_id, user_id, size, content_type, backend,"
        " storage_key, status) VALUES (:id, :o, :u, 1, 'x', 'local', 'k', 'available')"
    )
    await _refused(world, acting, insert, id=uuid.uuid4(), o=world.org_b, u=None)
    await _refused(world, acting, insert, id=uuid.uuid4(), o=None, u=world.a1)
    for target in (world.objects["a1_personal"], world.objects["org_b"]):
        await _refused(
            world, acting, "UPDATE stored_objects SET storage_key = 'taken' WHERE id = :id", id=target
        )
        await _refused(world, acting, "DELETE FROM stored_objects WHERE id = :id", id=target)
    # Moving an own object to another organization is refused as well.
    await _refused(
        world,
        acting,
        "UPDATE stored_objects SET organization_id = :o WHERE id = :id",
        o=world.org_b,
        id=world.objects["org_a"],
    )


