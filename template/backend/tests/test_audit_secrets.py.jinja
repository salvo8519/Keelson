"""The audit log never keeps a secret from a request body (Keelstone).

The administrators' user update recorded its whole body, so a password set by an
administrator was stored in clear in the audit log.
"""

from unittest.mock import AsyncMock
from uuid import uuid4

import pytest

from app.core.audit import record_audit
from app.core.logging import without_secrets

pytestmark = pytest.mark.anyio


def test_secrets_are_dropped_and_the_rest_is_kept() -> None:
    details = {
        "password": "NewPlaintext123",
        "email": "ops@example.com",
        "nested": {"api_key": "key_abc.def", "role": "admin"},
        "items": [{"client_secret": "s"}],
    }
    assert without_secrets(details) == {
        "password": "[REDACTED]",
        "email": "ops@example.com",
        "nested": {"api_key": "[REDACTED]", "role": "admin"},
        "items": [{"client_secret": "[REDACTED]"}],
    }


async def test_record_audit_writes_details_without_secrets() -> None:
    db = AsyncMock()
    await record_audit(
        db,
        actor_user_id=uuid4(),
        action="admin.user.update",
        details={"password": "NewPlaintext123", "full_name": "Ops"},
    )
    statement = db.execute.await_args.args[0]
    written = statement.compile().params["details"]
    assert written == {"password": "[REDACTED]", "full_name": "Ops"}
    assert "NewPlaintext123" not in repr(statement.compile().params)
