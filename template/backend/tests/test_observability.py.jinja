# Tracing --------------------------------------------------------------------------------------


@pytest.mark.anyio
async def test_requests_produce_spans_and_logs_carry_the_trace(capsys: pytest.CaptureFixture[str]) -> None:
    exporter = InMemorySpanExporter()
    provider = build_provider(SimpleSpanProcessor(exporter))
    app = create_app()
    instrument_app(app, provider)
    try:
        async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
            await client.get(HEALTH)
            assert exporter.get_finished_spans() == (), "health checks are not traced"
            await client.get(f"{settings.API_V1_STR}/users/me")
        names = [span.name for span in exporter.get_finished_spans()]
        assert any(f"{settings.API_V1_STR}/users/me" in name for name in names), names

        tracer = provider.get_tracer("test")
        with tracer.start_as_current_span("work") as span:
            entry = _log_line(capsys, "inside a span")
        assert entry["trace_id"] == format(span.get_span_context().trace_id, "032x")
    finally:
        FastAPIInstrumentor.uninstrument_app(app)
        provider.shutdown()
