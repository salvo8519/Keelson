@pytest.mark.anyio
async def test_each_application_exposes_its_own_metrics(monkeypatch: pytest.MonkeyPatch) -> None:
    """Upstream registered metrics process-wide, so a second application failed to start."""
    monkeypatch.setattr(settings, "PROMETHEUS_AUTH_TOKEN", "")
    for _ in range(2):
        async with AsyncClient(transport=ASGITransport(app=create_app()), base_url="http://test") as client:
            await client.get(f"{settings.API_V1_STR}/users/me")
            body = (await client.get(settings.PROMETHEUS_METRICS_PATH)).text
        assert "http_requests_total" in body
        assert "process_cpu_seconds_total" in body


