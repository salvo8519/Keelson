# Structured logs ------------------------------------------------------------------------------


def _log_line(capsys: pytest.CaptureFixture[str], message: str, *args: object) -> dict:
    setup_logging("INFO", "json")
    logging.getLogger("app.example").warning(message, *args, extra={"order": 7})
    return json.loads(capsys.readouterr().out.strip().splitlines()[-1])


def test_logs_are_json_with_the_request_id(capsys: pytest.CaptureFixture[str]) -> None:
    token = request_id_var.set("req-1")
    try:
        entry = _log_line(capsys, "order %s shipped", "A1")
    finally:
        request_id_var.reset(token)
    assert entry["message"] == "order A1 shipped"
    assert entry["level"] == "WARNING"
    assert entry["logger"] == "app.example"
    assert entry["request_id"] == "req-1"
    assert entry["order"] == 7


def test_terminal_only_fields_stay_out_of_json(capsys: pytest.CaptureFixture[str]) -> None:
    setup_logging("INFO", "json")
    logging.getLogger("uvicorn.error").info("started", extra={"color_message": "\x1b[36mstarted"})
    entry = json.loads(capsys.readouterr().out.strip().splitlines()[-1])
    assert "color_message" not in entry


def test_personal_data_is_redacted_in_every_logger(capsys: pytest.CaptureFixture[str]) -> None:
    """Upstream filtered the root logger only, which records of named loggers never reach."""
    entry = _log_line(capsys, "invite sent to %s", "ada@example.com")
    assert "ada@example.com" not in entry["message"]
