HEALTH = f"{settings.API_V1_STR}/health"


@pytest.fixture
async def fresh_client() -> AsyncGenerator[AsyncClient, None]:
    """A client on a new application, for tests that change how it is built."""
    async with AsyncClient(transport=ASGITransport(app=create_app()), base_url="http://test") as client:
        yield client


# API reference -------------------------------------------------------------------------------


@pytest.mark.anyio
async def test_reference_is_branded_and_calls_no_third_party(fresh_client: AsyncClient) -> None:
    response = await fresh_client.get("/docs")
    assert response.status_code == 200
    html = response.text
    assert f"<title>{BRAND_NAME} API</title>" in html
    assert BRAND_PRIMARY_COLOR in html
    assert settings.API_DOCS_SCALAR_JS_URL in html
    assert '"telemetry": false' in html or '"telemetry":false' in html
    assert re.search(r'"agent":\s*\{\s*"disabled":\s*true', html)
    assert re.search(r'"withDefaultFonts":\s*false', html)
    for host in ("fonts.scalar.com", "proxy.scalar.com", "fastapi.tiangolo.com"):
        assert host not in html


@pytest.mark.anyio
async def test_reference_policy_allows_only_its_own_scripts(fresh_client: AsyncClient) -> None:
    response = await fresh_client.get("/docs")
    policy = dict(
        directive.strip().split(" ", 1) for directive in response.headers["Content-Security-Policy"].split(";")
    )
    assert policy["default-src"] == "'none'"
    assert response.headers["X-Content-Type-Options"] == "nosniff"
    assert policy["connect-src"] == "'self'"
    (inline,) = re.findall(r"<script>(.*?)</script>", response.text, re.DOTALL)
    digest = base64.b64encode(hashlib.sha256(inline.encode()).digest()).decode()
    assert policy["script-src"] == f"https://cdn.jsdelivr.net 'sha256-{digest}'"


@pytest.mark.anyio
async def test_reference_is_hidden_in_production(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(settings, "ENVIRONMENT", "production")
    async with AsyncClient(transport=ASGITransport(app=create_app()), base_url="http://test") as client:
        assert (await client.get("/docs")).status_code == 404
        assert (await client.get(f"{settings.API_V1_STR}/openapi.json")).status_code == 404


# Security headers and request id -------------------------------------------------------------


@pytest.mark.anyio
async def test_api_responses_carry_security_headers(fresh_client: AsyncClient) -> None:
    headers = (await fresh_client.get(HEALTH)).headers
    assert headers["X-Content-Type-Options"] == "nosniff"
    assert headers["X-Frame-Options"] == "DENY"
    assert "default-src 'self'" in headers["Content-Security-Policy"]


@pytest.mark.anyio
@pytest.mark.parametrize(
    ("supplied", "kept"),
    [("trace-42.a:b", True), ("bad id", False), ("x" * 129, False), ("a\\nb", False)],
)
async def test_request_id_is_kept_only_when_it_is_an_identifier(
    fresh_client: AsyncClient, supplied: str, kept: bool
) -> None:
    returned = (await fresh_client.get(HEALTH, headers={"X-Request-ID": supplied})).headers["X-Request-ID"]
    assert (returned == supplied) is kept
    assert returned


