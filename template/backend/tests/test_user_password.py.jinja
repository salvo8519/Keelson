{%- if use_jwt and use_database %}
"""Own password change (Keelson): the current password is checked, and must differ."""

from unittest.mock import AsyncMock, MagicMock, patch

import pytest

from app.core.exceptions import BadRequestError
from app.core.security import get_password_hash, verify_password
from app.services.user import UserService

pytestmark = pytest.mark.anyio


def _user(password: str) -> MagicMock:
    user = MagicMock()
    user.hashed_password = get_password_hash(password)
    return user


async def test_wrong_current_password_is_refused() -> None:
    with patch("app.services.user.user_repo.update", new=AsyncMock()) as update:
        with pytest.raises(BadRequestError):
            await UserService(MagicMock()).change_password(
                _user("right-password"), "wrong-password", "new-password-1"
            )
    update.assert_not_awaited()


async def test_new_password_must_differ() -> None:
    with patch("app.services.user.user_repo.update", new=AsyncMock()) as update:
        with pytest.raises(BadRequestError):
            await UserService(MagicMock()).change_password(
                _user("same-password"), "same-password", "same-password"
            )
    update.assert_not_awaited()


async def test_password_is_stored_hashed() -> None:
    user = _user("old-password-1")
    with patch("app.services.user.user_repo.update", new=AsyncMock()) as update:
        await UserService(MagicMock()).change_password(user, "old-password-1", "new-password-1")
    stored = update.await_args.kwargs["update_data"]["hashed_password"]
    assert stored != "new-password-1"
    assert verify_password("new-password-1", stored)
{%- endif %}
