"""Own password change (Keelstone): the current password is checked, and must differ."""

from contextlib import asynccontextmanager
from unittest.mock import AsyncMock, MagicMock, patch

import pytest

from app.core.exceptions import BadRequestError
from app.core.security import get_password_hash, verify_password
from app.services.user import UserService

pytestmark = pytest.mark.anyio


CURRENT: list[str] = [""]
READS: list[object] = []


def _user(password: str) -> MagicMock:
    """A user whose stored hash is ``password``'s (read by the service in a system session)."""
    user = MagicMock()
    user.hashed_password = CURRENT[0] = get_password_hash(password)
    return user


@pytest.fixture(autouse=True)
def stored_hash(monkeypatch: pytest.MonkeyPatch) -> None:
    @asynccontextmanager
    async def system(reason: str):
        yield MagicMock()

    async def password_hash_of(db: object, user_id: object) -> str:
        READS.append(user_id)
        return CURRENT[0]

    READS.clear()
    monkeypatch.setattr("app.services.user.system_session", system)
    monkeypatch.setattr("app.services.user.user_repo.get_password_hash", password_hash_of)


async def test_wrong_current_password_is_refused() -> None:
    with (
        patch("app.services.user.user_repo.update", new=AsyncMock()) as update,
        pytest.raises(BadRequestError),
    ):
        await UserService(MagicMock()).change_password(
            _user("right-password"), "wrong-password", "new-password-1"
        )
    update.assert_not_awaited()


async def test_new_password_must_differ() -> None:
    with (
        patch("app.services.user.user_repo.update", new=AsyncMock()) as update,
        pytest.raises(BadRequestError),
    ):
        await UserService(MagicMock()).change_password(
            _user("same-password"), "same-password", "same-password"
        )
    update.assert_not_awaited()


async def test_password_is_stored_hashed() -> None:
    user = _user("old-password-1")
    with patch("app.services.user.user_repo.update", new=AsyncMock()) as update:
        await UserService(MagicMock()).change_password(user, "old-password-1", "new-password-1")
    stored = update.await_args.kwargs["update_data"]["hashed_password"]
    assert stored != "new-password-1"
    assert verify_password("new-password-1", stored)


async def test_a_re_authentication_reads_the_password_hash_once() -> None:
    """Keelstone: one system read of the caller's row, whatever the outcome."""
    user = _user("old-password-1")
    await UserService(MagicMock()).confirm_identity(user, "old-password-1", signed_in_at=None)
    assert len(READS) == 1

    READS.clear()
    with pytest.raises(BadRequestError):
        await UserService(MagicMock()).confirm_identity(user, "wrong-password", signed_in_at=None)
    assert len(READS) == 1
{%- endif %}
