@pytest.mark.anyio
async def test_read_current_user(auth_client: AsyncClient, mock_user: MockUser):
    """Test getting current user."""
    response = await auth_client.get(f"{settings.API_V1_STR}/users/me")
    assert response.status_code == 200
    data = response.json()
    assert data["email"] == mock_user.email


@pytest.mark.anyio
async def test_update_current_user(auth_client: AsyncClient, mock_user_service: MagicMock):
    """Test updating current user."""
    response = await auth_client.patch(
        f"{settings.API_V1_STR}/users/me",
        json={"full_name": "Updated Name"},
    )
    assert response.status_code == 200
    mock_user_service.update_me.assert_called_once()


@pytest.mark.anyio
@pytest.mark.parametrize(
    "field",
    [{"password": "new-password-123"}, {"is_active": False}, {"role": "admin"}],
)
async def test_update_current_user_ignores_protected_fields(
    auth_client: AsyncClient, mock_user_service: MagicMock, field: dict
):
    """Keelstone: password, status and role cannot change through PATCH /users/me."""
    response = await auth_client.patch(f"{settings.API_V1_STR}/users/me", json=field)
    assert response.status_code == 200
    mock_user_service.update.assert_not_called()
    (_, sent), _ = mock_user_service.update_me.call_args
    assert sent.model_dump(exclude_unset=True) == {}


@pytest.mark.anyio
async def test_change_password_requires_the_current_one(
    auth_client: AsyncClient, mock_user_service: MagicMock, mock_user: MockUser
):
    response = await auth_client.patch(
        f"{settings.API_V1_STR}/users/me/password",
        json={"current_password": "old-password-1", "new_password": "new-password-1"},
    )
    assert response.status_code == 204
    mock_user_service.change_password.assert_awaited_once_with(
        mock_user, "old-password-1", "new-password-1"
    )
    missing = await auth_client.patch(
        f"{settings.API_V1_STR}/users/me/password", json={"new_password": "new-password-1"}
    )
    assert missing.status_code == 422


