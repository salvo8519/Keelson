{%- if use_pgvector %}


@pytest.fixture
async def pg_store():
    await require_postgres("vector segregation")
    store = PgVectorStore(_settings(), _embedder())
    collection = f"t{uuid.uuid4().hex[:12]}"
    try:
        yield store, collection
    finally:
        await store.delete_collection(collection)
        await store.aclose()


@pytest.mark.anyio
async def test_pgvector_returns_only_the_reader_vectors(pg_store) -> None:
    store, collection = pg_store
    await store.insert_document(collection, _document("a_secret"), tenant=organization_tenant(ORG_A))
    await store.insert_document(collection, _document("b_secret"), tenant=organization_tenant(ORG_B))
    await store.insert_document(collection, _document("mine"), tenant=user_tenant(USER_B))

    as_a = await store.search(collection, "q", tenants=TenantFilter.for_reader(USER_A, ORG_A), limit=10)
    assert {r.content for r in as_a} == {"a_secret"}
    as_b = await store.search(collection, "q", tenants=TenantFilter.for_reader(USER_B, ORG_B), limit=10)
    assert {r.content for r in as_b} == {"b_secret", "mine"}
    assert await store.search(collection, "q", tenants=TenantFilter.nobody(), limit=10) == []
    everything = await store.search(collection, "q", tenants=TenantFilter.everything(), limit=10)
    assert len(everything) == 3


@pytest.mark.anyio
async def test_pgvector_collections_never_collide_with_application_tables(pg_store) -> None:
    """Upstream mapped the collection "documents" onto the application's rag_documents table."""
    store, _ = pg_store
    assert store._table("documents") == "vectors_documents"
    for name in await store.list_collections():
        assert await store._collection_exists(name), f"{name} is not a vector collection"
