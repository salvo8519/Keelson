{%- if enable_teams and use_postgresql %}
"""cmd rotate-database-passwords against a live PostgreSQL (Keelstone).

Two throwaway roles stand for the owner and the application logins: the owner may change the
application role's password (CREATEROLE with ADMIN OPTION on it, as PostgreSQL 16 requires),
as the superuser of a deployment can. The roles are dropped afterwards.
"""

import asyncio
import base64
import random
import secrets
import uuid
from collections.abc import Iterator

import asyncpg
import psycopg2
import pytest
from click.testing import CliRunner

from app.commands.database import rotate_database_passwords
from app.core.config import settings
from app.db.tenancy import login_statements, password_statement, scram_sha256_verifier
from tests.postgres import dsn, require_postgres


def _password() -> str:
    return secrets.token_hex(32)


# The test database as its superuser, read before a test points the settings at the roles.
ADMIN_DSN = dsn()


def _role_dsn(role: str, password: str) -> str:
    from sqlalchemy.engine import make_url

    return (
        make_url(ADMIN_DSN)
        .set(username=role, password=password)
        .render_as_string(hide_password=False)
    )


def _can_connect(role: str, password: str) -> bool:
    async def attempt() -> bool:
        try:
            connection = await asyncpg.connect(_role_dsn(role, password), timeout=5)
        except asyncpg.InvalidPasswordError:
            return False
        await connection.close()
        return True

    return asyncio.run(attempt())


def _as_superuser(*statements: str) -> None:
    async def run() -> None:
        admin = await asyncpg.connect(ADMIN_DSN)
        try:
            for statement in statements:
                await admin.execute(statement)
        finally:
            await admin.close()

    asyncio.run(run())


@pytest.fixture
def logins() -> Iterator[dict[str, str]]:
    asyncio.run(require_postgres("password rotation"))
    suffix = uuid.uuid4().hex[:10]
    roles = {"owner": f"rotation_owner_{suffix}", "app": f"rotation_app_{suffix}"}
    passwords = {"owner": _password(), "app": _password()}
    try:
        _as_superuser(
            f"CREATE ROLE \"{roles['app']}\" LOGIN PASSWORD '{passwords['app']}'",
            f"CREATE ROLE \"{roles['owner']}\" LOGIN CREATEROLE PASSWORD '{passwords['owner']}'",
            f'GRANT "{roles["app"]}" TO "{roles["owner"]}" WITH ADMIN OPTION',
        )
        yield {**{f"{key}_role": value for key, value in roles.items()}, **passwords}
    finally:
        _as_superuser(*(f'DROP ROLE IF EXISTS "{role}"' for role in (roles["owner"], roles["app"])))


def _point_settings_at(monkeypatch: pytest.MonkeyPatch, logins: dict[str, str]) -> None:
    monkeypatch.setattr(settings, "POSTGRES_USER", logins["owner_role"])
    monkeypatch.setattr(settings, "POSTGRES_PASSWORD", logins["owner"])
    monkeypatch.setattr(settings, "POSTGRES_APP_USER", logins["app_role"])


def test_both_passwords_are_changed_in_the_database(
    logins: dict[str, str], monkeypatch: pytest.MonkeyPatch
) -> None:
    _point_settings_at(monkeypatch, logins)
    new_owner, new_app = _password(), _password()
    result = CliRunner().invoke(
        rotate_database_passwords,
        [],
        env={"NEW_POSTGRES_PASSWORD": new_owner, "NEW_POSTGRES_APP_PASSWORD": new_app},
    )
    assert result.exit_code == 0, result.output
    assert new_owner not in result.output and new_app not in result.output
    assert _can_connect(logins["owner_role"], new_owner)
    assert _can_connect(logins["app_role"], new_app)
    assert not _can_connect(logins["app_role"], logins["app"])


def test_weak_new_passwords_change_nothing(
    logins: dict[str, str], monkeypatch: pytest.MonkeyPatch
) -> None:
    _point_settings_at(monkeypatch, logins)
    result = CliRunner().invoke(
        rotate_database_passwords,
        [],
        env={"NEW_POSTGRES_PASSWORD": _password(), "NEW_POSTGRES_APP_PASSWORD": "postgres"},
    )
    assert result.exit_code == 1
    assert "POSTGRES_APP_PASSWORD must be set to real secrets" in result.output
    assert _can_connect(logins["owner_role"], logins["owner"])
    assert _can_connect(logins["app_role"], logins["app"])


def test_a_refused_change_leaves_both_passwords(
    logins: dict[str, str], monkeypatch: pytest.MonkeyPatch
) -> None:
    """All or nothing: the owner may not change a role it has no ADMIN OPTION on."""
    _point_settings_at(monkeypatch, logins)
    _as_superuser(f'REVOKE "{logins["app_role"]}" FROM "{logins["owner_role"]}"')
    result = CliRunner().invoke(
        rotate_database_passwords,
        [],
        env={"NEW_POSTGRES_PASSWORD": _password(), "NEW_POSTGRES_APP_PASSWORD": _password()},
    )
    assert result.exit_code == 1, result.output
    assert _can_connect(logins["owner_role"], logins["owner"])
    assert _can_connect(logins["app_role"], logins["app"])


def _psycopg_can_connect(role: str, password: str) -> bool:
    try:
        psycopg2.connect(_role_dsn(role, password).replace("postgresql+asyncpg", "postgresql")).close()
    except psycopg2.OperationalError:
        return False
    return True


def _stored_verifier(role: str) -> str:
    async def read() -> str:
        admin = await asyncpg.connect(ADMIN_DSN)
        try:
            return await admin.fetchval("SELECT rolpassword FROM pg_authid WHERE rolname = $1", role)
        finally:
            await admin.close()

    return asyncio.run(read())


def test_the_statements_carry_a_verifier_not_the_password() -> None:
    password = _password()
    for statement in (password_statement("someone", password), *login_statements("someone_app", password)):
        assert password not in statement
    assert "PASSWORD 'SCRAM-SHA-256$4096:" in password_statement("someone", password)


def test_the_verifier_has_postgresql_s_format_and_a_fresh_salt() -> None:
    first, second = scram_sha256_verifier("same"), scram_sha256_verifier("same")
    assert first != second, "a random salt for every verifier"
    method, rest = first.split("$", 1)
    iterations_salt, keys = rest.split("$")
    assert method == "SCRAM-SHA-256" and iterations_salt.startswith("4096:")
    assert all(len(base64.b64decode(part)) == 32 for part in keys.split(":"))
    assert len(base64.b64decode(iterations_salt.split(":")[1])) == 16


def test_the_server_receives_only_verifiers_and_both_drivers_sign_in(
    logins: dict[str, str], monkeypatch: pytest.MonkeyPatch
) -> None:
    _point_settings_at(monkeypatch, logins)
    executed: list[str] = []
    original = asyncpg.connection.Connection.execute

    async def spy(self: asyncpg.connection.Connection, query: str, *args: object, **kwargs: object) -> str:
        executed.append(query)
        return await original(self, query, *args, **kwargs)

    monkeypatch.setattr(asyncpg.connection.Connection, "execute", spy)
    new_owner, new_app = _password(), _password()
    result = CliRunner().invoke(
        rotate_database_passwords,
        [],
        env={"NEW_POSTGRES_PASSWORD": new_owner, "NEW_POSTGRES_APP_PASSWORD": new_app},
    )
    monkeypatch.undo()
    assert result.exit_code == 0, result.output
    assert executed, "the statements were captured"
    assert not any(new_owner in query or new_app in query for query in executed)
    for role, password in ((logins["owner_role"], new_owner), (logins["app_role"], new_app)):
        assert _stored_verifier(role).startswith("SCRAM-SHA-256$4096:")
        assert _can_connect(role, password)
        assert _psycopg_can_connect(role, password)


@pytest.mark.parametrize("password", ["p\u00e4ssw\u00f6rd-", "\uff50\uff41\uff53\uff53-", "caf\u00e9\u00a0"])
def test_non_ascii_passwords_sign_in_as_postgresql_prepares_them(logins: dict[str, str], password: str) -> None:
    """SASLprep (RFC 4013) as PostgreSQL applies it: normalised, mapped, or raw when prohibited."""
    password += _password()
    _as_superuser(password_statement(logins["app_role"], password))
    assert _can_connect(logins["app_role"], password)
    assert _psycopg_can_connect(logins["app_role"], password)


def _rotate(env: dict[str, str], args: list[str] | None = None) -> tuple[int, str]:
    result = CliRunner().invoke(rotate_database_passwords, args or [], env=env)
    return result.exit_code, result.output


def test_the_passwords_cannot_be_given_as_options(logins: dict[str, str], monkeypatch: pytest.MonkeyPatch) -> None:
    """A command line shows in the shell history and the process list."""
    _point_settings_at(monkeypatch, logins)
    code, output = _rotate({}, ["--owner-password", _password(), "--app-password", _password()])
    assert code == 2 and "No such option" in output
    assert _can_connect(logins["owner_role"], logins["owner"])


def test_the_prompt_reads_the_passwords_without_options(logins: dict[str, str], monkeypatch: pytest.MonkeyPatch) -> None:
    _point_settings_at(monkeypatch, logins)
    new_owner, new_app = _password(), _password()
    unset = dict.fromkeys(("NEW_POSTGRES_PASSWORD", "NEW_POSTGRES_APP_PASSWORD"))
    answers = f"{new_owner}\n{new_owner}\n{new_app}\n{new_app}\n"
    result = CliRunner().invoke(rotate_database_passwords, [], input=answers, env=unset)
    assert result.exit_code == 0, result.output
    assert new_owner not in result.output and new_app not in result.output
    assert _can_connect(logins["owner_role"], new_owner) and _can_connect(logins["app_role"], new_app)


@pytest.mark.parametrize(
    ("owner", "app", "message"),
    [
        ("same", "same", "the two logins need different passwords"),
        ("x\u0300", None, "POSTGRES_PASSWORD must be printable ASCII"),
        (None, "\u2011\u2097\u2117", "POSTGRES_APP_PASSWORD must be printable ASCII"),
        (" lead", None, "POSTGRES_PASSWORD must not begin or end with a space"),
        (None, "trail ", "POSTGRES_APP_PASSWORD must not begin or end with a space"),
    ],
)
def test_unusable_new_passwords_change_nothing(
    logins: dict[str, str], monkeypatch: pytest.MonkeyPatch, owner: str | None, app: str | None, message: str
) -> None:
    _point_settings_at(monkeypatch, logins)
    shared = _password()
    values = {}
    for name, value in (("NEW_POSTGRES_PASSWORD", owner), ("NEW_POSTGRES_APP_PASSWORD", app)):
        if value == "same":
            values[name] = shared
        elif value is None:
            values[name] = _password()
        elif value.endswith(" "):
            values[name] = _password() + value
        else:
            values[name] = value + _password()
    code, output = _rotate(values)
    assert code == 1 and message in output
    assert _can_connect(logins["owner_role"], logins["owner"])
    assert _can_connect(logins["app_role"], logins["app"])


def test_one_login_for_both_roles_is_refused(logins: dict[str, str], monkeypatch: pytest.MonkeyPatch) -> None:
    """The roles would collapse and the owner would get the application password."""
    _point_settings_at(monkeypatch, logins)
    monkeypatch.setattr(settings, "POSTGRES_APP_USER", logins["owner_role"])
    code, output = _rotate({"NEW_POSTGRES_PASSWORD": _password(), "NEW_POSTGRES_APP_PASSWORD": _password()})
    assert code == 1 and "name the same login" in output
    assert _can_connect(logins["owner_role"], logins["owner"])


# Non-ASCII passwords the settings refuse, but the migration path computes verifiers for any
# value: they must equal the server's. The first three differ when the SASLprep checks run on
# the normalised string instead of the mapped one.
SASLPREP_SAMPLES = ["x\u0300", "\u1d5b", "\u2011\u2097\u2117", "caf\u00e9", "\uff50\uff41\uff53\uff53", "a\u00a0b", "\u05d0\u05d1"]


def _random_non_ascii(rng: random.Random) -> str:
    """Characters from the blocks where SASLprep maps, normalises or prohibits."""
    blocks = [(0x00A0, 0x024F), (0x0300, 0x036F), (0x0590, 0x06FF), (0x1D00, 0x1DBF), (0x2000, 0x218F), (0xFF00, 0xFFEF)]
    chars = []
    for _ in range(rng.randint(1, 6)):
        low, high = rng.choice(blocks)
        chars.append(chr(rng.randint(low, high)))
    if rng.random() < 0.5:
        chars.insert(rng.randint(0, len(chars)), rng.choice("abcxyz019"))
    return "".join(chars)


def _server_verifier(role: str, password: str) -> str:
    """The verifier PostgreSQL computes itself from the clear text (only in this test)."""
    secret = password.replace("'", "''")
    _as_superuser("SET password_encryption = 'scram-sha-256'", f"ALTER ROLE \"{role}\" PASSWORD '{secret}'")
    return _stored_verifier(role)


def test_our_verifiers_equal_the_server_s(logins: dict[str, str]) -> None:
    rng = random.Random(7677)
    passwords = [*SASLPREP_SAMPLES, *(_random_non_ascii(rng) for _ in range(300))]
    different = []
    for password in passwords:
        server = _server_verifier(logins["app_role"], password)
        salt = base64.b64decode(server.split("$")[1].split(":")[1])
        if scram_sha256_verifier(password, salt=salt) != server:
            different.append(ascii(password))
    assert different == []


def test_a_server_set_to_md5_stores_the_verifier_as_scram(logins: dict[str, str]) -> None:
    password = _password()
    _as_superuser("SET password_encryption = 'md5'", password_statement(logins["app_role"], password))
    assert _stored_verifier(logins["app_role"]).startswith("SCRAM-SHA-256$4096:")
    assert _can_connect(logins["app_role"], password)
