# --- The limiter's storage is down (L3) ----------------------------------------------------


class _StorageDown:
    """A rate limit storage whose backend does not answer."""

    async def increment_and_check(self, key: str, limit: int, period_seconds: int) -> Any:
        from app.services.rate_limit.storage import RateLimitStorageUnavailable

        raise RateLimitStorageUnavailable("connection refused")


@pytest.fixture
def limiter_down(monkeypatch: pytest.MonkeyPatch) -> MagicMock:
    """The limiter cannot count; the returned mock records every password check."""
    from app.services import user as user_service
    from app.services.rate_limit import service as rate_limit_service

    monkeypatch.setattr(rate_limit_service, "_storage", _StorageDown())
    checks = MagicMock()
    monkeypatch.setattr(user_service, "verify_password", checks.verify_password)
    monkeypatch.setattr(user_service, "verify_and_update_password", checks.verify_and_update_password)
    return checks


async def test_password_routes_fail_closed_while_the_limiter_is_down(
    client, database, mailbox, limiter_down, deletions
) -> None:
    """Without a limit, a password could be guessed at full speed: the routes that check one
    answer 503 and check nothing until the limiter counts again."""
    ada = await _user(database, "ada@example.com")
    proof = {"current_password": PASSWORD}

    answers = {
        "login": await client.post(f"{API}/auth/login", data={"username": "ada@example.com", "password": PASSWORD}),
        "password": await client.patch(
            f"{API}/users/me/password", json={**proof, "new_password": "new-password-9"}, headers=_bearer(ada)
        ),
        "email": await client.post(f"{API}/users/me/email", json={**proof, "email": "ada@new.example"}, headers=_bearer(ada)),
        "delete": await _delete_me(client, {**_bearer(ada), "Accept-Language": "it"}, **proof),
    }

    for route, answer in answers.items():
        assert answer.status_code == 503, (route, answer.text)
        assert answer.headers["content-type"].startswith("application/problem+json")
        assert answer.json()["code"] == "RATE_LIMIT_UNAVAILABLE"
        assert int(answer.headers["Retry-After"]) > 0
    english = "Signing in and account changes are temporarily unavailable. Try again in a few minutes."
    assert answers["login"].json()["detail"] == english
    assert answers["delete"].json()["detail"] not in ("", english)
    assert limiter_down.mock_calls == [], "no password was checked"
    assert mailbox.mock_calls == []
    deletions.assert_not_awaited()


async def test_during_a_redis_outage_sessions_neither_renew_nor_end(client, database, limiter_down) -> None:
    """The whole Redis is down: the limiter and the records of refresh tokens. A refresh passes
    the limiter (category ``refresh`` fails open) and is refused by the token store; an access
    token keeps working until it expires."""
    from app.core.security import create_refresh_token
    from tests.fakes import DownRedis

    ada = await _user(database, "ada@example.com")
