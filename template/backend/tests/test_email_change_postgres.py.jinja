async def test_no_email_leaves_when_the_transaction_fails(client, database, mailbox, monkeypatch) -> None:
    """A change that is not stored is not announced; a reset link whose request failed is not sent."""
    from sqlalchemy.ext.asyncio import AsyncSession

    ada = await _user(database, "ada@example.com")
    await client.post(
        f"{API}/users/me/email", json={"email": "ada@new.example", "current_password": PASSWORD}, headers=_bearer(ada)
    )
    token = _link_token(mailbox)
    mailbox.reset_mock()

    async def refused(self: AsyncSession) -> None:
        raise RuntimeError("commit refused")

    monkeypatch.setattr(AsyncSession, "commit", refused)
    async with AsyncClient(
        transport=ASGITransport(app=app, raise_app_exceptions=False), base_url="http://test"
    ) as failing:
        confirmed = await failing.post(f"{API}/auth/email/confirm", json={"token": token})
        reset = await failing.post(f"{API}/auth/password-reset/request", json={"email": "ada@example.com"})
        registered = await failing.post(f"{API}/auth/register", json={"email": "new@example.com", "password": PASSWORD})
        known = await failing.post(f"{API}/auth/register", json={"email": "ada@example.com", "password": PASSWORD})
    monkeypatch.undo()

    assert (confirmed.status_code, reset.status_code, registered.status_code, known.status_code) == (500,) * 4
    assert mailbox.mock_calls == [], "no welcome for an account that was not stored"
    assert (await _reload(database, ada.id)).email == "ada@example.com"
    async with database.system() as db:
        assert await user_repo.get_by_email(db, "new@example.com") is None


