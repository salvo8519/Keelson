async def test_password_guesses_leave_the_sign_in_limit_alone(client, database, mailbox) -> None:
    """Behind one network address (a company), a user who mistypes the current password does not
    lock colleagues out of signing in: re-authentication has its own limits (``reauth``)."""
    from app.services.rate_limit import DEFAULT_RATE_LIMITS, RateLimitCategory

    ada = await _user(database, "ada@example.com")
    await _user(database, "bob@example.com")
    budget = DEFAULT_RATE_LIMITS[RateLimitCategory.REAUTH].per_user or 0
    assert budget >= (DEFAULT_RATE_LIMITS[RateLimitCategory.AUTH].per_ip or 0)
    for n in range(budget):
        guess = await client.patch(
            f"{API}/users/me/password",
            json={"current_password": f"guess-{n:04d}", "new_password": "new-password-9"},
            headers=_bearer(ada),
        )
        assert guess.status_code == 400, guess.text

    right = await client.patch(
        f"{API}/users/me/password",
        json={"current_password": PASSWORD, "new_password": "new-password-9"},
        headers=_bearer(ada),
    )
    colleague = await client.post(f"{API}/auth/login", data={"username": "bob@example.com", "password": PASSWORD})

    assert right.status_code == 429
    assert right.json()["details"]["category"] == RateLimitCategory.REAUTH
    assert colleague.status_code == 200, colleague.text
