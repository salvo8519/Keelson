async def test_the_own_record_tells_whether_the_account_has_a_password(client, database) -> None:
    """What the profile form needs to ask for the password or for a recent sign-in."""
    ada = await _user(database, "ada@example.com")
    sso = await _user(database, "sso@example.com", hashed_password=None)

    mine = (await client.get(f"{API}/users/me", headers=_bearer(ada))).json()
    theirs = (await client.get(f"{API}/users/me", headers=_bearer(sso))).json()

    assert (mine["has_password"], theirs["has_password"]) == (True, False)
    assert "hashed_password" not in mine


async def test_the_own_record_does_not_read_the_password_hash(client, database) -> None:
    """``has_password`` is tested in the database; the hash never leaves it, and the system read
    is declared (and logged) for what it is."""
    from app.services import user as user_service

    ada = await _user(database, "ada@example.com")
    reasons: list[str] = []
    declared = user_service.system_session

    def recording(reason: str) -> Any:
        reasons.append(reason)
        return declared(reason)

    # Patched for the request only: the session of ``serving`` is restored when it ends.
    with (
        patch.object(user_service, "system_session", recording),
        patch.object(user_repo, "get_password_hash", AsyncMock(side_effect=AssertionError("hash read"))),
    ):
        me = await client.get(f"{API}/users/me", headers=_bearer(ada))

    assert me.status_code == 200, me.text
    assert me.json()["has_password"] is True
    assert reasons == ["own profile: whether the account has a password"]


def _access_signed_in(user: User, seconds_ago: int) -> dict[str, str]:
    """A bearer token of a session that started ``seconds_ago`` seconds ago."""
    import time

    from app.core.security import create_access_token

    token = create_access_token(user.id, version=user.token_epoch, signed_in_at=int(time.time()) - seconds_ago)
    return {"Authorization": f"Bearer {token}"}


async def test_an_account_without_a_password_needs_a_recent_sign_in(client, database, mailbox) -> None:
    from app.services.user import REAUTHENTICATION_WINDOW

    window = int(REAUTHENTICATION_WINDOW.total_seconds())
    sso = await _user(database, "sso@example.com", hashed_password=None)

    stale = await client.post(f"{API}/users/me/email", json={"email": "sso@new.example"}, headers=_access_signed_in(sso, window + 5))
    assert stale.status_code == 403
    assert stale.json()["details"]["reason"] == "recent_sign_in_required"
    assert mailbox.mock_calls == []

    fresh = await client.post(f"{API}/users/me/email", json={"email": "sso@new.example"}, headers=_access_signed_in(sso, 10))
    assert fresh.status_code == 202, fresh.text


async def test_a_token_without_a_sign_in_time_is_not_a_recent_sign_in(client, database, mailbox) -> None:
    """Impersonation tokens and tokens issued before the upgrade carry no ``auth_time``."""
    from app.core.security import create_access_token

    sso = await _user(database, "sso@example.com", hashed_password=None)
    token = create_access_token(sso.id, version=sso.token_epoch)

    refused = await client.post(
        f"{API}/users/me/email", json={"email": "sso@new.example"}, headers={"Authorization": f"Bearer {token}"}
    )

    assert refused.status_code == 403
    assert mailbox.mock_calls == []


async def test_a_refresh_does_not_make_a_sign_in_recent(client, database, mailbox) -> None:
    """A rotation keeps the sign-in time of the session: renewing does not count as signing in."""
    import time

    from app.core.security import REFRESH, create_refresh_token, read_session_token
    from app.services.user import REAUTHENTICATION_WINDOW

    sso = await _user(database, "sso@example.com", hashed_password=None)
    long_ago = int(time.time() - REAUTHENTICATION_WINDOW.total_seconds() - 60)
    old_refresh = create_refresh_token(sso.id, version=sso.token_epoch, signed_in_at=long_ago)

    renewed = await client.post(f"{API}/auth/refresh", json={"refresh_token": old_refresh})
    assert renewed.status_code == 200, renewed.text
    tokens = renewed.json()
    rotated = read_session_token(tokens["refresh_token"], REFRESH)
    assert rotated is not None and rotated.signed_in_at == long_ago

    refused = await client.post(
        f"{API}/users/me/email",
        json={"email": "sso@new.example"},
        headers={"Authorization": f"Bearer {tokens['access_token']}"},
    )
    assert refused.status_code == 403
    assert mailbox.mock_calls == []


