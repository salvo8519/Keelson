"""A change of e-mail address takes effect only once the new address confirms it (Keelstone).

An address that is not confirmed is not proof of anything: an account could otherwise be
opened, or moved, onto someone else's address and wait there for its owner. The requests run
through the application against a real database, under row level security.
"""

from collections.abc import AsyncIterator
from typing import Any
from unittest.mock import AsyncMock, MagicMock, patch
from urllib.parse import parse_qs, urlparse

import pytest
from httpx import ASGITransport, AsyncClient

from app.api.deps import get_redis
from app.core.config import settings
from app.core.security import create_password_reset_token, get_password_hash, issue_session_tokens
from app.db.models.user import User
from app.main import app
from app.repositories import user_repo
from app.services.organization import OrganizationService
from tests.fakes import MemoryRedis
from tests.postgres import SegregatedDatabase, require_postgres, segregated_database, serving

pytestmark = pytest.mark.anyio

API = settings.API_V1_STR
PASSWORD = "old-password-1"
VICTIM = "victim@example.com"


@pytest.fixture
async def database() -> AsyncIterator[SegregatedDatabase]:
    await require_postgres("e-mail change")
    async with segregated_database() as database:
        yield database


@pytest.fixture
def mailbox() -> AsyncIterator[MagicMock]:
    """Every e-mail the application sends, without sending it."""
    email = MagicMock()
    for method in ("send_email_change", "send_account_exists", "send_welcome", "send_password_reset"):
        setattr(email, method, AsyncMock())
    with patch("app.services.user.get_email_service", return_value=email):
        yield email


@pytest.fixture
async def client(database: SegregatedDatabase, mailbox: MagicMock) -> AsyncIterator[AsyncClient]:
    redis = MemoryRedis()
    app.dependency_overrides[get_redis] = lambda: redis
    with serving(app, database):
        async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
            yield ac
    app.dependency_overrides.clear()


async def _user(database: SegregatedDatabase, email: str, **fields: Any) -> User:
    fields.setdefault("hashed_password", get_password_hash(PASSWORD))
    async with database.system() as db:
        user = await user_repo.create(db, email=email, **fields)
        await OrganizationService(db).create_personal_org(user.id, email)
        await db.commit()
        return user


async def _reload(database: SegregatedDatabase, user_id: Any) -> User:
    async with database.system() as db:
        user = await user_repo.get_by_id(db, user_id)
        assert user is not None
        return user


def _bearer(user: User) -> dict[str, str]:
    return {"Authorization": f"Bearer {issue_session_tokens(user)[0]}"}


def _link_token(mailbox: MagicMock) -> str:
    url = mailbox.send_email_change.await_args.kwargs["confirm_url"]
    return parse_qs(urlparse(url).query)["token"][0]


async def test_a_new_address_is_pending_until_its_link_is_followed(client, database, mailbox) -> None:
    ada = await _user(database, "ada@example.com")

    requested = await client.post(f"{API}/users/me/email", json={"email": "ada@new.example"}, headers=_bearer(ada))

    assert requested.status_code == 202, requested.text
    assert mailbox.send_email_change.await_args.kwargs["to"] == "ada@new.example"
    me = await client.get(f"{API}/users/me", headers=_bearer(ada))
    assert me.json()["email"] == "ada@example.com"

    token = _link_token(mailbox)
    confirmed = await client.post(f"{API}/auth/email/confirm", json={"token": token})

    assert confirmed.status_code == 200, confirmed.text
    changed = await _reload(database, ada.id)
    assert (changed.email, changed.email_verified) == ("ada@new.example", True)
    again = await client.post(f"{API}/auth/email/confirm", json={"token": token})
    assert again.status_code == 401


async def test_the_profile_update_does_not_change_the_address(client, database) -> None:
    ada = await _user(database, "ada@example.com")

    response = await client.patch(f"{API}/users/me", json={"email": "ada@new.example"}, headers=_bearer(ada))

    assert response.status_code == 200
    assert (await _reload(database, ada.id)).email == "ada@example.com"


async def test_a_link_to_an_address_taken_meanwhile_changes_nothing(client, database, mailbox) -> None:
    ada = await _user(database, "ada@example.com")
    await client.post(f"{API}/users/me/email", json={"email": "bob@example.com"}, headers=_bearer(ada))
    await _user(database, "bob@example.com")

    confirmed = await client.post(f"{API}/auth/email/confirm", json={"token": _link_token(mailbox)})

    assert confirmed.status_code == 409
    assert (await _reload(database, ada.id)).email == "ada@example.com"


async def test_a_link_issued_before_a_sign_out_everywhere_is_void(client, database, mailbox) -> None:
    ada = await _user(database, "ada@example.com")
    await client.post(f"{API}/users/me/email", json={"email": "ada@new.example"}, headers=_bearer(ada))
    await client.post(f"{API}/auth/logout-all", headers=_bearer(ada))

    confirmed = await client.post(f"{API}/auth/email/confirm", json={"token": _link_token(mailbox)})

    assert confirmed.status_code == 401
    assert (await _reload(database, ada.id)).email == "ada@example.com"


async def test_a_request_for_the_current_or_a_taken_address_sends_nothing(client, database, mailbox) -> None:
    ada = await _user(database, "ada@example.com")
    await _user(database, "bob@example.com")

    same = await client.post(f"{API}/users/me/email", json={"email": "ADA@example.com"}, headers=_bearer(ada))
    taken = await client.post(f"{API}/users/me/email", json={"email": "bob@example.com"}, headers=_bearer(ada))

    assert (same.status_code, taken.status_code) == (400, 409)
    mailbox.send_email_change.assert_not_awaited()


async def test_a_change_request_needs_a_session(client, database, mailbox) -> None:
    response = await client.post(f"{API}/users/me/email", json={"email": "ada@new.example"})

    assert response.status_code == 401
    mailbox.send_email_change.assert_not_awaited()


async def test_only_an_unexpired_change_link_of_an_active_account_confirms(client, database, mailbox) -> None:
    """Other signed links, an expired link and a link of a disabled account change nothing."""
    from datetime import timedelta

    from app.core.security import create_email_change_token

    ada = await _user(database, "ada@example.com")
    reset_link = create_password_reset_token(str(ada.id), current_password_hash=None)
    expired = create_email_change_token(ada, "ada@new.example", expires_delta=timedelta(seconds=-1))
    for token in (reset_link, expired, "not-a-signed-link"):
        refused = await client.post(f"{API}/auth/email/confirm", json={"token": token})
        assert refused.status_code == 401, token
    await client.post(f"{API}/users/me/email", json={"email": "ada@new.example"}, headers=_bearer(ada))
    async with database.system() as db:
        await user_repo.update(db, db_user=await user_repo.get_by_id(db, ada.id), update_data={"is_active": False})
        await db.commit()

    disabled = await client.post(f"{API}/auth/email/confirm", json={"token": _link_token(mailbox)})

    assert disabled.status_code == 401
    assert (await _reload(database, ada.id)).email == "ada@example.com"


async def test_a_link_for_one_account_cannot_be_replayed_after_another_change(client, database, mailbox) -> None:
    """Two links outstanding: the first one followed voids the other (bound to the address)."""
    ada = await _user(database, "ada@example.com")
    await client.post(f"{API}/users/me/email", json={"email": "ada@one.example"}, headers=_bearer(ada))
    first = _link_token(mailbox)
    await client.post(f"{API}/users/me/email", json={"email": "ada@two.example"}, headers=_bearer(ada))
    second = _link_token(mailbox)

    assert (await client.post(f"{API}/auth/email/confirm", json={"token": second})).status_code == 200
    assert (await client.post(f"{API}/auth/email/confirm", json={"token": first})).status_code == 401
    assert (await _reload(database, ada.id)).email == "ada@two.example"


async def test_an_address_set_by_an_administrator_is_not_confirmed(database) -> None:
    from app.schemas.user import UserUpdate
    from app.services.user import UserService

    ada = await _user(database, "ada@example.com", email_verified=True)
    async with database.system() as db:
        await UserService(db).update(ada.id, UserUpdate(email="ada@admin.example"))
        await db.commit()

    assert (await _reload(database, ada.id)).email_verified is False
{%- if enable_oauth %}


# --- Pre-emptive takeover through a single sign-on identity -------------------------------


async def _sso_sign_in(database: SegregatedDatabase, email: str) -> User:
    from app.services.user import UserService

    async with database.system() as db:
        user = await UserService(db).get_or_create_oauth_user(
            provider="public", provider_id="attacker-subject", email=email, email_verified=True
        )
        await db.commit()
        return user


async def test_an_identity_cannot_wait_on_an_address_for_its_owner(client, database) -> None:
    """The proof of concept: change the address, the owner resets, sign in again by SSO."""
    attacker = await _sso_sign_in(database, "attacker@evil.example")
    await client.patch(f"{API}/users/me", json={"email": VICTIM}, headers=_bearer(attacker))
    await client.post(f"{API}/users/me/email", json={"email": VICTIM}, headers=_bearer(attacker))

    registered = await client.post(f"{API}/auth/register", json={"email": VICTIM, "password": "victim-pass-1"})
    assert registered.status_code == 202
    async with database.system() as db:
        victim = await user_repo.get_by_email(db, VICTIM)
        assert victim is not None
        stored = await user_repo.get_password_hash(db, victim.id)
    token = create_password_reset_token(str(victim.id), current_password_hash=stored)
    reset = await client.post(
        f"{API}/auth/password-reset/confirm", json={"token": token, "new_password": "victim-pass-2"}
    )
    assert reset.status_code == 200, reset.text

    again = await _sso_sign_in(database, "attacker@evil.example")

    assert again.id != victim.id
    assert (await _reload(database, victim.id)).oauth_id is None


async def test_a_reset_of_an_unconfirmed_address_removes_the_external_identities(client, database) -> None:
    """Accounts moved onto an address before confirmation was required."""
    from app.core.oidc import SignInRefused

    account = await _user(
        database, VICTIM, hashed_password=None, oauth_provider="public", oauth_id="attacker-subject"
    )
    token = create_password_reset_token(str(account.id), current_password_hash=None)

    reset = await client.post(
        f"{API}/auth/password-reset/confirm", json={"token": token, "new_password": "victim-pass-2"}
    )

    assert reset.status_code == 200, reset.text
    after = await _reload(database, account.id)
    assert (after.oauth_provider, after.oauth_id, after.email_verified) == (None, None, True)
    with pytest.raises(SignInRefused):
        await _sso_sign_in(database, VICTIM)


async def test_a_reset_of_a_confirmed_address_keeps_the_identity(client, database) -> None:
    account = await _sso_sign_in(database, "ada@example.com")
    token = create_password_reset_token(str(account.id), current_password_hash=None)

    reset = await client.post(
        f"{API}/auth/password-reset/confirm", json={"token": token, "new_password": "ada-pass-123"}
    )

    assert reset.status_code == 200, reset.text
    assert (await _reload(database, account.id)).oauth_id == "attacker-subject"
