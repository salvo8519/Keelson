def _delete_me(client: AsyncClient, headers: dict[str, str], **proof: Any) -> Any:
    return client.request("DELETE", f"{API}/users/me", json=proof or None, headers=headers)


@pytest.fixture
def deletions(monkeypatch: pytest.MonkeyPatch) -> AsyncMock:
    """The deletions the route asks for. What a deletion removes is not the subject here: these
    tests check who may ask for one."""
    from app.services.user import UserService

    deleted = AsyncMock()
    monkeypatch.setattr(UserService, "delete", deleted)
    return deleted


@pytest.mark.parametrize("proof", [{}, {"current_password": None}, {"current_password": "wrong-password-1"}])
async def test_deleting_the_account_needs_the_current_password(client, database, deletions, proof) -> None:
    """A session alone (a stolen cookie, an unlocked computer) cannot delete the account."""
    ada = await _user(database, "ada@example.com")

    refused = await _delete_me(client, _bearer(ada), **proof)

    assert refused.status_code == 400, refused.text
    deletions.assert_not_awaited()
    accepted = await _delete_me(client, _bearer(ada), current_password=PASSWORD)
    assert accepted.status_code == 204, accepted.text
    deletions.assert_awaited_once_with(ada.id)


async def test_deleting_an_account_without_a_password_needs_a_recent_sign_in(client, database, deletions) -> None:
    from app.services.user import REAUTHENTICATION_WINDOW

    window = int(REAUTHENTICATION_WINDOW.total_seconds())
    sso = await _user(database, "sso@example.com", hashed_password=None)

    stale = await _delete_me(client, _access_signed_in(sso, window + 5))
    assert stale.status_code == 403
    assert stale.json()["details"]["reason"] == "recent_sign_in_required"
    deletions.assert_not_awaited()

    fresh = await _delete_me(client, _access_signed_in(sso, 10))
    assert fresh.status_code == 204, fresh.text
    deletions.assert_awaited_once_with(sso.id)
