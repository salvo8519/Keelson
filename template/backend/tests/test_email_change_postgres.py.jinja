async def test_password_guesses_share_one_budget_across_routes(client, database, mailbox, deletions) -> None:
    """Guessing on the password change route exhausts the guesses of the address change too,
    from any client address: the right password is then refused on both routes."""
    from app.services.rate_limit import DEFAULT_RATE_LIMITS, RateLimitCategory

    ada = await _user(database, "ada@example.com")
    budget = DEFAULT_RATE_LIMITS[RateLimitCategory.REAUTH].per_user or 0
    assert budget > 0

    def elsewhere(n: int) -> AsyncClient:
        """A client from another address, so that the per-IP limit of the sign-in routes is not
        what refuses."""
        transport = ASGITransport(app=app, client=(f"10.0.0.{n}", 40000))
        return AsyncClient(transport=transport, base_url="http://test")

    for n in range(budget):
        async with elsewhere(n + 10) as other:
            wrong = await other.patch(
                f"{API}/users/me/password",
                json={"current_password": f"guess-{n:04d}", "new_password": "new-password-9"},
                headers=_bearer(ada),
            )
        assert wrong.status_code == 400, wrong.text

    async with elsewhere(1) as other:
        change = await other.patch(
            f"{API}/users/me/password",
            json={"current_password": PASSWORD, "new_password": "new-password-9"},
            headers=_bearer(ada),
        )
    async with elsewhere(2) as other:
        move = await other.post(
            f"{API}/users/me/email",
            json={"email": "ada@new.example", "current_password": PASSWORD},
            headers=_bearer(ada),
        )
    async with elsewhere(3) as other:
        delete = await other.request(
            "DELETE", f"{API}/users/me", json={"current_password": PASSWORD}, headers=_bearer(ada)
        )

    for refused in (change, move, delete):
        assert refused.status_code == 429
        assert refused.json()["details"]["category"] == RateLimitCategory.REAUTH
    assert mailbox.mock_calls == []
    deletions.assert_not_awaited()


async def test_password_changes_are_limited_per_client_ip(client, database) -> None:
    from app.services.rate_limit import DEFAULT_RATE_LIMITS, RateLimitCategory

    per_ip = DEFAULT_RATE_LIMITS[RateLimitCategory.REAUTH].per_ip or 0
    users = [await _user(database, f"user{n}@example.com") for n in range(per_ip + 1)]
    answers = [
        await client.patch(
            f"{API}/users/me/password",
            json={"current_password": "wrong-password-0", "new_password": "new-password-9"},
            headers=_bearer(user),
        )
        for user in users
    ]

    assert [answer.status_code for answer in answers] == [400] * per_ip + [429]
    assert answers[-1].json()["details"]["scope"] == "ip"
    assert answers[-1].json()["details"]["category"] == RateLimitCategory.REAUTH
