# --- E-mails leave after the request (issue #12) -------------------------------------------


def _spied(events: list[str]) -> Any:
    """The application, recording when the response starts (``events``)."""

    async def spied(scope: Any, receive: Any, send: Any) -> None:
        async def spy(message: Any) -> None:
            if message["type"] == "http.response.start":
                events.append("response")
            await send(message)

        await app(scope, receive, spy)

    return spied


@pytest.mark.parametrize(
    ("path", "body", "mail"),
    [
        ("/users/me/email", {"email": "ada@new.example", "current_password": PASSWORD}, "send_email_change"),
        ("/auth/password-reset/request", {"email": "ada@example.com"}, "send_password_reset"),
        ("/auth/magic-link/request", {"email": "ada@example.com"}, "send_magic_link"),
        ("/auth/register", {"email": "new@example.com", "password": PASSWORD}, "send_welcome"),
        ("/auth/register", {"email": "ada@example.com", "password": PASSWORD}, "send_account_exists"),
    ],
)
async def test_account_emails_are_sent_after_the_response(client, database, mailbox, path, body, mail) -> None:
    """The request does not wait for the mail transport: the answer takes the same time
    whether an address gets one e-mail, two or none."""
    ada = await _user(database, "ada@example.com")
    events: list[str] = []
    for method in MAILS:
        getattr(mailbox, method).side_effect = lambda *args, _m=method, **kwargs: events.append(_m)

    async with AsyncClient(transport=ASGITransport(app=_spied(events)), base_url="http://test") as spied:
        answer = await spied.post(f"{API}{path}", json=body, headers=_bearer(ada))

    assert answer.status_code in (200, 202), answer.text
    assert mail in events
    assert events[0] == "response", events


