"""tenant isolation with row level security (Keelson)

Revision ID: k0001_tenant_row_level_security
Revises: 0027_user_magic_link_epoch
Create Date: 2026-11-24T00:00:00+00:00

Creates the restricted role of bound sessions and one row level security policy per table
of app.db.tenancy.TENANT_TABLES that exists in this project. See app/db/tenancy.py.
"""

import sqlalchemy as sa
from alembic import op

from app.db.tenancy import (
    TENANT_TABLES,
    drop_policy_statements,
    grant_statements,
    policy_statements,
)

revision = "k0001_tenant_row_level_security"
down_revision = "0027_user_magic_link_epoch"
branch_labels = None
depends_on = None


def _existing_tables() -> list[str]:
    inspector = sa.inspect(op.get_bind())
    return [table for table in TENANT_TABLES if inspector.has_table(table)]


def upgrade() -> None:
    for statement in grant_statements():
        op.execute(statement)
    for table in _existing_tables():
        for statement in policy_statements(table):
            op.execute(statement)


def downgrade() -> None:
    # The role is cluster-wide and may be in use by another database: it is kept.
    for table in _existing_tables():
        for statement in drop_policy_statements(table):
            op.execute(statement)
{%- endif %}
