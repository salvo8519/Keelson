        sa.CheckConstraint(
            "(organization_id IS NULL) <> (user_id IS NULL)", name="stored_objects_one_owner_check"
        ),
        sa.CheckConstraint(
            "status IN ('pending', 'available', 'migrating')", name="stored_objects_status_check"
        ),
    )
    op.create_index("stored_objects_organization_id_idx", TABLE, ["organization_id"])
    op.create_index("stored_objects_user_id_idx", TABLE, ["user_id"])
    op.create_index("stored_objects_backend_status_idx", TABLE, ["backend", "status"])

    # Existing chat files: personal objects of their uploader, where upstream stored them.
    op.add_column("chat_files", sa.Column("stored_object_id", postgresql.UUID(as_uuid=True), nullable=True))
    op.execute("UPDATE chat_files SET stored_object_id = gen_random_uuid()")
    op.execute(
        f"""
        INSERT INTO {TABLE} (id, user_id, size, storage_key, backend, status, content_type,
                             created_at, status_changed_at)
        SELECT stored_object_id, user_id, size, storage_path, {LEGACY}, created_at, now()
        FROM chat_files
        """
    )
    _reference("chat_files", nullable=False, ondelete="CASCADE")
{%- if enable_rag %}

    # Existing RAG documents with a file: the user's for a personal knowledge base, otherwise
    # the organization's.
    op.add_column("rag_documents", sa.Column("stored_object_id", postgresql.UUID(as_uuid=True), nullable=True))
    personal_owner = (
        "SELECT k.owner_user_id FROM knowledge_bases k WHERE k.id = d.knowledge_base_id"
        " AND k.scope = 'personal' AND k.owner_user_id IS NOT NULL"
    )
    op.execute(
        f"""
        UPDATE rag_documents d SET stored_object_id = gen_random_uuid()
        WHERE COALESCE(d.storage_path, '') <> ''
          AND (d.organization_id IS NOT NULL OR EXISTS ({personal_owner}))
        """
    )
    op.execute(
        f"""
        INSERT INTO {TABLE} (id, organization_id, user_id, size, storage_key, backend, status,
                             content_type, created_at, status_changed_at)
        SELECT d.stored_object_id,
               CASE WHEN ({personal_owner}) IS NULL THEN d.organization_id END,
               ({personal_owner}),
               d.filesize, d.storage_path, {LEGACY}, d.created_at, now()
        FROM rag_documents d
        WHERE d.stored_object_id IS NOT NULL
        """
    )
    _reference("rag_documents", nullable=True, ondelete="SET NULL")
{%- endif %}

    # Function bodies name tables that a project may not have (sharing, knowledge bases).
    op.execute("SET LOCAL check_function_bodies = off")
    for statement in segregation_statements({TABLE}):
        op.execute(statement)


def _restore_path(table: str, *, nullable: bool) -> None:
    op.add_column(table, sa.Column("storage_path", sa.String(500), nullable=True))
    op.execute(
        f"UPDATE {table} t SET storage_path = o.storage_key FROM {TABLE} o WHERE o.id = t.stored_object_id"
    )
    if not nullable:
        op.alter_column(table, "storage_path", nullable=False)
    op.drop_index(f"{table}_stored_object_id_idx", table_name=table)
    op.drop_constraint(f"{table}_stored_object_id_fkey", table, type_="foreignkey")
    op.drop_column(table, "stored_object_id")


def downgrade() -> None:
    # Paths can only point at the local disk: objects elsewhere must be brought back first.
    remote = op.get_bind().execute(sa.text(f"SELECT count(*) FROM {TABLE} WHERE backend <> 'local'")).scalar()
    if remote:
        raise RuntimeError(
            f"{remote} stored object(s) are not on the local disk: run"
            " `cmd migrate-storage --from s3 --to local` before downgrading"
        )
    _restore_path("chat_files", nullable=False)
{%- if enable_rag %}
    _restore_path("rag_documents", nullable=True)
{%- endif %}
    op.drop_table(TABLE)
{%- endif %}
