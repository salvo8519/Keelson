"""stored objects for documents and chat files (Keelstone)

Revision ID: k0005_stored_objects
Revises: k0004_database_segregation
Create Date: 2026-11-25T00:00:00+00:00

Creates stored_objects (app/db/models/stored_object.py) and applies its row level security
with the policies of app/db/tenancy.py. Chat files{% if enable_rag %} and RAG documents{% endif %} reference a stored
object instead of a path: each existing file becomes a stored object on the local backend,
under its old path, with no hash yet (computed when it is migrated to another backend).
{%- if enable_rag %} A RAG
document whose owner cannot be determined (no organization, no personal knowledge base) keeps
no reference to its file.
{%- endif %}
"""

import sqlalchemy as sa
from alembic import op
from sqlalchemy.dialects import postgresql

from app.db.tenancy import segregation_statements

revision = "k0005_stored_objects"
down_revision = "k0004_database_segregation"
branch_labels = None
depends_on = None

TABLE = "stored_objects"
LEGACY = "'local', 'available', 'application/octet-stream'"


def _reference(table: str, *, nullable: bool, ondelete: str) -> None:
    op.create_foreign_key(
        f"{table}_stored_object_id_fkey", table, TABLE, ["stored_object_id"], ["id"], ondelete=ondelete
    )
    op.create_index(f"{table}_stored_object_id_idx", table, ["stored_object_id"])
    if not nullable:
        op.alter_column(table, "stored_object_id", nullable=False)
    op.drop_column(table, "storage_path")


def upgrade() -> None:
    op.create_table(
        TABLE,
        sa.Column("id", postgresql.UUID(as_uuid=True), primary_key=True),
        sa.Column(
            "organization_id",
            postgresql.UUID(as_uuid=True),
            sa.ForeignKey("organizations.id", ondelete="CASCADE", name="stored_objects_organization_id_fkey"),
            nullable=True,
        ),
        sa.Column(
            "user_id",
            postgresql.UUID(as_uuid=True),
            sa.ForeignKey("users.id", ondelete="CASCADE", name="stored_objects_user_id_fkey"),
            nullable=True,
        ),
        sa.Column("size", sa.BigInteger(), nullable=False),
        sa.Column("content_type", sa.String(255), nullable=False),
        sa.Column("sha256", sa.String(64), nullable=True),
        sa.Column("backend", sa.String(16), nullable=False),
        sa.Column("storage_key", sa.String(500), nullable=False),
        sa.Column("status", sa.String(16), nullable=False),
        sa.Column("previous_backend", sa.String(16), nullable=True),
        sa.Column("previous_key", sa.String(500), nullable=True),
        sa.Column("status_changed_at", sa.DateTime(timezone=True), nullable=True),
        sa.Column("created_at", sa.DateTime(timezone=True), server_default=sa.func.now(), nullable=False),
