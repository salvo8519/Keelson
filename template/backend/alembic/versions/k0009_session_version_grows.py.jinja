def upgrade() -> None:
    op.execute("SET LOCAL check_function_bodies = off")
    for statement in segregation_statements({"users"}):
        op.execute(statement)


def downgrade() -> None:
    op.execute(f'DROP TRIGGER IF EXISTS {POLICY_PREFIX}token_epoch_never_decreases ON "users"')
