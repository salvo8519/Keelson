{%- if use_arq %}
"""ARQ (Async Redis Queue) application configuration."""

import logging
from typing import Any

from arq import cron

from app.worker.arq_pool import REDIS_SETTINGS
{%- if enable_rag %}
from app.worker.tasks.rag_tasks import (
    check_scheduled_syncs,
    ingest_document_task,
    sync_collection_task,
    sync_single_source_task,
)
{%- endif %}
{%- if enable_teams and use_postgresql %}
from app.worker.tasks.storage_tasks import cleanup_storage_task, migrate_object_task
{%- endif %}
{%- if enable_email and enable_billing %}
from app.worker.tasks.email_tasks import send_trial_reminders_task
{%- endif %}
{%- if enable_email and enable_credits_system %}
from app.worker.tasks.email_tasks import send_low_credits_alerts_task
{%- endif %}
{%- if enable_credits_system %}
from app.worker.tasks.cleanup_tasks import cleanup_usage_events_task
{%- endif %}

logger = logging.getLogger(__name__)


async def startup(ctx: dict[str, Any]) -> None:
    """Initialize resources on worker startup."""
    logger.info("ARQ worker starting up...")


async def shutdown(ctx: dict[str, Any]) -> None:
    """Cleanup resources on worker shutdown."""
    logger.info("ARQ worker shutting down...")


class WorkerSettings:
    """ARQ Worker configuration. Used by the ARQ CLI: arq app.worker.arq_app.WorkerSettings."""

    redis_settings = REDIS_SETTINGS

    functions = [
{%- if enable_rag %}
        # Keelstone: the jobs the API enqueues by name are registered (upstream registered only
        # the sync of one source, so uploads and local syncs never ran).
        ingest_document_task,
        sync_collection_task,
        sync_single_source_task,
{%- endif %}
{%- if enable_teams and use_postgresql %}
        migrate_object_task,
        cleanup_storage_task,
{%- endif %}
{%- if enable_email and enable_billing %}
        send_trial_reminders_task,
{%- endif %}
{%- if enable_email and enable_credits_system %}
        send_low_credits_alerts_task,
{%- endif %}
{%- if enable_credits_system %}
        cleanup_usage_events_task,
{%- endif %}
    ]

    cron_jobs = [
{%- if enable_rag %}
        cron(check_scheduled_syncs),
{%- endif %}
{%- if enable_teams and use_postgresql %}
        cron(cleanup_storage_task, hour=4, minute=30),
{%- endif %}
{%- if enable_email and enable_billing %}
        cron(send_trial_reminders_task, hour=9, minute=0),
{%- endif %}
{%- if enable_email and enable_credits_system %}
        cron(send_low_credits_alerts_task, minute=0),
{%- endif %}
{%- if enable_credits_system %}
        cron(cleanup_usage_events_task, weekday=0, hour=3, minute=0),
{%- endif %}
    ]

    on_startup = startup
    on_shutdown = shutdown

    max_jobs = 10
    job_timeout = 300
    keep_result = 3600
    poll_delay = 0.5
    queue_read_limit = 100
{%- endif %}
