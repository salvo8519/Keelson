logger = logging.getLogger(__name__)

# Content types of the stored originals, by extension.
_CONTENT_TYPES = {
    "pdf": "application/pdf",
    "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "txt": "text/plain",
    "md": "text/markdown",
}


def content_type_of(filetype: str) -> str:
    return _CONTENT_TYPES.get(filetype.lower(), "application/octet-stream")


class RAGDocumentService:
    """Service for RAG document tracking and lifecycle management."""

    def __init__(self, db: AsyncSession):
        self.db = db

    async def list_documents(
        self,
        collection_name: str | None = None,
    ) -> RAGTrackedDocumentList:
        """List tracked RAG documents, optionally filtered by collection."""
        docs = await rag_document_repo.get_all(self.db, collection_name)
        return RAGTrackedDocumentList(
            items=[
                RAGTrackedDocumentItem(
                    id=str(d.id), collection_name=d.collection_name, filename=d.filename,
                    filesize=d.filesize, filetype=d.filetype, status=d.status,
                    error_message=d.error_message, vector_document_id=d.vector_document_id,
                    chunk_count=d.chunk_count, has_file=d.stored_object_id is not None,
                    created_at=d.created_at.isoformat() if d.created_at else None,
                    completed_at=d.completed_at.isoformat() if d.completed_at else None,
                )
                for d in docs
            ],
            total=len(docs),
        )
{%- if enable_teams %}

    async def list_for_kb(
        self, *, kb_id: UUID, skip: int = 0, limit: int = 50
    ) -> RAGTrackedDocumentList:
        """List documents ingested into a Knowledge Base, paginated."""
        rows, total = await rag_document_repo.get_for_kb(
            self.db, kb_id, skip=skip, limit=limit
        )
        return RAGTrackedDocumentList(
            items=[
                RAGTrackedDocumentItem(
                    id=str(d.id), collection_name=d.collection_name, filename=d.filename,
                    filesize=d.filesize, filetype=d.filetype, status=d.status,
                    error_message=d.error_message, vector_document_id=d.vector_document_id,
                    chunk_count=d.chunk_count, has_file=d.stored_object_id is not None,
                    created_at=d.created_at.isoformat() if d.created_at else None,
                    completed_at=d.completed_at.isoformat() if d.completed_at else None,
                )
                for d in rows
            ],
            total=total,
        )
{%- endif %}

    async def get_document(self, doc_id: str) -> RAGDocument:
        """Get a RAG document by ID.

        Raises:
            NotFoundError: If document does not exist.
        """
        doc = await rag_document_repo.get_by_id(self.db, UUID(doc_id))
        if not doc:
            raise NotFoundError(
                message="Document not found",
                details={"doc_id": doc_id},
            )
        return doc

    async def create_document(
        self,
        *,
        collection_name: str,
        filename: str,
        filesize: int,
        filetype: str,
        stored_object_id: UUID | None = None,
{%- if enable_teams %}
        organization_id: UUID | None = None,
{%- endif %}
{%- if enable_teams and use_jwt %}
        knowledge_base_id: UUID | None = None,
{%- endif %}
    ) -> RAGDocument:
        """Create a new RAG document tracking record."""
        return await rag_document_repo.create(
            self.db,
            collection_name=collection_name,
            filename=filename,
            filesize=filesize,
            filetype=filetype,
            stored_object_id=stored_object_id,
{%- if enable_teams %}
            organization_id=organization_id,
{%- endif %}
{%- if enable_teams and use_jwt %}
            knowledge_base_id=knowledge_base_id,
{%- endif %}
        )

    async def dispatch_upload(
        self,
        *,
        collection_name: str,
        upload: AsyncReadable,
        filename: str,
        replace: bool,
        vector_store: Any,
        owner: ObjectOwner,
{%- if enable_teams %}
        organization_id: UUID | None = None,
{%- endif %}
{%- if enable_teams and use_jwt %}
        knowledge_base_id: UUID | None = None,
{%- endif %}
    ) -> RAGIngestResponse:
        """Validate, persist, and queue an uploaded file for ingestion.

        Performs:
          1. file-extension validation (against ``settings``);
          2. storage as a stored object of ``owner``, streamed and size-checked on the way;
          3. RAGDocument tracking-record creation;
          4. lazy creation of the target vector collection;
          5. dispatch of the ingestion task, which reads the stored object (Keelson: upstream
             passed a copy under ``MEDIA_DIR/_rag_tmp``, which only a worker sharing that disk
             could read, and which was never removed).
        """
        allowed = get_supported_formats(getattr(settings, "PDF_PARSER", "pymupdf"))
        max_size = settings.MAX_UPLOAD_SIZE_MB * 1024 * 1024

        ext = Path(filename).suffix.lower()
        if ext not in allowed:
            raise BadRequestError(
                message=f"File type '{ext}' not supported",
                details={"ext": ext, "allowed": sorted(allowed)},
            )
        try:
            stored = await StoredObjectService(self.db).store(
                owner=owner,
                chunks=iter_readable(upload),
                content_type=content_type_of(ext.lstrip(".")),
                max_size=max_size,
            )
        except ObjectTooLargeError:
            raise BadRequestError(
                message=f"File too large. Maximum {settings.MAX_UPLOAD_SIZE_MB}MB.",
                details={"max_mb": settings.MAX_UPLOAD_SIZE_MB},
            ) from None
        rag_doc = await self.create_document(
            collection_name=collection_name,
            filename=filename,
            filesize=stored.size,
            filetype=ext.lstrip("."),
            stored_object_id=stored.id,
{%- if enable_teams %}
            organization_id=organization_id,
{%- endif %}
{%- if enable_teams and use_jwt %}
            knowledge_base_id=knowledge_base_id,
{%- endif %}
        )
        doc_id = rag_doc.id

        await vector_store.create_collection(collection_name)
        await self._enqueue_ingestion(
            doc_id=str(doc_id),
            collection_name=collection_name,
            stored_object_id=str(stored.id),
            filename=filename,
            replace=replace,
        )

        return RAGIngestResponse(
            id=str(doc_id),
            status="processing",
            filename=filename,
            collection=collection_name,
            message="File accepted. Processing in background.",
        )

    async def _enqueue_ingestion(
        self,
        *,
        doc_id: str,
        collection_name: str,
        stored_object_id: str,
        filename: str,
        replace: bool,
    ) -> None:
        """Queue the ingestion of a stored document on the configured task backend."""
{%- if use_celery %}
        from app.worker.tasks.rag_tasks import ingest_document_task
        ingest_document_task.delay(
            rag_document_id=doc_id,
            collection_name=collection_name,
            stored_object_id=stored_object_id,
            source_path=filename,
            replace=replace,
        )
{%- elif use_taskiq %}
        # Keelson: Taskiq enqueues with kiq (upstream called Celery's delay, which Taskiq tasks
        # do not have: every upload failed with AttributeError).
        from app.worker.tasks.rag_tasks import ingest_document_task
        await ingest_document_task.kiq(
            rag_document_id=doc_id,
            collection_name=collection_name,
            stored_object_id=stored_object_id,
            source_path=filename,
            replace=replace,
        )
{%- elif use_arq %}
        pool = await get_arq_pool()
        await pool.enqueue_job(
            "ingest_document_task",
            doc_id,
            collection_name,
            stored_object_id,
            filename,
            replace,
        )
{%- elif use_prefect %}
        import asyncio
        from app.worker.tasks.rag_tasks import ingest_document_flow
        asyncio.create_task(ingest_document_flow(
            rag_document_id=doc_id,
            collection_name=collection_name,
            stored_object_id=stored_object_id,
            source_path=filename,
            replace=replace,
        ))
{%- else %}
        fire_and_forget(
            ingest_document_in_background(
                rag_document_id=doc_id,
                collection_name=collection_name,
                stored_object_id=stored_object_id,
                source_path=filename,
                replace=replace,
            ),
            label="rag.ingest_document",
        )
{%- endif %}

    async def complete_ingestion(
        self,
        doc_id: str,
        vector_document_id: str,
        chunk_count: int = 0,
    ) -> None:
        """Mark a document as successfully ingested.

        Raises:
            NotFoundError: The document no longer exists.
        """
        if not await rag_document_repo.mark_ingested(
            self.db,
            UUID(doc_id),
            vector_document_id=vector_document_id,
            chunk_count=chunk_count,
            completed_at=datetime.now(UTC),
        ):
            raise NotFoundError(message="Document not found", details={"doc_id": doc_id})

    async def finish_ingestion(
        self,
        doc_id: str,
        *,
        collection_name: str,
        vector_document_id: str,
        ingestion: "IngestionService",
    ) -> bool:
        """Record the vectors a worker wrote; False when the document was deleted meanwhile.

        Keelson: a document deleted while it was ingested had no vectors to remove yet, and the
        worker's vectors stayed searchable with no row to delete them. The worker removes what
        it wrote when the document is gone.
        """
        try:
            await self.complete_ingestion(doc_id, vector_document_id=vector_document_id)
        except NotFoundError:
            logger.info("Document %s deleted during its ingestion: removing its vectors", doc_id)
            if not await ingestion.remove_document(collection_name, vector_document_id):
                logger.error(
                    "Vectors %s of deleted document %s could not be removed from %s",
                    vector_document_id, doc_id, collection_name,
                )
            return False
        return True

    async def fail_ingestion(self, doc_id: str, error_message: str) -> None:
        """Mark a document ingestion as failed."""
        doc = await self.get_document(doc_id)
        await rag_document_repo.update_status(
            self.db,
            doc.id,
            status="error",
            error_message=error_message,
            completed_at=datetime.now(UTC),
        )

    async def retry_ingestion(self, doc_id: str) -> RAGDocument:
        """Queue a failed document for ingestion again, from its stored original.

        Keelson: upstream only reset the status, so the document stayed "processing" for ever.

        Raises:
            NotFoundError: If document does not exist.
            BadRequestError: If the document has not failed, or keeps no original to read.
        """
        doc = await self.get_document(doc_id)
        if doc.status != "error":
            raise BadRequestError(
                message="Only failed documents can be retried", details={"doc_id": doc_id}
            )
        if doc.stored_object_id is None:
            raise BadRequestError(
                message="This document keeps no original file: sync its source again",
                details={"doc_id": doc_id},
            )
        updated = await rag_document_repo.update_status(
            self.db,
            doc.id,
            status="processing",
            error_message="",
            completed_at=None,
        )
        if updated is None:
            raise NotFoundError(message="Document not found", details={"doc_id": doc_id})
        await self._enqueue_ingestion(
            doc_id=str(doc.id),
            collection_name=doc.collection_name,
            stored_object_id=str(doc.stored_object_id),
            filename=doc.filename,
            replace=True,
        )
        return updated

    async def delete_document(self, doc_id: str, ingestion: "IngestionService") -> None:
        """Delete a document, its vectors and its stored file.

        Keelson: the vectors are part of the delete, not an optional extra (upstream kept them
        when no ingestion service was passed, so a deleted document stayed searchable), and a
        delete that removes no row (absent, or refused by row level security) is not a success.
        The row goes first, so a refused delete touches nothing else; a vector store failure
        undoes the request's transaction.

        Raises:
            NotFoundError: The document does not exist or was not deleted.
            ExternalServiceError: The vector store did not delete the vectors.
        """
        doc = await self.get_document(doc_id)
        deleted = await rag_document_repo.delete(self.db, doc.id)
        if deleted is None:
            raise NotFoundError(message="Document not found", details={"doc_id": doc_id})
        # A document still processing has no vectors yet: its worker removes them on completion
        # (finish_ingestion).
        if deleted.vector_document_id and not await ingestion.remove_document(
            deleted.collection_name, deleted.vector_document_id
        ):
            raise ExternalServiceError(
                message="The document's vectors could not be deleted", details={"doc_id": doc_id}
            )
        if deleted.stored_object_id is not None:
            await StoredObjectService(self.db).delete(deleted.stored_object_id)
{%- if enable_teams and use_jwt %}

    async def delete_for_knowledge_base(self, kb_id: UUID) -> None:
        """Delete the documents of a knowledge base and their stored files (Keelson).

        The vectors go with the knowledge base's collection (KnowledgeBaseService.delete).
        """
        for stored_object_id in await rag_document_repo.delete_for_kb(self.db, kb_id):
            await StoredObjectService(self.db).delete(stored_object_id)
{%- endif %}

    async def delete_by_collection(self, collection_name: str) -> int:
        """Delete all RAG document records for a collection.

        Returns:
            Number of deleted records.
        """
        return await rag_document_repo.delete_by_collection(self.db, collection_name)

    async def download(self, doc_id: str) -> Response:
        """The original file of a document, streamed or as a short-lived presigned URL.

        Raises:
            NotFoundError: If the document or its file does not exist, or is not visible.
        """
        doc = await self.get_document(doc_id)
        if doc.stored_object_id is None:
            raise NotFoundError(message="No file stored for this document")
        return await StoredObjectService(self.db).download(
            doc.stored_object_id,
            filename=doc.filename,
            disposition="attachment",
            media_type=content_type_of(doc.filetype),
        )


