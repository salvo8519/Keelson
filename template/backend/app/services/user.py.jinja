logger = logging.getLogger(__name__)


def _claiming_address(user: User, update_data: dict[str, Any]) -> dict[str, Any]:
    """Keelstone: the update of an account whose user just proved control of its address.

    A password reset or a sign-in link reaches whoever controls the address. When the address
    was never confirmed, the account may have been opened or moved onto it by someone else
    (an unconfirmed change, made before confirmation was required): the external identities
    of the account are removed with it, so their holder cannot sign in again by single sign-on
    into the account the owner of the address now uses. The address is confirmed from now on.
    """
    claimed = {**update_data, "email_verified": True}
{%- if enable_oauth %}
    if not user.email_verified and user.oauth_provider is not None:
        logger.warning("external_identity_removed", extra={"user_id": str(user.id)})
        claimed |= {"oauth_provider": None, "oauth_id": None}
{%- endif %}
    return claimed


def _ending_sessions(update_data: dict[str, Any], *, always: bool = False) -> dict[str, Any]:
    """Keelstone: the update, raising the session version when it changes the credentials.

    A new password (changed, reset or set by an administrator) and a deactivation end every
    session issued before: tokens carry the version they were issued in
    (app/core/security.py). The rehash of a password at sign-in keeps the sessions. The
    increment is done by the database, so concurrent changes cannot cancel each other.
    """
    if always or "hashed_password" in update_data or update_data.get("is_active") is False:
        return {**update_data, "token_epoch": User.token_epoch + 1}
    return update_data


class UserService:

    def __init__(self, db: AsyncSession):
        self.db = db

    async def _is_first_user(self) -> bool:
        count = (await self.db.execute(select(func.count()).select_from(User))).scalar_one()
        return count == 0

    async def get_by_id(self, user_id: UUID) -> User:
        user = await user_repo.get_by_id(self.db, user_id)
        if not user:
            raise NotFoundError(
                message="User not found",
                details={"user_id": user_id},
            )
        return user

    async def get_by_email(self, email: str) -> User | None:
        return await user_repo.get_by_email(self.db, email)

    async def get_multi(
        self,
        *,
        skip: int = 0,
        limit: int = 100,
    ) -> list[User]:
        return await user_repo.get_multi(self.db, skip=skip, limit=limit)

{%- if enable_pagination %}
    async def list_paginated(self) -> Page[UserRead]:
        return await paginate(self.db, user_repo.list_query())
{%- endif %}

    async def delete_non_admins(self) -> int:
{%- if enable_memory %}
        user_ids = await user_repo.list_non_admin_ids(self.db)
        deleted = await user_repo.delete_non_admins(self.db)
        # As in delete(): the memory store has no foreign key to users, and a
        # failure to clear it rolls the request's transaction back too.
        for user_id in user_ids:
            await forget_user_memory(user_id)
        return deleted
{%- else %}
        return await user_repo.delete_non_admins(self.db)
{%- endif %}

    async def has_any(self) -> bool:
        return await user_repo.has_any(self.db)

    async def admin_list_with_counts(
        self,
        *,
        skip: int = 0,
        limit: int = 50,
        search: str | None = None,
        sort_by: str = "created_at",
        sort_dir: str = "desc",
    ) -> AdminUserList:
        rows, total = await user_repo.admin_list_with_counts(
            self.db,
            skip=skip,
            limit=limit,
            search=search,
            sort_by=sort_by,
            sort_dir=sort_dir,
        )
        items = [
            AdminUserRead(
                id=user.id,
                email=user.email,
                full_name=user.full_name,
                role=user.role,
                is_active=user.is_active,
                is_app_admin=getattr(user, "is_app_admin", False),
                conversation_count=conv_count,
                created_at=user.created_at,
            )
            for user, conv_count in rows
        ]
        return AdminUserList(items=items, total=total)

    async def register(self, user_in: UserRegister) -> User | None:
        """Self-registration: a plain user (the first one excepted, see ``_create``).

        Keelstone: an address that already has an account is not disclosed. Nothing is created,
        the owner of the address is told by e-mail, and None is returned: the route answers
        as for a new account. The password is hashed all the same, so the time taken does not
        tell the two cases apart.
        """
        existing = await user_repo.get_by_email(self.db, user_in.email)
        if existing is not None:
            await run_in_threadpool(get_password_hash, user_in.password)
{%- if enable_email %}
            try:
                frontend = settings.FRONTEND_URL.rstrip("/")
                await get_email_service().send_account_exists(
                    to=existing.email,
                    name=existing.full_name or existing.email,
                    login_url=f"{frontend}/login",
                    reset_url=f"{frontend}/recover-password",
                    language=existing.locale,
                )
            except Exception:
                logger.exception("account_exists_email_failed", extra={"user_id": str(existing.id)})
{%- endif %}
            return None
        return await self._create(user_in, UserRole.USER)

    async def create(self, user_in: UserCreate) -> User:
        """An account created by a platform administrator, with the role they chose."""
        return await self._create(user_in, user_in.role)

    async def _create(self, user_in: UserRegister | UserCreate, role: UserRole) -> User:
        """Create a local password account.

        The first user to register is auto-promoted to app-admin — no separate
        CLI step needed. That convenience is a land-grab on a public
        deployment, so the window matters: whoever registers first owns the
        app. Set ``FIRST_ADMIN_EMAIL`` (or run ``cmd create-app-admin``) and
        register before exposing the API publicly.
        """
        existing = await user_repo.get_by_email(self.db, user_in.email)
        if existing:
            raise AlreadyExistsError(
                message="Email already registered",
                details={"email": user_in.email},
            )

        is_first_user = await self._is_first_user()

        hashed_password = get_password_hash(user_in.password)
        user = await user_repo.create(
            self.db,
            email=user_in.email,
            hashed_password=hashed_password,
            full_name=user_in.full_name,
            role=UserRole.ADMIN.value if is_first_user else role.value,
            # The role and the flag are written together (User.has_role needs both).
            is_app_admin=is_first_user or role == UserRole.ADMIN,
        )
{%- if enable_teams %}
        org_service = OrganizationService(self.db)
        await org_service.create_personal_org(user.id, user_in.email)
{%- endif %}
{%- if enable_email %}
        try:
            login_url = settings.FRONTEND_URL.rstrip("/") + "/login"
            await get_email_service().send_welcome(
                to=user.email,
                name=user.full_name or user.email,
                login_url=login_url,
            )
        except Exception:
            logger.exception(
                "welcome_email_failed",
                extra={"user_id": str(user.id), "email": user.email},
            )
{%- endif %}
        return user

{%- if use_delegated_auth %}
    async def get_or_create_from_idp(
        self,
        *,
        external_user_id: str,
        email: str,
        full_name: str | None = None,
    ) -> User:
        """Auto-provision a local row for a delegated-auth IdP user.

        Lookup order:
        1. ``external_user_id`` (stable, IdP-issued) — fast path on every
           subsequent request.
        2. ``email`` — for users that pre-existed in the local DB before
           switching to delegated auth (e.g., migrated SaaS).
        3. Create new row + personal org + welcome email (best-effort).

        Step 2 adopts a row on an unverified email match, which is only safe
        because delegated mode does not generate ``/auth/register``: no
        attacker-controlled row can be sitting on a victim's address waiting to
        be adopted. If local registration is ever reintroduced here, this
        lookup has to require ``external_user_id`` instead.
        """
        existing = await user_repo.get_by_external_user_id(self.db, external_user_id)
        if existing:
            return existing

        by_email = await user_repo.get_by_email(self.db, email)
        if by_email is not None:
            await user_repo.update(
                self.db,
                db_user=by_email,
                update_data={"external_user_id": external_user_id},
            )
            return by_email

        is_first_user = await self._is_first_user()

        user = await user_repo.create(
            self.db,
            email=email,
            hashed_password=None,
            full_name=full_name,
            external_user_id=external_user_id,
            role=UserRole.ADMIN.value if is_first_user else UserRole.USER.value,
            is_app_admin=is_first_user,
        )
{%- if enable_teams %}
        org_service = OrganizationService(self.db)
        await org_service.create_personal_org(user.id, user.email)
{%- endif %}
        return user

{%- endif %}
{%- if enable_oauth %}
    async def get_or_create_oauth_user(
        self,
        *,
        provider: str,
        provider_id: str,
        email: str,
        full_name: str | None = None,
        email_verified: bool = False,
    ) -> User:
        """The user of a provider identity, created at the first sign-in.

        Keelstone: upstream attached the identity to any account with the same address, so an
        account opened with someone else's address (registration does not verify it) received
        that person's sign-ins, and a directory trusted for its addresses could sign in as any
        local user. An existing account is now linked only when it has no password, no other
        identity and no platform role, and the token itself says the address is verified;
        otherwise the sign-in is refused (the user signs in with their password).
        """
        existing = await user_repo.get_by_oauth(self.db, provider, provider_id)
        if existing:
            return existing

        by_email = await user_repo.get_by_email(self.db, email)
        if by_email is not None:
            linkable = (
                email_verified
                and not await user_repo.get_password_hash(self.db, by_email.id)
                and by_email.oauth_provider is None
                and not getattr(by_email, "is_app_admin", False)
            )
            if not linkable:
                raise SignInRefused("account_exists", "an account with this address exists")
            return await user_repo.update(
                self.db,
                db_user=by_email,
                update_data={"oauth_provider": provider, "oauth_id": provider_id, "email_verified": True},
            )

        user = await user_repo.create(
            self.db,
            email=email,
            hashed_password=None,
            full_name=full_name,
            oauth_provider=provider,
            oauth_id=provider_id,
            # The sign-in accepted the address as verified (app/core/oidc.py).
            email_verified=True,
        )
{%- if enable_teams %}
        org_service = OrganizationService(self.db)
        await org_service.create_personal_org(user.id, user.email)
{%- endif %}
{%- if enable_email %}
        try:
            login_url = settings.FRONTEND_URL.rstrip("/") + "/login"
            await get_email_service().send_welcome(
                to=user.email,
                name=user.full_name or user.email,
                login_url=login_url,
            )
        except Exception:
            logger.exception(
                "welcome_email_failed",
                extra={"user_id": str(user.id), "email": user.email},
            )
{%- endif %}
        return user
{%- endif %}

    async def authenticate(self, email: str, password: str) -> User:
        user = await user_repo.get_by_email(self.db, email)
        # Keelstone: the hash is read explicitly (deferred, and hidden from the application login).
        stored = await user_repo.get_password_hash(self.db, user.id) if user else None
        if not user or not stored:
            # Same work as a real check, so the time does not tell which addresses exist.
            await run_in_threadpool(verify_password, password, DUMMY_HASH)
            raise AuthenticationError(message="Invalid email or password")
        # Hashing is deliberately slow: off the event loop.
        verified, upgraded = await run_in_threadpool(verify_and_update_password, password, stored)
        if not verified:
            raise AuthenticationError(message="Invalid email or password")
        if not user.is_active:
            raise AuthenticationError(message="User account is disabled")
        if upgraded:
            # An older hash (bcrypt) is replaced with Argon2id now that the password is known.
            user = await user_repo.update(
                self.db, db_user=user, update_data={"hashed_password": upgraded}
            )
        return user

    async def update(self, user_id: UUID, user_in: UserUpdate) -> User:
        user = await self.get_by_id(user_id)

        update_data = user_in.model_dump(exclude_unset=True)
        if "password" in update_data:
            update_data["hashed_password"] = get_password_hash(update_data.pop("password"))
        if update_data.get("role") is not None:
            update_data["is_app_admin"] = update_data["role"] == UserRole.ADMIN
        # Keelstone: an address set by an administrator is not confirmed by its owner.
        if update_data.get("email") not in (None, user.email):
            update_data["email_verified"] = False

        return await user_repo.update(self.db, db_user=user, update_data=_ending_sessions(update_data))

    async def end_all_sessions(self, user: User) -> User:
        """Sign the user out of every device: every token issued so far stops working."""
        return await user_repo.update(self.db, db_user=user, update_data=_ending_sessions({}, always=True))

    async def update_me(self, user: User, user_in: UserUpdateMe) -> User:
        """Update the caller's own profile (the address changes through request_email_change)."""
        update_data = user_in.model_dump(exclude_unset=True)
        return await user_repo.update(self.db, db_user=user, update_data=update_data)

    async def change_password(self, user: User, current_password: str, new_password: str) -> None:
        """Change the caller's own password after checking the current one."""
        # Keelstone: the application login cannot read password hashes; the caller's own one is
        # read by a declared system read of the authenticated user's row.
        async with system_session("password change: current password") as system_db:
            stored = await user_repo.get_password_hash(system_db, user.id)
        if not stored or not await run_in_threadpool(verify_password, current_password, stored):
            raise BadRequestError(message="Incorrect password")
        if current_password == new_password:
            raise BadRequestError(message="New password cannot be the same as the current one")
        await user_repo.update(
            self.db,
            db_user=user,
            update_data=_ending_sessions({"hashed_password": get_password_hash(new_password)}),
        )

    async def update_avatar(
        self, user_id: UUID, file_data: bytes, filename: str, content_type: str
    ) -> User:
        if content_type not in AVATAR_TYPES:
            raise ValueError("Only JPEG, PNG, WebP, and GIF images are allowed")
        if len(file_data) > AVATAR_MAX_BYTES:
            raise ValueError("Avatar image too large. Maximum 2MB.")
        user = await self.get_by_id(user_id)
        path = await replace_avatar(avatar_folder("user", user_id), user.avatar_url, filename, file_data)
        return await user_repo.update(self.db, db_user=user, update_data={"avatar_url": path})

    def get_avatar_path(self, user: User) -> str | None:
        return avatar_path(avatar_folder("user", user.id), user.avatar_url)

    async def delete(self, user_id: UUID) -> User:
        user = await user_repo.delete(self.db, user_id)
        if not user:
            raise NotFoundError(
                message="User not found",
                details={"user_id": user_id},
            )
{%- if enable_memory %}
        # The memory store has no foreign key to users. If it cannot be cleared,
        # this raises and the request's transaction rolls the user back too.
        await forget_user_memory(user_id)
{%- endif %}
        return user

{%- if enable_email %}

    async def issue_password_reset_token(self, email: str) -> tuple[User, str] | None:
        """Returns None (not raises) to avoid leaking whether the email is registered."""
        user = await user_repo.get_by_email(self.db, email)
        if user is None or not user.is_active:
            return None
        token = create_password_reset_token(
            subject=str(user.id),
            current_password_hash=await user_repo.get_password_hash(self.db, user.id),
        )
        return user, token

    async def confirm_password_reset(self, token: str, new_password: str) -> User:
        payload = verify_special_token(token, expected_type="password_reset")
        if payload is None or "sub" not in payload:
            raise AuthenticationError(message="Reset link is invalid or has expired")
        try:
            user_id = UUID(str(payload["sub"]))
        except (TypeError, ValueError) as exc:
            raise AuthenticationError(
                message="Reset link is invalid or has expired"
            ) from exc

        user = await self.get_by_id(user_id)
        if not user.is_active:
            raise AuthenticationError(message="Account is disabled")

        # Single use: the token is bound to the password hash it was issued
        # against, so a link that has already been redeemed no longer matches.
        if payload.get("pwe") != password_epoch(await user_repo.get_password_hash(self.db, user.id)):
            raise AuthenticationError(message="Reset link is invalid or has expired")

        await user_repo.update(
            self.db,
            db_user=user,
            update_data=_claiming_address(
                user, _ending_sessions({"hashed_password": get_password_hash(new_password)})
            ),
        )
{%- if enable_session_management and use_jwt %}
        # Revoke any active sessions so a previously-issued refresh token cannot
        # outlive a password reset. The current request returns no tokens — the
        # user must log in again.
        await session_repo.deactivate_all_user_sessions(self.db, user.id)
{%- endif %}
        return user

    async def issue_magic_link_token(self, email: str) -> tuple[User, str] | None:
        user = await user_repo.get_by_email(self.db, email)
        if user is None or not user.is_active:
            return None
        token = create_magic_link_token(
            subject=str(user.id), magic_link_epoch=user.magic_link_epoch
        )
        return user, token

    async def consume_magic_link_token(self, token: str) -> User:
        """Redeem a sign-in link exactly once.

        Caller is responsible for minting access/refresh tokens for the returned
        user. Bumping the epoch here is what makes the link single-use, so this
        must run before the caller issues any credential.
        """
        payload = verify_special_token(token, expected_type="magic_link")
        if payload is None or "sub" not in payload:
            raise AuthenticationError(message="Magic link is invalid or has expired")
        try:
            user_id = UUID(str(payload["sub"]))
        except (TypeError, ValueError) as exc:
            raise AuthenticationError(
                message="Magic link is invalid or has expired"
            ) from exc

        user = await self.get_by_id(user_id)
        if not user.is_active:
            raise AuthenticationError(message="Account is disabled")

        if payload.get("mle") != user.magic_link_epoch:
            raise AuthenticationError(message="Magic link is invalid or has expired")

        # Invalidates this link and every other one outstanding for the user.
        await user_repo.update(
            self.db,
            db_user=user,
            update_data=_claiming_address(user, {"magic_link_epoch": user.magic_link_epoch + 1}),
        )
        return user

    async def request_email_change(self, user: User, new_email: str) -> None:
        """Keelstone: send a confirmation link to ``new_email``; the address does not change yet.

        An address in use by another account is refused, as before; the link is checked again
        when it is followed.
        """
        if new_email == user.email:
            raise BadRequestError(message="This is already the address of the account")
        # The caller's session sees the accounts of their organizations only; an address is
        # taken by any account, so it is looked up by a declared system read.
        async with system_session("email change: address in use") as system_db:
            taken = await user_repo.get_by_email(system_db, new_email) is not None
        if taken:
            raise AlreadyExistsError(message="Email already registered", details={"email": new_email})
        token = create_email_change_token(user, new_email)
        try:
            await get_email_service().send_email_change(
                to=new_email,
                name=user.full_name or new_email,
                confirm_url=f"{settings.FRONTEND_URL.rstrip('/')}/confirm-email?token={token}",
                language=user.locale,
            )
        except Exception:
            logger.exception("email_change_email_failed", extra={"user_id": str(user.id)})

    async def confirm_email_change(self, token: str) -> User:
        """Keelstone: make the address of a change link the account's address, once."""
        payload = verify_special_token(token, expected_type="email_change") or {}
        try:
            user_id = UUID(str(payload["sub"]))
            new_email = str(payload["email"])
        except (KeyError, TypeError, ValueError) as exc:
            raise AuthenticationError(message="Confirmation link is invalid or has expired") from exc
        user = await self.get_by_id(user_id)
        if not user.is_active:
            raise AuthenticationError(message="Account is disabled")
        # Single use and bound to the session version: the address it replaces must still be
        # in force, and a sign-out from every device voids outstanding links.
        if payload.get("ver") != user.token_epoch or payload.get("cur") != address_digest(user.email):
            raise AuthenticationError(message="Confirmation link is invalid or has expired")
        if await user_repo.get_by_email(self.db, new_email) is not None:
            raise AlreadyExistsError(message="Email already registered", details={"email": new_email})
        return await user_repo.update(
            self.db, db_user=user, update_data={"email": new_email, "email_verified": True}
        )
{%- endif %}
