    async def issue_password_reset_token(self, email: str) -> tuple[User, str] | None:
        """Returns None (not raises) to avoid leaking whether the email is registered."""
        user = await user_repo.get_by_email(self.db, email)
        if user is None or not user.is_active:
            return None
        token = create_password_reset_token(
            subject=str(user.id),
            current_password_hash=await user_repo.get_password_hash(self.db, user.id),
            address=user.email,
        )
        return user, token

    async def request_password_reset(self, email: str) -> None:
        """Keelstone: e-mail a reset link to ``email`` if it has an active account.

        The caller answers the same in both cases; the e-mail is sent after the request.
        """
        issued = await self.issue_password_reset_token(email)
        if issued is not None:
            user, token = issued
            await self._mail(
                "password_reset_email_failed",
                get_email_service().send_password_reset,
                to=user.email,
                name=user.full_name or user.email,
                reset_url=frontend_link("/reset-password", token),
                language=user.locale,
            )

    async def confirm_password_reset(self, token: str, new_password: str) -> User:
        payload = verify_special_token(token, expected_type="password_reset")
        if payload is None or "sub" not in payload:
            raise AuthenticationError(message="Reset link is invalid or has expired")
        try:
            user_id = UUID(str(payload["sub"]))
        except (TypeError, ValueError) as exc:
            raise AuthenticationError(
                message="Reset link is invalid or has expired"
            ) from exc

        user = await self._redeeming(user_id)

        # Single use: the token is bound to the password hash it was issued
        # against, so a link that has already been redeemed no longer matches.
        # Keelstone: and to the address it was sent to, which must still be the account's.
        if payload.get("pwe") != password_epoch(
            await user_repo.get_password_hash(self.db, user.id)
        ) or not names_current_address(payload, user):
            raise AuthenticationError(message="Reset link is invalid or has expired")

        hashed = await run_in_threadpool(get_password_hash, new_password)
        await user_repo.update(
            self.db,
            db_user=user,
            update_data=_claiming_address(user, _ending_sessions({"hashed_password": hashed})),
        )
{%- if enable_session_management and use_jwt %}
        # Revoke any active sessions so a previously-issued refresh token cannot
        # outlive a password reset. The current request returns no tokens — the
        # user must log in again.
        await session_repo.deactivate_all_user_sessions(self.db, user.id)
{%- endif %}
        return user

    async def issue_magic_link_token(self, email: str) -> tuple[User, str] | None:
        user = await user_repo.get_by_email(self.db, email)
        if user is None or not user.is_active:
            return None
        token = create_magic_link_token(
            subject=str(user.id), magic_link_epoch=user.magic_link_epoch, address=user.email
        )
        return user, token

    async def request_magic_link(self, email: str) -> None:
        """Keelstone: e-mail a sign-in link to ``email`` if it has an active account (after the
        request, as a reset link)."""
        issued = await self.issue_magic_link_token(email)
        if issued is not None:
            user, token = issued
            await self._mail(
                "magic_link_email_failed",
                get_email_service().send_magic_link,
                to=user.email,
                name=user.full_name or user.email,
                magic_url=frontend_link("/auth/magic-link", token),
                language=user.locale,
            )

    async def consume_magic_link_token(self, token: str) -> User:
        """Redeem a sign-in link exactly once.

        Caller is responsible for minting access/refresh tokens for the returned
        user. Bumping the epoch here is what makes the link single-use, so this
        must run before the caller issues any credential.
        """
        payload = verify_special_token(token, expected_type="magic_link")
        if payload is None or "sub" not in payload:
            raise AuthenticationError(message="Magic link is invalid or has expired")
        try:
            user_id = UUID(str(payload["sub"]))
        except (TypeError, ValueError) as exc:
            raise AuthenticationError(
                message="Magic link is invalid or has expired"
            ) from exc

        user = await self._redeeming(user_id)

        # Keelstone: the link must also have been sent to the address the account has now.
        if payload.get("mle") != user.magic_link_epoch or not names_current_address(payload, user):
            raise AuthenticationError(message="Magic link is invalid or has expired")

        # Invalidates this link and every other one outstanding for the user.
        await user_repo.update(
            self.db,
            db_user=user,
            update_data=_claiming_address(user, {"magic_link_epoch": user.magic_link_epoch + 1}),
        )
        return user

    async def request_email_change(self, user: User, new_email: str) -> None:
        """Keelstone: send a confirmation link to ``new_email``; the address does not change yet.

        The answer is the same whatever the address: telling that an address is taken would
        disclose the accounts of every organization. A link is sent only to an address no
        account uses (checked again when it is followed), and the address in force is told of
        every request, so a session used by someone else cannot move the account silently.
        The route has the caller prove their identity again first (``confirm_identity``).
        """
        if new_email == user.email:
            return
        # The caller's session sees the accounts of their organizations only; an address is
        # taken by any account, so it is looked up by a declared system read.
        async with system_session("email change: address in use") as system_db:
            taken = await user_repo.get_by_email(system_db, new_email) is not None
        email = get_email_service()
        # The same work whatever the address: the link is made in both cases.
        confirm_url = frontend_link("/confirm-email", create_email_change_token(user, new_email))
        if not taken:
            await self._mail(
                "email_change_email_failed",
                email.send_email_change,
                to=new_email,
                name=user.full_name or new_email,
                confirm_url=confirm_url,
                language=user.locale,
            )
        await self._mail(
            "email_change_notice_failed",
            email.send_email_change_requested,
            to=user.email,
            name=user.full_name or user.email,
            new_email=new_email,
            login_url=frontend_page("/login"),
            language=user.locale,
        )

    async def confirm_email_change(self, token: str) -> User:
        """Keelstone: make the address of a change link the account's address, once.

        The previous address is told of the change. The magic-link epoch is raised, so a sign-in
        link sent to the previous address, and every other change link issued before, is void.
        """
        payload = verify_special_token(token, expected_type="email_change") or {}
        try:
            user_id = UUID(str(payload["sub"]))
            new_email = str(payload["email"])
        except (KeyError, TypeError, ValueError) as exc:
            raise AuthenticationError(message="Confirmation link is invalid or has expired") from exc
        user = await self._redeeming(user_id)
        # Single use and bound to the session version: the address it replaces must still be
        # in force, no other change confirmed since, and a sign-out from every device voids
        # outstanding links.
        if (
            payload.get("ver") != user.token_epoch
            or payload.get("mle") != user.magic_link_epoch
            or not names_current_address(payload, user)
        ):
            raise AuthenticationError(message="Confirmation link is invalid or has expired")
        if await user_repo.get_by_email(self.db, new_email) is not None:
            raise AlreadyExistsError(message="Email already registered", details={"email": new_email})
        previous = user.email
        changed = await user_repo.update(
            self.db,
            db_user=user,
            update_data={
                "email": new_email,
                "email_verified": True,
                "magic_link_epoch": User.magic_link_epoch + 1,
            },
        )
        await self._mail(
            "email_changed_notice_failed",
            get_email_service().send_email_changed,
            to=previous,
            name=changed.full_name or previous,
            new_email=new_email,
            language=changed.locale,
        )
        return changed

    async def _redeeming(self, user_id: UUID) -> User:
        """Keelstone: the active user a link sent by e-mail is redeemed for, locked until commit.

        A link is single-use because redeeming it changes what it is bound to (the password
        hash, the magic-link epoch, the address). The row lock makes a second redemption of the
        same link, sent at the same moment, wait for the first and then find it void.
        """
        user = await user_repo.get_by_id_for_update(self.db, user_id)
        if user is None:
            raise NotFoundError(message="User not found", details={"user_id": user_id})
        if not user.is_active:
            raise AuthenticationError(message="Account is disabled")
        return user
{%- endif %}
