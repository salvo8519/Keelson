{%- if enable_rate_limiting %}
"""RateLimitRule dataclass and category definitions."""

from dataclasses import dataclass, field


@dataclass(frozen=True)
class RateLimitRule:
    """Defines limits per user, per org, and per IP for a given category."""

    per_user: int | None = None
    period_seconds: int = 60
    per_org: int | None = None
    org_period_seconds: int = 60
    per_ip: int | None = None
    ip_period_seconds: int = 60

    @classmethod
    def unlimited(cls) -> "RateLimitRule":
        return cls()

    def is_unlimited(self) -> bool:
        return self.per_user is None and self.per_org is None and self.per_ip is None

    @classmethod
    def from_dict(cls, data: dict) -> "RateLimitRule":
        return cls(
            per_user=data.get("per_user"),
            period_seconds=data.get("period_seconds", 60),
            per_org=data.get("per_org"),
            org_period_seconds=data.get("org_period_seconds", 60),
            per_ip=data.get("per_ip"),
            ip_period_seconds=data.get("ip_period_seconds", 60),
        )


class RateLimitCategory:
    AGENT_INVOCATION = "agent_invocation"
    RAG_UPLOAD = "rag_upload"
    AUTH = "auth"
    READ_API = "read_api"
    WEBHOOK = "webhook"
    API_KEY = "api_key"  # Keelstone: requests authenticated by an organization API key
    API_KEY_REFUSAL = "api_key_refusal"  # Keelstone: refused API keys, per caller IP
    # Keelstone: session refreshes, per user. They shared AUTH (per IP) with sign-in, so users
    # behind one address lost their sessions after a few failed sign-ins of anyone there.
    REFRESH = "refresh"
    # Keelstone: e-mail address change requests, per user. Each one sends e-mail to an address
    # the caller chooses and to the account's own address.
    EMAIL_CHANGE = "email_change"
    # Keelstone: attempts to prove the identity again (the current password), per user, shared
    # by every route that asks for it, so that a session cannot guess the password, and per
    # client IP. These routes used AUTH per IP as well, so behind a shared address (a company
    # network) one user's attempts locked colleagues out of signing in.
    REAUTH = "reauth"


# Default fallback limits (used when plan features don't define limits)
DEFAULT_RATE_LIMITS: dict[str, RateLimitRule] = {
    # Keelstone: applied to every chat turn (upstream defined it and never applied it), so the
    # default allows a working day of conversation; plans and deployments narrow it.
    RateLimitCategory.AGENT_INVOCATION: RateLimitRule(per_user=200, period_seconds=86400),
    RateLimitCategory.RAG_UPLOAD: RateLimitRule(per_user=5, period_seconds=86400),
    RateLimitCategory.AUTH: RateLimitRule(per_ip=5, ip_period_seconds=900),
    RateLimitCategory.READ_API: RateLimitRule(per_user=300, period_seconds=60),
    # Keelstone: per key (the "user" bucket holds the key id) and per organization.
    RateLimitCategory.API_KEY: RateLimitRule(per_user=600, period_seconds=60, per_org=3000),
    RateLimitCategory.API_KEY_REFUSAL: RateLimitRule(per_ip=20, ip_period_seconds=300),
    RateLimitCategory.REFRESH: RateLimitRule(per_user=20, period_seconds=900),
    RateLimitCategory.EMAIL_CHANGE: RateLimitRule(per_user=3, period_seconds=3600),
    RateLimitCategory.REAUTH: RateLimitRule(
        per_user=5, period_seconds=900, per_ip=20, ip_period_seconds=900
    ),
}

# Keelstone: categories whose routes are refused (503) when the storage cannot count a call,
# instead of allowed as upstream did for every category. Without a limit, these routes would
# let anyone guess passwords at full speed while Redis is down; the other categories protect
# capacity rather than credentials and keep answering.
FAIL_CLOSED_CATEGORIES: frozenset[str] = frozenset({RateLimitCategory.AUTH, RateLimitCategory.REAUTH})

{%- else %}
"""Rate limiting rules — not enabled."""
{%- endif %}
