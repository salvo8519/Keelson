}


def duration_text(duration: timedelta, language: str) -> str:
    """``duration`` as words in ``language``, in whole hours when exact, otherwise minutes."""
    minutes = int(duration.total_seconds() // 60)
    if minutes % 60 == 0:
        hours = minutes // 60
        message = N_("1 hour") if hours == 1 else N_("{count} hours")
        return gettext(message, language).format(count=hours)
    message = N_("1 minute") if minutes == 1 else N_("{count} minutes")
    return gettext(message, language).format(count=minutes)


class EmailService:
    def __init__(self, provider: EmailProvider) -> None:
        self.provider = provider

    async def send(
        self,
        *,
        key: EmailKey,
        to: str,
        context: dict[str, Any],
        force: bool = False,
        language: str | None = None,
    ) -> SendResult:
        """`force=True` skips category opt-out checks — use for critical notifications.

        Keelstone: the email is written in ``language`` (the recipient's saved preference) when
        given and supported, otherwise in the language of the current request.
        """
        subject, html, text = render_email(key.value, context, self.language(language))

        message = EmailMessage(
            to=[to],
            from_email=settings.EMAIL_FROM,
            from_name=settings.EMAIL_FROM_NAME,
            subject=subject,
            html=html,
            text=text,
            reply_to=getattr(settings, "EMAIL_REPLY_TO", None),
            tags=[_CATEGORIES[key].value, key.value],
        )

        result = await self.provider.send(message)
        if not result.accepted:
            logger.error(
                "email_not_accepted",
                extra={"key": key.value, "to": to, "error": result.error},
            )
        return result

    @staticmethod
    def language(preferred: str | None = None) -> str:
        return supported(preferred) or current_language()

    async def send_welcome(
        self, *, to: str, name: str, login_url: str, language: str | None = None
    ) -> SendResult:
        return await self.send(
            key=EmailKey.WELCOME,
            to=to,
            context={"name": name, "login_url": login_url, "app_name": "{{ project_name }}"},
            language=language,
        )

    async def send_password_reset(
        self, *, to: str, name: str, reset_url: str, language: str | None = None
    ) -> SendResult:
        expires_in = duration_text(PASSWORD_RESET_TTL, self.language(language))
        return await self.send(
            key=EmailKey.PASSWORD_RESET,
            to=to,
            context={"name": name, "reset_url": reset_url, "expires_in": expires_in, "app_name": "{{ project_name }}"},
            language=language,
        )

    async def send_account_exists(
        self, *, to: str, name: str, login_url: str, reset_url: str, language: str | None = None
    ) -> SendResult:
        """Keelstone: someone tried to register with an address that has an account."""
        return await self.send(
            key=EmailKey.ACCOUNT_EXISTS,
            to=to,
            context={
                "name": name,
                "login_url": login_url,
                "reset_url": reset_url,
                "app_name": "{{ project_name }}",
            },
            language=language,
        )

    async def send_magic_link(
        self, *, to: str, name: str, magic_url: str, language: str | None = None
    ) -> SendResult:
        """Keelstone: upstream sent the sign-in link with the welcome template."""
        expires_in = duration_text(MAGIC_LINK_TTL, self.language(language))
        return await self.send(
            key=EmailKey.MAGIC_LINK,
            to=to,
            context={"name": name, "magic_url": magic_url, "expires_in": expires_in, "app_name": "{{ project_name }}"},
            language=language,
        )

    async def send_invitation(
        self,
        *,
        to: str,
        inviter_name: str,
        org_name: str,
        accept_url: str,
        language: str | None = None,
    ) -> SendResult:
        return await self.send(
            key=EmailKey.INVITATION,
            to=to,
            context={"inviter_name": inviter_name, "org_name": org_name, "accept_url": accept_url, "app_name": "{{ project_name }}"},
            language=language,
        )

