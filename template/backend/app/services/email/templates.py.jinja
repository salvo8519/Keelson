{%- if enable_email %}
"""Template loader — reads pre-rendered HTML/text from emails/compiled/.

Keelstone: a translated template lives in emails/compiled/<language>/; when a language has no
translation of a template, the English one in emails/compiled/ is used.
"""

import re
from html import escape
from pathlib import Path

from app.services.email.exceptions import EmailTemplateError

# Keelstone: the compiled emails live in backend/emails/compiled, so they are part of the backend
# image. Upstream kept them at the project root and mounted them in Compose only, which left
# local runs and Kubernetes without emails.
_DIST_DIR = Path(__file__).parent.parent.parent.parent / "emails" / "compiled"


def template_path(key: str, ext: str, language: str | None = None) -> Path:
    """Path of the template in `language`, or of the English one when it is not translated."""
    if language:
        translated = _DIST_DIR / language / f"{key}.{ext}"
        if translated.exists():
            return translated
    return _DIST_DIR / f"{key}.{ext}"


def _load_raw(key: str, ext: str, language: str | None = None) -> str:
    path = template_path(key, ext, language)
    if not path.exists():
        raise EmailTemplateError(
            message=f"Email template '{key}.{ext}' not found",
            details={"path": str(path)},
        )
    return path.read_text(encoding="utf-8")


_PLACEHOLDER = re.compile(r"\[\[(\w+)\]\]")


def _render(template: str, context: dict, *, html: bool = False, single_line: bool = False) -> str:
    """Replace [[variable]] placeholders with context values, in one pass.

    Keelstone: values come from users (names, organization names), so they are escaped in HTML
    (upstream inserted them raw: a name could carry a link into an invitation sent from the
    service's domain), kept on one line in the subject (no header injection), and never
    expanded again (a value containing ``[[reset_url]]`` stays text).
    """

    def value(match: re.Match[str]) -> str:
        if match.group(1) not in context:
            return match.group(0)
        raw = context[match.group(1)]
        text = "" if raw is None else str(raw)
        if single_line:
            text = " ".join(text.split())
        return escape(text, quote=True) if html else text

    return _PLACEHOLDER.sub(value, template)


def render_email(key: str, context: dict, language: str | None = None) -> tuple[str, str, str]:
    """Return (subject, html, text) for the given template key, context and language."""
    html_raw = _load_raw(key, "html", language)
    text_raw = _load_raw(key, "txt", language)

    # Subject is stored in the first line of .txt as "Subject: ..."
    lines = text_raw.splitlines()
    subject_line = lines[0] if lines else ""
    subject_raw = subject_line.removeprefix("Subject:").strip() if subject_line.startswith("Subject:") else key
    text_body = "\n".join(lines[1:]).strip()

    subject = _render(subject_raw, context, single_line=True)
    html = _render(html_raw, context, html=True)
    text = _render(text_body, context)
    return subject, html, text

{%- else %}
"""Email templates — not enabled."""
{%- endif %}
