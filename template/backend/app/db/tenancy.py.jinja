def _functions(schema: str) -> list[str]:
    """Functions the policies use. SECURITY DEFINER ones run as the owner, so they read the
    membership and share tables without recursing into those tables' own policies."""
    member = (
        "SELECT EXISTS (SELECT 1 FROM organization_members m"
        f" WHERE m.organization_id = org AND m.user_id = {S}.current_user_id())"
    )
    definer = f'LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, "{schema}"'
    statements = [
        f'CREATE SCHEMA IF NOT EXISTS "{S}"',
        f"""CREATE OR REPLACE FUNCTION {S}.current_user_id() RETURNS uuid LANGUAGE sql STABLE AS
            $$ SELECT NULLIF(current_setting('{USER_SETTING}', true), '')::uuid $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.current_organization_id() RETURNS uuid LANGUAGE sql STABLE AS
            $$ SELECT NULLIF(current_setting('{ORGANIZATION_SETTING}', true), '')::uuid $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.is_service() RETURNS boolean LANGUAGE sql STABLE AS
            $$ SELECT current_setting('{PRINCIPAL_SETTING}', true) = 'service' $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.is_member(org uuid) RETURNS boolean {definer} AS
            $$ {member} $$""",
        # A user belongs to an organization through membership; an API key acts for its own.
        f"""CREATE OR REPLACE FUNCTION {S}.in_organization(org uuid) RETURNS boolean {definer} AS
            $$ SELECT org IS NOT NULL AND (
                ({S}.is_service() AND org = {S}.current_organization_id())
                OR (NOT {S}.is_service() AND EXISTS (SELECT 1 FROM organization_members m
                    WHERE m.organization_id = org AND m.user_id = {S}.current_user_id()))) $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.has_org_role(org uuid, roles text[]) RETURNS boolean {definer} AS
            $$ SELECT NOT {S}.is_service() AND EXISTS (SELECT 1 FROM organization_members m
                WHERE m.organization_id = org AND m.user_id = {S}.current_user_id()
                AND m.role::text = ANY (roles)) $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.shares_organization(other uuid) RETURNS boolean {definer} AS
            $$ SELECT EXISTS (SELECT 1 FROM organization_members mine
                JOIN organization_members theirs ON theirs.organization_id = mine.organization_id
                WHERE mine.user_id = {S}.current_user_id() AND theirs.user_id = other) $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.has_members(org uuid) RETURNS boolean {definer} AS
            $$ SELECT EXISTS (SELECT 1 FROM organization_members m WHERE m.organization_id = org) $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.created_organization(org uuid) RETURNS boolean {definer} AS
            $$ SELECT EXISTS (SELECT 1 FROM organizations o
                WHERE o.id = org AND o.created_by_user_id = {S}.current_user_id()) $$""",
{%- if enable_rag %}
        # Whether a collection belongs to a knowledge base, visible to the user or not (the
        # policies of sync sources; the knowledge bases' own policy hides the others).
        f"""CREATE OR REPLACE FUNCTION {S}.knowledge_base_collection(name text) RETURNS boolean {definer} AS
            $$ SELECT EXISTS (SELECT 1 FROM knowledge_bases k WHERE k.collection_name = name) $$""",
{%- endif %}
        # 'owner', 'edit', 'view' or NULL: how the acting user may use a conversation.
        f"""CREATE OR REPLACE FUNCTION {S}.conversation_access(conv uuid) RETURNS text {definer} AS
            $$ SELECT CASE
                WHEN c.user_id IS NOT NULL AND c.user_id = {S}.current_user_id() THEN 'owner'
                WHEN c.user_id IS NULL AND {S}.is_service()
                    AND c.organization_id = {S}.current_organization_id() THEN 'owner'
                ELSE (SELECT s.permission::text FROM conversation_shares s
                      WHERE s.conversation_id = c.id AND s.shared_with = {S}.current_user_id()
                      ORDER BY (s.permission::text = 'edit') DESC LIMIT 1)
               END
               FROM conversations c WHERE c.id = conv $$""",
    ]
    return [_resolve(statement, schema) for statement in statements]


def _resolve(statement: str, schema: str) -> str:
    return statement.replace('"@"', f'"{security_schema(schema)}"').replace(
        "@.", f'"{security_schema(schema)}".'
    )


def role_statements(schema: str = "public") -> list[str]:
    """The group role of the application login, with the privileges of the application."""
    return [
        f"""
        DO $$ BEGIN
            IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{TENANT_ROLE}') THEN
                CREATE ROLE "{TENANT_ROLE}" NOLOGIN NOBYPASSRLS;
            END IF;
        END $$
        """,
        # The owner may act as the group (tests and support sessions use SET ROLE).
        f'GRANT "{TENANT_ROLE}" TO CURRENT_USER',
        f'GRANT USAGE ON SCHEMA "{schema}" TO "{TENANT_ROLE}"',
        f'GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA "{schema}" TO "{TENANT_ROLE}"',
        # Tables are granted one by one with their policies (table_statements). A table
        # created later, by a migration or at run time (the pgvector store creates its own),
        # stays closed to the application login until a migration segregates it.
        f'ALTER DEFAULT PRIVILEGES IN SCHEMA "{schema}" '
        f'REVOKE SELECT, INSERT, UPDATE, DELETE ON TABLES FROM "{TENANT_ROLE}"',
        f'ALTER DEFAULT PRIVILEGES IN SCHEMA "{schema}" '
        f'REVOKE USAGE, SELECT ON SEQUENCES FROM "{TENANT_ROLE}"',
    ]


_ROLE_NAME = re.compile(r"[a-z_][a-z0-9_]{0,62}")


def login_statements(user: str, password: str) -> list[str]:
    """The application login: member of TENANT_ROLE, no ownership, no bypass of the policies."""
    if not _ROLE_NAME.fullmatch(user):
        raise ValueError(f"POSTGRES_APP_USER must match {_ROLE_NAME.pattern}: {user!r}")
    return [
        f"""
        DO $$ BEGIN
            IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{user}') THEN
                CREATE ROLE "{user}" LOGIN NOBYPASSRLS NOCREATEDB NOCREATEROLE;
            ELSE
                ALTER ROLE "{user}" LOGIN NOBYPASSRLS NOCREATEDB NOCREATEROLE;
            END IF;
        END $$
        """,
        password_statement(user, password),
        f'GRANT "{TENANT_ROLE}" TO "{user}"',
    ]


def password_statement(user: str, password: str) -> str:
    """The statement that sets a login's password (migrations and cmd rotate-database-passwords).

    It carries the SCRAM-SHA-256 verifier computed here, never the password: the statement text
    reaches the server's log (log_statement) and pg_stat_statements. PostgreSQL stores a
    verifier it receives as it is, and checks the password against it at sign-in.
    """
    if not _ROLE_NAME.fullmatch(user):
        raise ValueError(f"role names must match {_ROLE_NAME.pattern}: {user!r}")
    return f"ALTER ROLE \"{user}\" PASSWORD '{scram_sha256_verifier(password)}'"


# PostgreSQL's own defaults for the verifiers it computes (scram_iterations, a 16-byte salt).
SCRAM_ITERATIONS = 4096
SCRAM_SALT_BYTES = 16


def _saslprep(password: str) -> bytes:
    """The password as PostgreSQL hashes it: SASLprep (RFC 4013) as pg_saslprep applies it.

    An ASCII password is kept as it is. Any other is mapped (non-ASCII spaces to a space,
    characters "mapped to nothing" removed) and normalised (NFKC); pg_saslprep checks the
    prohibited characters, the unassigned code points and the bidirectional rules on the
    mapped string, before normalisation, and uses the raw bytes when a check fails. The
    settings and cmd rotate-database-passwords accept printable ASCII only, because asyncpg's
    own SASLprep differs from PostgreSQL's; this keeps the migration path right for any value.
    """
    raw = password.encode()
    if password.isascii():
        return raw
    mapped = "".join(
        " " if stringprep.in_table_c12(char) else "" if stringprep.in_table_b1(char) else char
        for char in password
    )
    prohibited = (
        stringprep.in_table_a1,
        stringprep.in_table_c12,
        stringprep.in_table_c21_c22,
        stringprep.in_table_c3,
        stringprep.in_table_c4,
        stringprep.in_table_c5,
        stringprep.in_table_c6,
        stringprep.in_table_c7,
        stringprep.in_table_c8,
        stringprep.in_table_c9,
    )
    if not mapped or any(check(char) for char in mapped for check in prohibited):
        return raw
    if any(stringprep.in_table_d1(char) for char in mapped) and (
        any(stringprep.in_table_d2(char) for char in mapped)
        or not (stringprep.in_table_d1(mapped[0]) and stringprep.in_table_d1(mapped[-1]))
    ):
        return raw
    prepared = unicodedata.normalize("NFKC", mapped)
    return prepared.encode() if prepared else raw


def scram_sha256_verifier(password: str, *, salt: bytes | None = None) -> str:
    """The SCRAM-SHA-256 verifier of a password (RFC 5802, RFC 7677), in PostgreSQL's format."""
    salt = salt if salt is not None else os.urandom(SCRAM_SALT_BYTES)
    salted = hashlib.pbkdf2_hmac("sha256", _saslprep(password), salt, SCRAM_ITERATIONS)
    stored_key = hashlib.sha256(hmac.digest(salted, b"Client Key", "sha256")).digest()
    server_key = hmac.digest(salted, b"Server Key", "sha256")

    def b64(data: bytes) -> str:
        return base64.b64encode(data).decode()

    return f"SCRAM-SHA-256${SCRAM_ITERATIONS}:{b64(salt)}${b64(stored_key)}:{b64(server_key)}"


def _drop_policies(table: str, schema: str) -> str:
    return f"""
        DO $$ DECLARE p record; BEGIN
            FOR p IN SELECT policyname FROM pg_policies
                     WHERE tablename = '{table}' AND schemaname = '{schema}' LOOP
                EXECUTE format('DROP POLICY %I ON %I', p.policyname, '{table}');
            END LOOP;
        END $$
        """


def table_statements(table: str, schema: str = "public") -> list[str]:
    """Row level security on ``table`` with its current policies (closed when it has none)."""
    statements = [
        f'ALTER TABLE "{table}" ENABLE ROW LEVEL SECURITY',
        f'GRANT SELECT, INSERT, UPDATE, DELETE ON "{table}" TO "{TENANT_ROLE}"',
        _drop_policies(table, schema),
    ]
    for index, policy in enumerate(POLICIES.get(table, [])):
        clause = f'CREATE POLICY {POLICY_PREFIX}{policy.command.lower()}_{index} ON "{table}" '
        clause += f'FOR {policy.command} TO "{TENANT_ROLE}"'
        if policy.using:
            clause += f" USING ({policy.using})"
        if policy.check:
            clause += f" WITH CHECK ({policy.check})"
        statements.append(_resolve(clause, schema))
    if frozen := FROZEN_COLUMNS.get(table):
        statements += _column_statements(table, frozen, schema)
    if hidden := HIDDEN_COLUMNS.get(table):
        statements += _column_statements(table, hidden, schema, privilege="SELECT")
    return statements


def _column_statements(
    table: str, excluded_columns: tuple[str, ...], schema: str, privilege: str = "UPDATE"
) -> list[str]:
    """``privilege`` on every column but the excluded ones (a table-level grant covers them all)."""
    excluded = ", ".join(f"'{column}'" for column in excluded_columns)
    return [
        f'REVOKE {privilege} ON "{table}" FROM "{TENANT_ROLE}"',
        f"""
        DO $$ DECLARE cols text; BEGIN
            SELECT string_agg(quote_ident(column_name), ', ') INTO cols
              FROM information_schema.columns
             WHERE table_schema = '{schema}' AND table_name = '{table}'
               AND column_name NOT IN ({excluded});
            EXECUTE format('GRANT {privilege} (%s) ON %I TO %I', cols, '{table}', '{TENANT_ROLE}');
        END $$
        """,
    ]


def segregation_statements(tables: set[str], schema: str = "public") -> list[str]:
    """Everything a migration applies, for the tables the database has."""
    security = security_schema(schema)
    statements = role_statements(schema) + _functions(schema)
    statements.append(f'GRANT USAGE ON SCHEMA "{security}" TO "{TENANT_ROLE}"')
    statements.append(f'GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA "{security}" TO "{TENANT_ROLE}"')
    for table in sorted(tables):
        if table in CLOSED_TABLES:
            statements.append(f'REVOKE ALL ON "{table}" FROM "{TENANT_ROLE}"')
        else:
            statements += table_statements(table, schema)
    return statements


def removal_statements(tables: set[str], schema: str = "public") -> list[str]:
    """Undo ``segregation_statements`` (migration downgrade); the roles are kept."""
    statements = []
    for table in sorted(tables - set(CLOSED_TABLES)):
        statements.append(_drop_policies(table, schema))
        statements.append(f'ALTER TABLE "{table}" DISABLE ROW LEVEL SECURITY')
        # Without its policies a table must not stay open to the application login.
        statements.append(f'REVOKE ALL ON "{table}" FROM "{TENANT_ROLE}"')
    statements.append(f'DROP SCHEMA IF EXISTS "{security_schema(schema)}" CASCADE')
    return statements


# --- Who is acting -----------------------------------------------------------------------


@dataclass(frozen=True)
class Principal:
    """The actor of a request: a user (in an active organization), or an API key (service)."""

    user_id: UUID | None = None
    organization_id: UUID | None = None
    service: bool = False


_principal: ContextVar[Principal | None] = ContextVar("keelstone_principal", default=None)


def current_principal() -> Principal | None:
    return _principal.get()


def _settings(principal: Principal | None) -> dict[str, str]:
    principal = principal or Principal()
    return {
        USER_SETTING: str(principal.user_id or ""),
        ORGANIZATION_SETTING: str(principal.organization_id or ""),
        PRINCIPAL_SETTING: "service" if principal.service else ("user" if principal.user_id else ""),
    }


def _apply(connection: Connection, principal: Principal | None) -> None:
    for name, value in _settings(principal).items():
        connection.execute(text("SELECT set_config(:name, :value, true)"), {"name": name, "value": value})


@event.listens_for(Session, "after_begin")
def _state_principal(session: Session, transaction: SessionTransaction, connection: Connection) -> None:
    """Every transaction of the application login states its principal (empty: sees nothing)."""
    if session.info.get(REQUEST_SESSION):
        _apply(connection, _principal.get())


async def _set(session: AsyncSession | None, principal: Principal) -> None:
    _principal.set(principal)
    if isinstance(session, AsyncSession) and session.info.get(REQUEST_SESSION) and session.in_transaction():
        connection = await session.connection()
        await connection.run_sync(lambda sync_connection: _apply(sync_connection, principal))


async def bind_user(session: AsyncSession | None, user_id: UUID) -> None:
    """The request acts as ``user_id`` (verified by authentication) from now on."""
    current = _principal.get()
    if current is not None and current.user_id not in (None, user_id):
        raise ValueError("request already bound to another user")
    await _set(session, replace(current or Principal(), user_id=user_id, service=False))


async def bind_organization(session: AsyncSession | None, organization_id: UUID) -> None:
    """The request's active organization (membership already checked) from now on."""
    current = _principal.get() or Principal()
    if current.organization_id not in (None, organization_id):
        raise ValueError("request already bound to another organization")
    await _set(session, replace(current, organization_id=organization_id))


async def bind_service(session: AsyncSession | None, organization_id: UUID) -> None:
    """The request acts as an API key of ``organization_id`` (a service, not a person)."""
    current = _principal.get()
    if current is not None and (current.user_id is not None or current.organization_id not in (None, organization_id)):
        raise ValueError("request already bound to another principal")
    await _set(session, Principal(organization_id=organization_id, service=True))


class PrincipalScope:
    """ASGI middleware: each request or WebSocket connection starts with no principal and
    leaves none behind, whatever task the server runs it in."""

    def __init__(self, app: ASGIApp) -> None:
        self.app = app

    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
        token = _principal.set(None)
        try:
            await self.app(scope, receive, send)
        finally:
            _principal.reset(token)


def bound_organization(session: AsyncSession | None = None) -> UUID | None:
    """The organization the current request acts in, if any."""
    principal = _principal.get()
    return principal.organization_id if principal else None
