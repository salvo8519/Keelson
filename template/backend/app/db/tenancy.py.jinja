{%- if enable_teams and use_postgresql %}
"""Segregation of users and organizations enforced by PostgreSQL (Keelson).

The application filters its queries by user and organization. The database enforces the same
rules on its own, so a query that forgets a filter, or code that never applies one, still
cannot read or write another tenant's rows.

Two logins (see docs/en/concepts/tenancy-and-api-keys.md):

* the **application login** (``POSTGRES_APP_USER``) serves requests. It is a member of
  ``TENANT_ROLE``, does not own the tables and cannot bypass row level security: every table
  has row level security enabled and, for this role, a policy per operation below. A table
  without a policy is closed to it.
* the **owner login** (``POSTGRES_USER``) runs the migrations and the explicit system work
  that has no user yet or spans tenants: sign-in and registration, lookups by token (API keys,
  invitations, shared links), workers, the command line and the platform administration. Code
  reaches it only through ``app.db.session.system_session(reason)``, which logs the reason.

Every transaction of the application login states who is acting, in transaction-local
settings written by the listener below from the request's ``Principal``: a user (and the
active organization) or an API key (the service principal of one organization). With no
principal the settings are empty and the policies return nothing: the database fails closed.

The rules (``POLICIES``) mirror the application's access model:

* personal data (conversations, slash commands, ratings, files) belongs to its user; a member's
  conversations are private to them and to whom they share them with, also from the
  organization's owners and admins (they get aggregates only, through the system session);
* organization data is visible to the organization's members, and to its API keys;
* managing API keys, members and invitations needs the owner or admin role, in the database too;
* child rows (messages, tool calls, sync logs) follow their parent;
* the audit log is append-only: the application can write it, not read it.

Policies are declared here and applied by migrations (``segregation_statements``); a change to
them ships with a migration that applies them again. ``tests/test_segregation_postgres.py``
attacks every table against a real database.
"""

from __future__ import annotations

from contextvars import ContextVar
from dataclasses import dataclass, replace
from uuid import UUID

from sqlalchemy import event, text
from sqlalchemy.engine import Connection
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.orm import Session, SessionTransaction
from starlette.types import ASGIApp, Receive, Scope, Send

from app.db.session import REQUEST_SESSION

# Group role of the application login (no login of its own). Roles are cluster-wide in
# PostgreSQL, so the names carry the project: projects sharing a server stay apart.
TENANT_ROLE = "{{ project_slug }}_tenant"
# Schema of the functions the policies use ("<schema>_security" for another schema).
SECURITY_SCHEMA = "app_security"
# Transaction-local settings describing who acts.
USER_SETTING = "app.current_user_id"
ORGANIZATION_SETTING = "app.current_organization_id"
PRINCIPAL_SETTING = "app.current_principal"
POLICY_PREFIX = "keelson_"
# Tables the application login must not touch at all.
CLOSED_TABLES = ("alembic_version",)

# Policies name the security schema "@"; table_statements writes the real one.
S = "@"
ME = f"{S}.current_user_id()"


def security_schema(schema: str) -> str:
    return SECURITY_SCHEMA if schema == "public" else f"{schema}_security"


@dataclass(frozen=True)
class Policy:
    command: str  # ALL, SELECT, INSERT, UPDATE, DELETE
    using: str | None = None
    check: str | None = None


def _all(rule: str) -> list[Policy]:
    return [Policy("ALL", using=rule, check=rule)]


def _writes(rule: str) -> list[Policy]:
    return [
        Policy("INSERT", check=rule),
        Policy("UPDATE", using=rule, check=rule),
        Policy("DELETE", using=rule),
    ]


_CONVERSATION_WRITERS = f"{S}.conversation_access(conversation_id) IN ('owner', 'edit')"
_ORG_ADMIN = f"{S}.has_org_role(organization_id, ARRAY['owner', 'admin'])"
# The rules of MemberService, in the database: an owner manages every membership; an admin
# manages members and viewers only, and grants no role above them.
_MEMBERSHIP_MANAGER = (
    f"{S}.has_org_role(organization_id, ARRAY['owner'])"
    f" OR ({S}.has_org_role(organization_id, ARRAY['admin']) AND role::text IN ('member', 'viewer'))"
)
_KB_VISIBLE = (
    f"(scope = 'personal' AND owner_user_id = {ME})"
    f" OR (scope = 'org' AND {S}.in_organization(organization_id))"
    # The application's knowledge bases are for every authenticated principal, not anyone.
    f" OR (scope = 'app' AND ({ME} IS NOT NULL OR {S}.is_service()))"
)
_KB_WRITABLE = (
    f"(scope = 'personal' AND owner_user_id = {ME})"
    f" OR (scope = 'org' AND {S}.in_organization(organization_id))"
)

# table -> policies for TENANT_ROLE. Tables in UNISOLATED_TABLES carry the reason they have
# none (closed to the application login). Tables a project does not have are skipped.
POLICIES: dict[str, list[Policy]] = {
    "users": [
        Policy("SELECT", using=f"id = {ME} OR {S}.shares_organization(id)"),
        Policy("UPDATE", using=f"id = {ME}", check=f"id = {ME}"),
    ],
    "organizations": [
        Policy("SELECT", using=f"{S}.in_organization(id) OR created_by_user_id = {ME}"),
        Policy("INSERT", check=f"created_by_user_id = {ME}"),
        Policy(
            "UPDATE",
            using=f"{S}.has_org_role(id, ARRAY['owner', 'admin'])",
            check=f"{S}.has_org_role(id, ARRAY['owner', 'admin'])",
        ),
        Policy("DELETE", using=f"{S}.has_org_role(id, ARRAY['owner'])"),
    ],
    "organization_members": [
        Policy("SELECT", using=f"user_id = {ME} OR {S}.in_organization(organization_id)"),
        # An organization's creator becomes its first owner, once: a creator removed later
        # cannot add itself back. Everyone else is added by an owner or admin, or through an
        # invitation (system session).
        Policy(
            "INSERT",
            check=f"{_MEMBERSHIP_MANAGER} OR (user_id = {ME} AND role::text = 'owner'"
            f" AND {S}.created_organization(organization_id) AND NOT {S}.has_members(organization_id))",
        ),
        Policy("UPDATE", using=_MEMBERSHIP_MANAGER, check=_MEMBERSHIP_MANAGER),
        Policy("DELETE", using=f"{_MEMBERSHIP_MANAGER} OR user_id = {ME}"),
    ],
    "invitations": _all(_ORG_ADMIN),
    "api_keys": _all(_ORG_ADMIN),
    "conversations": [
        Policy(
            "SELECT",
            using=f"user_id = {ME} OR {S}.conversation_access(id) IS NOT NULL"
            f" OR (user_id IS NULL AND {S}.is_service() AND {S}.in_organization(organization_id))",
        ),
        Policy(
            "INSERT",
            check=f"(user_id = {ME} AND (organization_id IS NULL OR {S}.in_organization(organization_id)))"
            f" OR (user_id IS NULL AND {S}.is_service() AND {S}.in_organization(organization_id))",
        ),
        Policy(
            "UPDATE",
            using=f"{S}.conversation_access(id) IN ('owner', 'edit')",
            check=f"{S}.conversation_access(id) IN ('owner', 'edit')",
        ),
        Policy("DELETE", using=f"{S}.conversation_access(id) = 'owner'"),
    ],
    "conversation_shares": [
        Policy("SELECT", using=f"shared_by = {ME} OR shared_with = {ME}"),
        Policy(
            "INSERT",
            check=f"shared_by = {ME} AND {S}.conversation_access(conversation_id) = 'owner'",
        ),
        # A share stays on a conversation its author owns: it cannot be moved to another one.
        Policy(
            "UPDATE",
            using=f"shared_by = {ME}",
            check=f"shared_by = {ME} AND {S}.conversation_access(conversation_id) = 'owner'",
        ),
        Policy("DELETE", using=f"shared_by = {ME} OR shared_with = {ME}"),
    ],
    "messages": [
        Policy("SELECT", using=f"{S}.conversation_access(conversation_id) IS NOT NULL"),
        Policy("INSERT", check=_CONVERSATION_WRITERS),
        Policy("UPDATE", using=_CONVERSATION_WRITERS, check=_CONVERSATION_WRITERS),
        Policy("DELETE", using=f"{S}.conversation_access(conversation_id) = 'owner'"),
    ],
    # Readable with the message, writable by who may write the conversation.
    "tool_calls": [
        Policy("SELECT", using="EXISTS (SELECT 1 FROM messages m WHERE m.id = message_id)"),
        *_writes(
            "EXISTS (SELECT 1 FROM messages m WHERE m.id = message_id"
            f" AND {S}.conversation_access(m.conversation_id) IN ('owner', 'edit'))"
        ),
    ],
    "message_ratings": _all(
        f"user_id = {ME} AND EXISTS (SELECT 1 FROM messages m WHERE m.id = message_id)"
    ),
    "chat_files": [
        Policy(
            "SELECT",
            using=f"user_id = {ME}"
            " OR (message_id IS NOT NULL AND EXISTS (SELECT 1 FROM messages m WHERE m.id = message_id))",
        ),
        Policy("INSERT", check=f"user_id = {ME}"),
        Policy("UPDATE", using=f"user_id = {ME}", check=f"user_id = {ME}"),
        Policy("DELETE", using=f"user_id = {ME}"),
    ],
    "user_slash_commands": _all(f"user_id = {ME}"),
    "knowledge_bases": [
        Policy("SELECT", using=_KB_VISIBLE),
        Policy("INSERT", check=_KB_WRITABLE),
        Policy("UPDATE", using=_KB_WRITABLE, check=_KB_WRITABLE),
        Policy("DELETE", using=_KB_WRITABLE),
    ],
    # Readable with a visible knowledge base, writable only with a writable one (the
    # application's knowledge bases are visible to everyone, written by the system).
    "rag_documents": [
        Policy(
            "SELECT",
            using=f"(organization_id IS NOT NULL AND {S}.in_organization(organization_id))"
            " OR (knowledge_base_id IS NOT NULL"
            " AND EXISTS (SELECT 1 FROM knowledge_bases k WHERE k.id = knowledge_base_id))",
        ),
        *_writes(
            f"(organization_id IS NOT NULL AND {S}.in_organization(organization_id))"
            " OR (knowledge_base_id IS NOT NULL AND EXISTS (SELECT 1 FROM knowledge_bases k"
            f" WHERE k.id = knowledge_base_id AND ((k.scope = 'personal' AND k.owner_user_id = {ME})"
            f" OR (k.scope = 'org' AND {S}.in_organization(k.organization_id)))))"
        ),
    ],
    "sync_sources": _all(f"organization_id IS NOT NULL AND {S}.in_organization(organization_id)"),
    "sync_logs": _all(
        "sync_source_id IS NOT NULL AND EXISTS (SELECT 1 FROM sync_sources s WHERE s.id = sync_source_id)"
    ),
    # Append-only for the application: it records, only system code reads.
    # Written, never read, by the application login: an entry names its own actor, or the
    # organization of the API key that acts. Read by the platform administration only.
    "app_admin_audit_logs": [
        Policy(
            "INSERT",
            check=f"actor_user_id = {ME}"
            f" OR ({S}.is_service() AND organization_id = {S}.current_organization_id())",
        )
    ],
}

# Tables closed to the application login (no policy), with the reason. A test fails when a
# table of the project is in neither POLICIES nor here, so a new table cannot be forgotten.
UNISOLATED_TABLES: dict[str, str] = {
    "subscription": "billing, updated by payment webhooks through the system session",
    "credit_transaction": "billing, updated by payment webhooks through the system session",
    "usage_event": "billing, written by metering through the system session",
}

# Columns the application login cannot change (column privileges: a policy sees the new row
# only, not what changed). Who owns a row, where it lives and what it grants are set when the
# row is created or by the platform administration, which uses the system session.
FROZEN_COLUMNS: dict[str, tuple[str, ...]] = {
    "users": ("role", "is_app_admin", "is_active", "oauth_provider", "oauth_id", "external_user_id"),
    "conversations": ("user_id", "organization_id", "is_demo"),
    "conversation_shares": ("shared_by",),
    "organization_members": ("organization_id", "user_id"),
}


def _functions(schema: str) -> list[str]:
    """Functions the policies use. SECURITY DEFINER ones run as the owner, so they read the
    membership and share tables without recursing into those tables' own policies."""
    member = (
        "SELECT EXISTS (SELECT 1 FROM organization_members m"
        f" WHERE m.organization_id = org AND m.user_id = {S}.current_user_id())"
    )
    definer = f'LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, "{schema}"'
    statements = [
        f'CREATE SCHEMA IF NOT EXISTS "{S}"',
        f"""CREATE OR REPLACE FUNCTION {S}.current_user_id() RETURNS uuid LANGUAGE sql STABLE AS
            $$ SELECT NULLIF(current_setting('{USER_SETTING}', true), '')::uuid $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.current_organization_id() RETURNS uuid LANGUAGE sql STABLE AS
            $$ SELECT NULLIF(current_setting('{ORGANIZATION_SETTING}', true), '')::uuid $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.is_service() RETURNS boolean LANGUAGE sql STABLE AS
            $$ SELECT current_setting('{PRINCIPAL_SETTING}', true) = 'service' $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.is_member(org uuid) RETURNS boolean {definer} AS
            $$ {member} $$""",
        # A user belongs to an organization through membership; an API key acts for its own.
        f"""CREATE OR REPLACE FUNCTION {S}.in_organization(org uuid) RETURNS boolean {definer} AS
            $$ SELECT org IS NOT NULL AND (
                ({S}.is_service() AND org = {S}.current_organization_id())
                OR (NOT {S}.is_service() AND EXISTS (SELECT 1 FROM organization_members m
                    WHERE m.organization_id = org AND m.user_id = {S}.current_user_id()))) $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.has_org_role(org uuid, roles text[]) RETURNS boolean {definer} AS
            $$ SELECT NOT {S}.is_service() AND EXISTS (SELECT 1 FROM organization_members m
                WHERE m.organization_id = org AND m.user_id = {S}.current_user_id()
                AND m.role::text = ANY (roles)) $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.shares_organization(other uuid) RETURNS boolean {definer} AS
            $$ SELECT EXISTS (SELECT 1 FROM organization_members mine
                JOIN organization_members theirs ON theirs.organization_id = mine.organization_id
                WHERE mine.user_id = {S}.current_user_id() AND theirs.user_id = other) $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.has_members(org uuid) RETURNS boolean {definer} AS
            $$ SELECT EXISTS (SELECT 1 FROM organization_members m WHERE m.organization_id = org) $$""",
        f"""CREATE OR REPLACE FUNCTION {S}.created_organization(org uuid) RETURNS boolean {definer} AS
            $$ SELECT EXISTS (SELECT 1 FROM organizations o
                WHERE o.id = org AND o.created_by_user_id = {S}.current_user_id()) $$""",
        # 'owner', 'edit', 'view' or NULL: how the acting user may use a conversation.
        f"""CREATE OR REPLACE FUNCTION {S}.conversation_access(conv uuid) RETURNS text {definer} AS
            $$ SELECT CASE
                WHEN c.user_id IS NOT NULL AND c.user_id = {S}.current_user_id() THEN 'owner'
                WHEN c.user_id IS NULL AND {S}.is_service()
                    AND c.organization_id = {S}.current_organization_id() THEN 'owner'
                ELSE (SELECT s.permission::text FROM conversation_shares s
                      WHERE s.conversation_id = c.id AND s.shared_with = {S}.current_user_id()
                      ORDER BY (s.permission::text = 'edit') DESC LIMIT 1)
               END
               FROM conversations c WHERE c.id = conv $$""",
    ]
    return [_resolve(statement, schema) for statement in statements]


def _resolve(statement: str, schema: str) -> str:
    return statement.replace('"@"', f'"{security_schema(schema)}"').replace(
        "@.", f'"{security_schema(schema)}".'
    )


def role_statements(schema: str = "public") -> list[str]:
    """The group role of the application login, with the privileges of the application."""
    return [
        f"""
        DO $$ BEGIN
            IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{TENANT_ROLE}') THEN
                CREATE ROLE "{TENANT_ROLE}" NOLOGIN NOBYPASSRLS;
            END IF;
        END $$
        """,
        # The owner may act as the group (tests and support sessions use SET ROLE).
        f'GRANT "{TENANT_ROLE}" TO CURRENT_USER',
        f'GRANT USAGE ON SCHEMA "{schema}" TO "{TENANT_ROLE}"',
        f'GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA "{schema}" TO "{TENANT_ROLE}"',
        # Tables are granted one by one with their policies (table_statements). A table
        # created later, by a migration or at run time (the pgvector store creates its own),
        # stays closed to the application login until a migration segregates it.
        f'ALTER DEFAULT PRIVILEGES IN SCHEMA "{schema}" '
        f'REVOKE SELECT, INSERT, UPDATE, DELETE ON TABLES FROM "{TENANT_ROLE}"',
        f'ALTER DEFAULT PRIVILEGES IN SCHEMA "{schema}" '
        f'REVOKE USAGE, SELECT ON SEQUENCES FROM "{TENANT_ROLE}"',
    ]


def login_statements(user: str, password: str) -> list[str]:
    """The application login: member of TENANT_ROLE, no ownership, no bypass of the policies."""
    secret = password.replace("'", "''")
    return [
        f"""
        DO $$ BEGIN
            IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{user}') THEN
                CREATE ROLE "{user}" LOGIN NOBYPASSRLS NOCREATEDB NOCREATEROLE PASSWORD '{secret}';
            ELSE
                ALTER ROLE "{user}" LOGIN NOBYPASSRLS NOCREATEDB NOCREATEROLE PASSWORD '{secret}';
            END IF;
        END $$
        """,
        f'GRANT "{TENANT_ROLE}" TO "{user}"',
    ]


def _drop_policies(table: str, schema: str) -> str:
    return f"""
        DO $$ DECLARE p record; BEGIN
            FOR p IN SELECT policyname FROM pg_policies
                     WHERE tablename = '{table}' AND schemaname = '{schema}' LOOP
                EXECUTE format('DROP POLICY %I ON %I', p.policyname, '{table}');
            END LOOP;
        END $$
        """


def table_statements(table: str, schema: str = "public") -> list[str]:
    """Row level security on ``table`` with its current policies (closed when it has none)."""
    statements = [
        f'ALTER TABLE "{table}" ENABLE ROW LEVEL SECURITY',
        f'GRANT SELECT, INSERT, UPDATE, DELETE ON "{table}" TO "{TENANT_ROLE}"',
        _drop_policies(table, schema),
    ]
    for index, policy in enumerate(POLICIES.get(table, [])):
        clause = f'CREATE POLICY {POLICY_PREFIX}{policy.command.lower()}_{index} ON "{table}" '
        clause += f'FOR {policy.command} TO "{TENANT_ROLE}"'
        if policy.using:
            clause += f" USING ({policy.using})"
        if policy.check:
            clause += f" WITH CHECK ({policy.check})"
        statements.append(_resolve(clause, schema))
    if frozen := FROZEN_COLUMNS.get(table):
        statements += _column_statements(table, frozen, schema)
    return statements


def _column_statements(table: str, frozen: tuple[str, ...], schema: str) -> list[str]:
    """UPDATE on every column but the frozen ones (a table-level grant covers them all)."""
    excluded = ", ".join(f"'{column}'" for column in frozen)
    return [
        f'REVOKE UPDATE ON "{table}" FROM "{TENANT_ROLE}"',
        f"""
        DO $$ DECLARE cols text; BEGIN
            SELECT string_agg(quote_ident(column_name), ', ') INTO cols
              FROM information_schema.columns
             WHERE table_schema = '{schema}' AND table_name = '{table}'
               AND column_name NOT IN ({excluded});
            EXECUTE format('GRANT UPDATE (%s) ON %I TO %I', cols, '{table}', '{TENANT_ROLE}');
        END $$
        """,
    ]


def segregation_statements(tables: set[str], schema: str = "public") -> list[str]:
    """Everything a migration applies, for the tables the database has."""
    security = security_schema(schema)
    statements = role_statements(schema) + _functions(schema)
    statements.append(f'GRANT USAGE ON SCHEMA "{security}" TO "{TENANT_ROLE}"')
    statements.append(f'GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA "{security}" TO "{TENANT_ROLE}"')
    for table in sorted(tables):
        if table in CLOSED_TABLES:
            statements.append(f'REVOKE ALL ON "{table}" FROM "{TENANT_ROLE}"')
        else:
            statements += table_statements(table, schema)
    return statements


def removal_statements(tables: set[str], schema: str = "public") -> list[str]:
    """Undo ``segregation_statements`` (migration downgrade); the roles are kept."""
    statements = []
    for table in sorted(tables - set(CLOSED_TABLES)):
        statements.append(_drop_policies(table, schema))
        statements.append(f'ALTER TABLE "{table}" DISABLE ROW LEVEL SECURITY')
        # Without its policies a table must not stay open to the application login.
        statements.append(f'REVOKE ALL ON "{table}" FROM "{TENANT_ROLE}"')
    statements.append(f'DROP SCHEMA IF EXISTS "{security_schema(schema)}" CASCADE')
    return statements


# --- Who is acting -----------------------------------------------------------------------


@dataclass(frozen=True)
class Principal:
    """The actor of a request: a user (in an active organization), or an API key (service)."""

    user_id: UUID | None = None
    organization_id: UUID | None = None
    service: bool = False


_principal: ContextVar[Principal | None] = ContextVar("keelson_principal", default=None)


def current_principal() -> Principal | None:
    return _principal.get()


def _settings(principal: Principal | None) -> dict[str, str]:
    principal = principal or Principal()
    return {
        USER_SETTING: str(principal.user_id or ""),
        ORGANIZATION_SETTING: str(principal.organization_id or ""),
        PRINCIPAL_SETTING: "service" if principal.service else ("user" if principal.user_id else ""),
    }


def _apply(connection: Connection, principal: Principal | None) -> None:
    for name, value in _settings(principal).items():
        connection.execute(text("SELECT set_config(:name, :value, true)"), {"name": name, "value": value})


@event.listens_for(Session, "after_begin")
def _state_principal(session: Session, transaction: SessionTransaction, connection: Connection) -> None:
    """Every transaction of the application login states its principal (empty: sees nothing)."""
    if session.info.get(REQUEST_SESSION):
        _apply(connection, _principal.get())


async def _set(session: AsyncSession | None, principal: Principal) -> None:
    _principal.set(principal)
    if isinstance(session, AsyncSession) and session.info.get(REQUEST_SESSION) and session.in_transaction():
        connection = await session.connection()
        await connection.run_sync(lambda sync_connection: _apply(sync_connection, principal))


async def bind_user(session: AsyncSession | None, user_id: UUID) -> None:
    """The request acts as ``user_id`` (verified by authentication) from now on."""
    current = _principal.get()
    if current is not None and current.user_id not in (None, user_id):
        raise ValueError("request already bound to another user")
    await _set(session, replace(current or Principal(), user_id=user_id, service=False))


async def bind_organization(session: AsyncSession | None, organization_id: UUID) -> None:
    """The request's active organization (membership already checked) from now on."""
    current = _principal.get() or Principal()
    if current.organization_id not in (None, organization_id):
        raise ValueError("request already bound to another organization")
    await _set(session, replace(current, organization_id=organization_id))


async def bind_service(session: AsyncSession | None, organization_id: UUID) -> None:
    """The request acts as an API key of ``organization_id`` (a service, not a person)."""
    current = _principal.get()
    if current is not None and (current.user_id is not None or current.organization_id not in (None, organization_id)):
        raise ValueError("request already bound to another principal")
    await _set(session, Principal(organization_id=organization_id, service=True))


class PrincipalScope:
    """ASGI middleware: each request or WebSocket connection starts with no principal and
    leaves none behind, whatever task the server runs it in."""

    def __init__(self, app: ASGIApp) -> None:
        self.app = app

    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
        token = _principal.set(None)
        try:
            await self.app(scope, receive, send)
        finally:
            _principal.reset(token)


def bound_organization(session: AsyncSession | None = None) -> UUID | None:
    """The organization the current request acts in, if any."""
    principal = _principal.get()
    return principal.organization_id if principal else None
