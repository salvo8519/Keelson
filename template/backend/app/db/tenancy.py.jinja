# Group role of the application login (no login of its own). Roles are cluster-wide in
# PostgreSQL, so the names carry the project: projects sharing a server stay apart.
TENANT_ROLE = "{{ project_slug }}_tenant"
# Schema of the functions the policies use ("<schema>_security" for another schema).
SECURITY_SCHEMA = "app_security"
# Transaction-local settings describing who acts.
USER_SETTING = "app.current_user_id"
ORGANIZATION_SETTING = "app.current_organization_id"
PRINCIPAL_SETTING = "app.current_principal"
POLICY_PREFIX = "keelstone_"
# Tables the application login must not touch at all.
CLOSED_TABLES = ("alembic_version",)

# Policies name the security schema "@"; table_statements writes the real one.
S = "@"
ME = f"{S}.current_user_id()"


def security_schema(schema: str) -> str:
    return SECURITY_SCHEMA if schema == "public" else f"{schema}_security"


@dataclass(frozen=True)
class Policy:
    command: str  # ALL, SELECT, INSERT, UPDATE, DELETE
    using: str | None = None
    check: str | None = None


def _all(rule: str) -> list[Policy]:
    return [Policy("ALL", using=rule, check=rule)]


def _writes(rule: str) -> list[Policy]:
    return [
        Policy("INSERT", check=rule),
        Policy("UPDATE", using=rule, check=rule),
        Policy("DELETE", using=rule),
    ]


_CONVERSATION_WRITERS = f"{S}.conversation_access(conversation_id) IN ('owner', 'edit')"
_ORG_ADMIN = f"{S}.has_org_role(organization_id, ARRAY['owner', 'admin'])"
# The rules of MemberService, in the database: an owner manages every membership; an admin
# manages members and viewers only, and grants no role above them.
_MEMBERSHIP_MANAGER = (
    f"{S}.has_org_role(organization_id, ARRAY['owner'])"
    f" OR ({S}.has_org_role(organization_id, ARRAY['admin']) AND role::text IN ('member', 'viewer'))"
)
_OBJECT_OWNER = (
    f"(organization_id IS NULL AND user_id = {ME})"
    f" OR (organization_id IS NOT NULL AND {S}.in_organization(organization_id))"
)
_OBJECT_KEY = (
    f"storage_key = CASE WHEN organization_id IS NOT NULL"
    f" THEN '{ORGANIZATION_PREFIX}/' || organization_id || '/' || id"
    f" ELSE '{USER_PREFIX}/' || user_id || '/' || id END"
)
_KB_VISIBLE = (
    f"(scope = 'personal' AND owner_user_id = {ME})"
    f" OR (scope = 'org' AND {S}.in_organization(organization_id))"
    # The application's knowledge bases are for every authenticated principal, not anyone.
    f" OR (scope = 'app' AND ({ME} IS NOT NULL OR {S}.is_service()))"
)
_WRITER_ROLES = "ARRAY[" + ", ".join(f"'{role}'" for role in ORG_WRITER_ROLES) + "]"


def _org_writer(column: str) -> str:
    """The acting user may change the content of organization ``column`` (viewers read only)."""
    return f"{S}.has_org_role({column}, {_WRITER_ROLES})"


def _kb_writable(alias: str = "") -> str:
    """The acting user may change the knowledge base (``alias``: its table alias with a dot).

    The application's knowledge bases are written by the platform administration only, through
    the system session: no rule here opens them to the application login.
    """
    return (
        f"({alias}scope = 'personal' AND {alias}owner_user_id = {ME})"
        f" OR ({alias}scope = 'org' AND {_org_writer(alias + 'organization_id')})"
    )


_KB_WRITABLE = _kb_writable()
# Content of a knowledge base follows the knowledge base, not the organization stored on the
# row: an upload into a personal knowledge base carries the active organization, and the other
# members of that organization must not read it. Content outside any knowledge base follows
# its organization.
_DOCUMENT_VISIBLE = (
    f"CASE WHEN knowledge_base_id IS NULL"
    f" THEN organization_id IS NOT NULL AND {S}.in_organization(organization_id)"
    " ELSE EXISTS (SELECT 1 FROM knowledge_bases k WHERE k.id = knowledge_base_id) END"
)
# A document is written with its knowledge base, in that knowledge base's collection (the
# vectors a delete removes), and never carries another organization.
_DOCUMENT_WRITABLE = (
    "(organization_id IS NULL OR {in_org})"
    " AND CASE WHEN knowledge_base_id IS NULL"
    " THEN organization_id IS NOT NULL AND {writer}"
    " ELSE EXISTS (SELECT 1 FROM knowledge_bases k WHERE k.id = knowledge_base_id"
    " AND k.collection_name = rag_documents.collection_name AND ({kb}))"
    " END"
).format(
    in_org=f"{S}.in_organization(organization_id)",
    writer=_org_writer("organization_id"),
    kb=_kb_writable("k."),
)


def _source_knowledge_base(rule: str) -> str:
    """A sync source feeding the collection of a knowledge base follows that knowledge base
    (``rule`` on alias ``k``); a source of another collection, or of none, its organization."""
    return (
        f"(collection_name IS NULL OR NOT {S}.knowledge_base_collection(collection_name)"
        " OR EXISTS (SELECT 1 FROM knowledge_bases k"
        f" WHERE k.collection_name = sync_sources.collection_name AND ({rule})))"
    )


_SYNC_SOURCE_VISIBLE = (
    f"organization_id IS NOT NULL AND {S}.in_organization(organization_id)"
    f" AND {_source_knowledge_base('true')}"
)
_SYNC_SOURCE_WRITABLE = (
    f"organization_id IS NOT NULL AND {_org_writer('organization_id')}"
    f" AND {_source_knowledge_base(_kb_writable('k.'))}"
)

