{%- if use_delegated_auth %}
"""Authentication routes.

Delegated auth mode: identity is owned by the external IdP, so this module
exposes **only** ``/me``. Local email/password endpoints (login, register,
refresh, logout, password reset, magic link) are deliberately absent — see
``get_current_user`` in ``app/api/deps.py``, which validates IdP signatures and
would reject any token this backend minted. Leaving them mounted would also
mean an unauthenticated caller could create a local account, and the first such
account is auto-promoted to app-admin.
"""
{%- else %}
"""Authentication routes."""
{%- endif %}

import logging
{%- if use_delegated_auth %}
from typing import Any
{%- else %}
from typing import Annotated, Any
{%- endif %}

from fastapi import APIRouter{% if not use_delegated_auth %}, Depends, Request, Response, status{% endif %}
{%- if not use_delegated_auth %}
from fastapi.security import OAuth2PasswordRequestForm
{%- endif %}

{%- if enable_session_management %}
from app.api.deps import AuthUserSvc, CurrentUser, Redis, SessionSvc, UserSvc
{%- elif not use_delegated_auth %}
from app.api.deps import AuthUserSvc, CurrentUser, Redis, UserSvc
{%- else %}
from app.api.deps import CurrentUser
{%- endif %}
{%- if enable_email and not use_delegated_auth %}
from app.core.config import settings
{%- endif %}
{%- if not use_delegated_auth %}
from app.core.exceptions import AuthenticationError, NotFoundError
from app.core.revoked_tokens import is_revoked, revoke
from app.core.security import REFRESH, SessionClaims, issue_session_tokens, read_session_token
{%- endif %}
{%- if enable_email and not use_delegated_auth %}
from app.services.email.service import get_email_service
from app.schemas.password_reset import (
    MagicLinkRequest,
    MagicLinkVerifyRequest,
    PasswordResetConfirm,
    PasswordResetConfirmResponse,
    PasswordResetRequest,
    PasswordResetResponse,
)
{%- endif %}
{%- if not use_delegated_auth %}
from app.core.session_cookies import (
    REFRESH_COOKIE,
    clear_session_cookies,
    refuse_foreign_origin,
    require_trusted_origin,
    set_session_cookies,
)
from app.db.models.user import User
from app.schemas.token import RefreshTokenRequest, Token
from app.schemas.user import RegistrationAccepted, UserRead, UserRegister
from app.services.user import UserService
{%- else %}
from app.schemas.user import UserRead
{%- endif %}
{%- if enable_rate_limiting and not use_delegated_auth %}
from app.services.rate_limit import (
    RateLimitCategory,
    check_rate_limit,
    client_ip,
    make_anonymous_rate_limit_dep,
)

# Unauthenticated endpoints: the only scope available is the caller's IP, and
# these are exactly the routes that need one (credential stuffing, reset-email
# flooding). Default rule: 5 requests per 15 minutes per IP.
AuthRateLimit = make_anonymous_rate_limit_dep(RateLimitCategory.AUTH)
{%- endif %}

logger = logging.getLogger(__name__)

router = APIRouter()

{%- if not use_delegated_auth %}

INVALID_REFRESH = "Invalid or expired refresh token"


@router.post(
    "/login",
    response_model=Token,
{%- if enable_rate_limiting %}
    dependencies=[AuthRateLimit],
{%- endif %}
)
async def login(
    request: Request,
    response: Response,
    form_data: Annotated[OAuth2PasswordRequestForm, Depends()],
    user_service: AuthUserSvc,
{%- if enable_session_management %}
    session_service: SessionSvc,
{%- endif %}
) -> Any:
    """OAuth2 password login, returns access and refresh tokens."""
    # Keelson: a page of another site must not sign the browser into an account of its
    # choice (login CSRF). Programs send no Origin and no Referer and are accepted.
    refuse_foreign_origin(request)
    user = await user_service.authenticate(form_data.username, form_data.password)
    access_token, refresh_token = issue_session_tokens(user)
{%- if enable_session_management %}

    # Track this login as a server-side session (enables remote logout).
    await session_service.create_session(
        user_id=user.id,
        refresh_token=refresh_token,
        ip_address=request.client.host if request.client else None,
        user_agent=request.headers.get("User-Agent"),
    )
{%- endif %}
    # Keelson: browsers keep the session in HttpOnly cookies (app/core/session_cookies.py);
    # programs read the tokens from the body, as OAuth2 password clients expect.
    set_session_cookies(response, access_token, refresh_token)
    return Token(access_token=access_token, refresh_token=refresh_token)


@router.post(
    "/register",
    response_model=RegistrationAccepted,
    status_code=status.HTTP_202_ACCEPTED,
{%- if enable_rate_limiting %}
    dependencies=[AuthRateLimit],
{%- endif %}
)
async def register(
    user_in: UserRegister,
    user_service: AuthUserSvc,
) -> Any:
    """Register a new user.

    The answer is the same whether or not the address already has an account; its owner is
    told by e-mail.
    """
    await user_service.register(user_in)
    return RegistrationAccepted()


async def _refreshing_user(
    request: Request, token: str | None, user_service: UserService, redis: Redis
) -> tuple[User, SessionClaims]:
    """Keelson: the user of a refresh token (body or cookie) that is still in force.

    A refresh token is refused when it is invalid, of an earlier session version (password
    change, sign-out from every device), signed out (app/core/revoked_tokens.py), or when
    its user is gone or disabled. Refreshes are limited per user; invalid tokens count
    against the per-IP limit of the sign-in routes.
    """
    claims = read_session_token(token, REFRESH)
{%- if enable_rate_limiting %}
    if claims is None:
        await check_rate_limit(category=RateLimitCategory.AUTH, client_ip=client_ip(request))
    else:
        await check_rate_limit(
            category=RateLimitCategory.REFRESH,
            client_ip=client_ip(request),
            user_id=str(claims.user_id),
        )
{%- endif %}
    if claims is None:
        raise AuthenticationError(message=INVALID_REFRESH)
    try:
        user = await user_service.get_by_id(claims.user_id)
    except NotFoundError:
        raise AuthenticationError(message=INVALID_REFRESH) from None
    if not user.is_active:
        raise AuthenticationError(message="User account is disabled")
    if not claims.is_current_for(user) or await is_revoked(redis, claims):
        raise AuthenticationError(message=INVALID_REFRESH)
    return user, claims


@router.post("/refresh", response_model=Token)
async def refresh_token(
    request: Request,
    body: RefreshTokenRequest,
    user_service: AuthUserSvc,
    redis: Redis,
{%- if enable_session_management %}
    session_service: SessionSvc,
{%- endif %}
) -> Any:
    """Exchange a refresh token for a new access token."""
{%- if enable_session_management %}
    session = await session_service.validate_refresh_token(body.refresh_token)
    if not session:
        raise AuthenticationError(message=INVALID_REFRESH)
{%- endif %}
    user, _ = await _refreshing_user(request, body.refresh_token, user_service, redis)
    access_token, new_refresh_token = issue_session_tokens(user)
{%- if enable_session_management %}

    await session_service.logout_by_refresh_token(body.refresh_token)
    await session_service.create_session(
        user_id=user.id,
        refresh_token=new_refresh_token,
        ip_address=request.client.host if request.client else None,
        user_agent=request.headers.get("User-Agent"),
    )
{%- endif %}
    return Token(access_token=access_token, refresh_token=new_refresh_token)


async def _end_refresh(token: str | None, redis: Redis) -> None:
    """Sign out the session of a refresh token, if it is one (no answer tells either way)."""
    claims = read_session_token(token, REFRESH)
    if claims is not None:
        await revoke(redis, claims)


@router.post("/logout", status_code=status.HTTP_204_NO_CONTENT, response_model=None)
async def logout(
    body: RefreshTokenRequest,
    redis: Redis,
{%- if enable_session_management %}
    session_service: SessionSvc,
{%- endif %}
) -> None:
    """Sign out: the refresh token can no longer be exchanged.

    \f
    Keelson: upstream did nothing without session tracking, so the token kept working for
    its whole lifetime.
    """
{%- if enable_session_management %}
    await session_service.logout_by_refresh_token(body.refresh_token)
{%- endif %}
    await _end_refresh(body.refresh_token, redis)


@router.post("/logout-all", status_code=status.HTTP_204_NO_CONTENT, response_model=None)
async def logout_everywhere(
    response: Response,
    current_user: CurrentUser,
    user_service: UserSvc,
) -> None:
    """Sign out of every device: every access and refresh token issued so far stops working."""
    await user_service.end_all_sessions(current_user)
    clear_session_cookies(response)
{%- if not enable_session_management %}


@router.post("/session/refresh", status_code=status.HTTP_204_NO_CONTENT, response_model=None)
async def refresh_session(
    request: Request, response: Response, user_service: AuthUserSvc, redis: Redis
) -> None:
    """Browsers: renew the session from the refresh cookie.

    The new tokens are set as HttpOnly cookies and never returned in the body, so a script in
    the page cannot obtain them.
    """
    require_trusted_origin(request)
    user, _ = await _refreshing_user(request, request.cookies.get(REFRESH_COOKIE), user_service, redis)
    set_session_cookies(response, *issue_session_tokens(user))


@router.post("/session/logout", status_code=status.HTTP_204_NO_CONTENT, response_model=None)
async def end_session(request: Request, response: Response, redis: Redis) -> None:
    """Browsers: sign out. The refresh cookie's session ends and the cookies are removed."""
    refuse_foreign_origin(request)
    await _end_refresh(request.cookies.get(REFRESH_COOKIE), redis)
    clear_session_cookies(response)
{%- endif %}
{%- endif %}


@router.get("/me", response_model=UserRead)
async def get_current_user_info(current_user: CurrentUser) -> Any:
    """Get current authenticated user information."""
    return current_user

{%- if enable_email and not use_delegated_auth %}



@router.post(
    "/password-reset/request",
    response_model=PasswordResetResponse,
{%- if enable_rate_limiting %}
    dependencies=[AuthRateLimit],
{%- endif %}
)
async def request_password_reset(
    body: PasswordResetRequest,
    user_service: AuthUserSvc,
) -> Any:
    """Email a single-use reset link to the address.

    Always returns 200 with the same body — we don't disclose whether the
    email is in our system. The caller (email service) is best-effort.
    """
    issued = await user_service.issue_password_reset_token(body.email)
    if issued is not None:
        reset_user, token = issued
        try:
            reset_url = f"{settings.FRONTEND_URL.rstrip('/')}/reset-password?token={token}"
            await get_email_service().send_password_reset(
                to=body.email,
                name=reset_user.full_name or body.email,
                reset_url=reset_url,
                language=reset_user.locale,
            )
        except Exception:
            logger.exception("password_reset_email_failed", extra={"email": body.email})
    return PasswordResetResponse()


@router.post("/password-reset/confirm", response_model=PasswordResetConfirmResponse)
async def confirm_password_reset(
    body: PasswordResetConfirm,
    user_service: AuthUserSvc,
) -> Any:
    """Set a new password using a token from the reset email."""
    await user_service.confirm_password_reset(body.token, body.new_password)
    return PasswordResetConfirmResponse()



@router.post(
    "/magic-link/request",
    response_model=PasswordResetResponse,
{%- if enable_rate_limiting %}
    dependencies=[AuthRateLimit],
{%- endif %}
)
async def request_magic_link(
    body: MagicLinkRequest,
    user_service: AuthUserSvc,
) -> Any:
    """Email a single-use sign-in link.

    Symmetric response to request_password_reset to avoid email enumeration.
    """
    issued = await user_service.issue_magic_link_token(body.email)
    if issued is not None:
        link_user, token = issued
        try:
            login_url = f"{settings.FRONTEND_URL.rstrip('/')}/auth/magic-link?token={token}"
            await get_email_service().send_magic_link(
                to=body.email,
                name=link_user.full_name or body.email,
                magic_url=login_url,
                language=link_user.locale,
            )
        except Exception:
            logger.exception("magic_link_email_failed", extra={"email": body.email})
    return PasswordResetResponse(message="Check your email for a sign-in link.")


@router.post("/magic-link/verify", response_model=Token)
async def verify_magic_link(
    request: Request,
    body: MagicLinkVerifyRequest,
    user_service: AuthUserSvc,
{%- if enable_session_management %}
    session_service: SessionSvc,
{%- endif %}
) -> Any:
    """Exchange a magic-link token for an access + refresh token pair."""
    user = await user_service.consume_magic_link_token(body.token)
    access_token, refresh_token = issue_session_tokens(user)
{%- if enable_session_management %}
    await session_service.create_session(
        user_id=user.id,
        refresh_token=refresh_token,
        ip_address=request.client.host if request.client else None,
        user_agent=request.headers.get("User-Agent"),
    )
{%- endif %}
    return Token(access_token=access_token, refresh_token=refresh_token)
{%- endif %}
