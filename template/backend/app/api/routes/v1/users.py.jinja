{%- if use_jwt %}
# ruff: noqa: I001 - Imports structured for Jinja2 template conditionals
"""User management routes."""

from typing import Any

from uuid import UUID

from fastapi import APIRouter, File, Query, Request, Response, UploadFile, status
{%- if enable_pagination %}
from fastapi_pagination import Page
{%- endif %}

from app.api.deps import (
    AdminUserSvc,
    CurrentAdmin,
    CurrentUser,
    UserSvc,
)
from app.core.exceptions import BadRequestError, NotFoundError
from app.core.security import issue_session_tokens
from app.core.session_cookies import ACCESS_COOKIE, set_session_cookies
from app.core.user_content import avatar_response
from app.db.models.user import UserRole
from app.schemas.user import (
    AccountDeletion,
    UpdatePassword,
    UserCreate,
    UserMe,
    UserRead,
    UserUpdate,
    UserUpdateMe,
)
{%- if enable_email %}
from app.schemas.user import EmailChangeAccepted, EmailChangeRequest
{%- endif %}
{%- if enable_rate_limiting %}
from app.services.rate_limit import RateLimitCategory, make_user_rate_limit_dep

# Keelstone: the routes that ask the caller to prove their identity again count every attempt
# against one budget per user shared by all of them, so that a session cannot guess the password
# on one route after exhausting another, and per client IP (category ``reauth``). They do not
# use the sign-in limit (``auth``): behind a shared address, one user's attempts would lock
# colleagues out of signing in. While the limiter cannot count, they answer 503.
ReauthLimit = make_user_rate_limit_dep(RateLimitCategory.REAUTH)
{%- if enable_email %}
# A change request also sends e-mail to an address the caller chooses: limited per user too.
EmailChangeUserLimit = make_user_rate_limit_dep(RateLimitCategory.EMAIL_CHANGE)
{%- endif %}
{%- endif %}

router = APIRouter()


@router.get("/me", response_model=UserMe)
async def read_current_user(
    current_user: CurrentUser,
    user_service: UserSvc,
) -> Any:
    """Get current user profile.

    \f
    Keelstone: ``has_password`` tells the profile form whether a change of address asks for the
    current password or for a recent sign-in.
    """
    return await user_service.read_me(current_user)


@router.patch("/me", response_model=UserRead)
async def update_current_user(
    user_in: UserUpdateMe,
    current_user: CurrentUser,
    user_service: UserSvc,
) -> Any:
    """Update current user profile.

    \f
    Keelstone: only profile fields. Upstream accepted ``UserUpdate`` here, so a user could set a
    new password without the current one, change their own account status and move the
    account onto an address they do not control (``POST /users/me/email`` confirms it first).
    """
    return await user_service.update_me(current_user, user_in)


{%- if enable_email %}


@router.post(
    "/me/email",
    response_model=EmailChangeAccepted,
    status_code=status.HTTP_202_ACCEPTED,
{%- if enable_rate_limiting %}
    dependencies=[ReauthLimit, EmailChangeUserLimit],
{%- endif %}
)
async def request_email_change(
    request: Request,
    body: EmailChangeRequest,
    current_user: CurrentUser,
    user_service: UserSvc,
) -> Any:
    """Change the current user's e-mail address: a confirmation link is sent to the new one.

    The address changes when the link is followed (``POST /auth/email/confirm``). The answer
    is the same for every address, so it does not tell whether an address has an account; the
    current address is told of the request.

    The current password is required when the account has one (400 when it is missing or
    wrong); an account without a password needs a sign-in within the last 5 minutes (403 with
    the reason ``recent_sign_in_required`` otherwise: sign in again).
    """
    claims = getattr(request.state, "session_claims", None)
    await user_service.confirm_identity(
        current_user, body.current_password, claims.signed_in_at if claims else None
    )
    await user_service.request_email_change(current_user, body.email)
    return EmailChangeAccepted()
{%- endif %}


@router.patch(
    "/me/password",
    status_code=status.HTTP_204_NO_CONTENT,
    response_model=None,
{%- if enable_rate_limiting %}
    dependencies=[ReauthLimit],
{%- endif %}
)
async def update_current_user_password(
    request: Request,
    response: Response,
    body: UpdatePassword,
    current_user: CurrentUser,
    user_service: UserSvc,
) -> None:
    """Change the current user's password; the current password is required.

    Every session of the user ends, the other devices included. A browser that made the
    change keeps its own session: it receives new session cookies.
    """
    await user_service.change_password(current_user, body.current_password, body.new_password)
    # Keelstone: the browser session (cookie, no bearer token) is renewed in the new version.
    if request.cookies.get(ACCESS_COOKIE) and "authorization" not in request.headers:
        set_session_cookies(response, *issue_session_tokens(current_user))


@router.delete(
    "/me",
    status_code=status.HTTP_204_NO_CONTENT,
    response_model=None,
{%- if enable_rate_limiting %}
    dependencies=[ReauthLimit],
{%- endif %}
)
async def delete_current_user(
    request: Request,
    current_user: CurrentUser,
    user_service: UserSvc,
    body: AccountDeletion | None = None,
) -> None:
    """Delete the current user's account. Administrators cannot delete themselves.

    The current password is required when the account has one (400 when it is missing or
    wrong); an account without a password needs a sign-in within the last 5 minutes (403 with
    the reason ``recent_sign_in_required`` otherwise: sign in again).

    \f
    Keelstone: upstream deleted the account on the session alone, so a stolen cookie or an
    unlocked computer was enough to destroy it.
    """
    if current_user.has_role(UserRole.ADMIN):
        raise BadRequestError(message="Administrators cannot delete their own account")
    claims = getattr(request.state, "session_claims", None)
    await user_service.confirm_identity(
        current_user,
        body.current_password if body else None,
        claims.signed_in_at if claims else None,
    )
    await user_service.delete(current_user.id)


@router.post("", response_model=UserRead, status_code=status.HTTP_201_CREATED)
async def create_user(
    user_in: UserCreate,
    user_service: AdminUserSvc,
    _: CurrentAdmin,
) -> Any:
    """Create a user (administrators). The user gets a personal organization."""
    return await user_service.create(user_in)


@router.post("/me/avatar", response_model=UserRead)
async def upload_avatar(
    user_service: UserSvc,
    current_user: CurrentUser,
    file: UploadFile = File(...),
) -> Any:
    """Upload or replace avatar image for the current user."""
    data = await file.read()
    try:
        user = await user_service.update_avatar(
            current_user.id, data, file.filename or "avatar.jpg", file.content_type or ""
        )
    except ValueError as e:
        raise BadRequestError(message=str(e)) from None
    return user


@router.get("/avatar/{user_id}", response_model=None)
async def get_avatar(user_id: UUID, user_service: UserSvc, _: CurrentUser) -> Any:
    """Get the avatar image of a user who shares an organization with the caller.

    \f
    Keelstone: upstream served it without authentication, so under row level security the
    lookup had no principal and always answered 404. It now needs a signed-in user, and the
    users policy (the user or someone sharing an organization) decides who is found.
    """
    user = await user_service.get_by_id(user_id)
    if not user.avatar_url:
        raise NotFoundError(message="No avatar set")
    file_path = user_service.get_avatar_path(user)
    if not file_path:
        raise NotFoundError(message="Avatar file not found")
    return avatar_response(file_path)


{%- if enable_pagination %}


@router.get("", response_model=Page[UserRead])
async def read_users(
    user_service: AdminUserSvc,
    _: CurrentAdmin,
) -> Any:
    """Get all users (admin only)."""
    return await user_service.list_paginated()


{%- else %}


@router.get("", response_model=list[UserRead])
async def read_users(
    user_service: AdminUserSvc,
    _: CurrentAdmin,
    skip: int = Query(0, ge=0, description="Items to skip"),
    limit: int = Query(100, ge=1, le=200, description="Max items to return"),
) -> Any:
    """Get all users (admin only)."""
    users = await user_service.get_multi(skip=skip, limit=limit)
    return users


{%- endif %}


@router.get("/{user_id}", response_model=UserRead)
async def read_user(
    user_id: UUID,
    user_service: AdminUserSvc,
    _: CurrentAdmin,
) -> Any:
    """Get user by ID (admin only)."""
    user = await user_service.get_by_id(user_id)
    return user


@router.patch("/{user_id}", response_model=UserRead)
async def update_user_by_id(
    user_id: UUID,
    user_in: UserUpdate,
    user_service: AdminUserSvc,
    _: CurrentAdmin,
) -> Any:
    """Update user by ID (admin only)."""
    user = await user_service.update(user_id, user_in)
    return user


@router.delete("/{user_id}", status_code=status.HTTP_204_NO_CONTENT, response_model=None)
async def delete_user_by_id(
    user_id: UUID,
    user_service: AdminUserSvc,
    _: CurrentAdmin,
) -> None:
    """Delete user by ID (admin only)."""
    await user_service.delete(user_id)


{%- else %}
"""User routes - not configured."""
{%- endif %}
