from app.api.routes.v1 import conversations, public_demos
{%- endif %}
{%- if use_jwt and use_ai %}
from app.api.routes.v1 import admin_conversations
{%- endif %}
{%- if use_pydantic_deep and use_jwt %}
from app.api.routes.v1 import projects
{%- endif %}
{%- if enable_webhooks and use_database %}
from app.api.routes.v1 import webhooks
{%- endif %}
{%- if enable_mcp_client %}
from app.api.routes.v1 import me_mcp_connections
{%- endif %}
{%- if enable_memory %}
from app.api.routes.v1 import me_memory
{%- endif %}
