"""API v1 router aggregation."""
{%- if use_jwt or enable_oauth or enable_webhooks or use_pydantic_deep or use_telegram or use_slack %}
# ruff: noqa: I001 - Imports structured for Jinja2 template conditionals
{%- endif %}

from fastapi import APIRouter

from app.api.routes.v1 import health
{%- if use_jwt %}
from app.api.routes.v1 import admin_users, auth, users
{%- endif %}
{%- if use_jwt and use_ai %}
from app.api.routes.v1 import admin_ratings
{%- endif %}
{%- if enable_oauth %}
