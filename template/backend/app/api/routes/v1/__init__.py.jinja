from app.api.routes.v1 import agent
{%- endif %}
{%- if enable_rag %}
from app.api.routes.v1 import rag
{%- endif %}
{%- if use_jwt %}
from app.api.routes.v1 import files
{%- endif %}
{%- if use_telegram or use_slack %}
from app.api.routes.v1 import channels
{%- endif %}
