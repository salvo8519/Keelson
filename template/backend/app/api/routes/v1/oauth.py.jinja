{%- if enable_oauth %}
"""Single sign-on through OpenID Connect providers (upstream's Google flow, generalised).

    GET  /oauth/providers          the providers to show on the sign-in page
    GET  /oauth/<name>/login       redirect to the provider (authorization code with PKCE)
    GET  /oauth/<name>/callback    back from the provider: the user is found or created
    POST /oauth/exchange           the frontend trades a one-time code for the session cookies

Keelstone: upstream put the access and refresh tokens in the URL of the redirect to the
frontend, where browser history, proxies and server logs keep them. The redirect now carries
a random code, valid once for a minute and stored only as a hash; the frontend exchanges it
in a POST for the session, set as HttpOnly cookies (app/core/session_cookies.py). The user signs in once, at the provider.

The code is bound to the browser that came back from the provider: the callback also sets a
short HttpOnly cookie, and the exchange needs both. Without it, someone could sign in with
their own account, stop before the exchange and send the link to a victim, whose browser would
then work in the attacker's account (login CSRF).
"""

import hashlib
import logging
import secrets
from typing import Any
from urllib.parse import urlencode
from uuid import UUID

from authlib.integrations.base_client import OAuthError
from fastapi import APIRouter, Request, Response, status
from fastapi.responses import RedirectResponse

from app.api.deps import AuthUserSvc, Redis
from app.core.config import settings
from app.core.exceptions import AuthenticationError, NotFoundError
from app.core.oauth import PROVIDERS, client, redirect_uri
from app.core.oidc import SignInRefused, verified_identity
from app.core.revoked_tokens import ask_store
from app.core.security import issue_session_tokens
from app.core.session_cookies import require_trusted_origin, secure_cookies, set_session_cookies
from app.schemas.oauth import OAuthCodeExchange, OAuthProviderRead

logger = logging.getLogger(__name__)

router = APIRouter()

CODE_PREFIX = "oauth:code:"
CODE_TTL_SECONDS = 60
BINDING_COOKIE = "sso_binding"


def _binding_path() -> str:
    return f"{settings.API_V1_STR}/oauth/exchange"


def _digest(value: str) -> str:
    return hashlib.sha256(value.encode()).hexdigest()


def _code_key(code: str) -> str:
    return CODE_PREFIX + _digest(code)


def _to_login(error: str) -> RedirectResponse:
    """Back to the sign-in page with a reason code, which the frontend translates."""
    frontend = settings.FRONTEND_URL.rstrip("/")
    return RedirectResponse(url=f"{frontend}/login?{urlencode({'error': error})}")


@router.get("/providers", response_model=list[OAuthProviderRead])
async def list_providers() -> Any:
    """Providers users can sign in with; empty when single sign-on is off."""
    return [OAuthProviderRead(name=p.name, label=p.label) for p in PROVIDERS.values()]


@router.get("/{name}/login", response_model=None)
async def provider_login(name: str, request: Request) -> RedirectResponse:
    """Redirect to the provider's sign-in page."""
    if name not in PROVIDERS:
        raise NotFoundError(message="Unknown sign-in provider", details={"provider": name})
    return await client(name).authorize_redirect(request, redirect_uri(name))  # type: ignore[no-any-return]


@router.get("/{name}/callback", response_model=None)
async def provider_callback(
    name: str, request: Request, user_service: AuthUserSvc, redis: Redis
) -> RedirectResponse:
    """Back from the provider: find or create the user, then return to the frontend."""
    provider = PROVIDERS.get(name)
    if provider is None:
        return _to_login("unknown_provider")
    try:
        token = await client(name).authorize_access_token(request)
        identity = verified_identity(provider, token.get("userinfo") or {})
    except SignInRefused as refused:
        logger.info("oauth_sign_in_refused", extra={"provider": name, "reason": str(refused)})
        return _to_login(refused.code)
    except OAuthError:
        logger.warning("oauth_callback_failed", extra={"provider": name}, exc_info=True)
        return _to_login("failed")
    try:
        user = await user_service.get_or_create_oauth_user(
            provider=name,
            provider_id=identity.subject,
            email=identity.email,
            full_name=identity.name,
            email_verified=identity.email_verified,
        )
    except SignInRefused as refused:
        logger.info("oauth_sign_in_refused", extra={"provider": name, "reason": str(refused)})
        return _to_login(refused.code)
    if not user.is_active:
        return _to_login("account_disabled")
    code, binding = secrets.token_urlsafe(32), secrets.token_urlsafe(32)
    # Keelstone: Redis down is a 503 (SESSION_STORE_UNAVAILABLE), not an unhandled 500.
    await ask_store(
        redis.set(_code_key(code), f"{user.id}:{_digest(binding)}", ttl=CODE_TTL_SECONDS)
    )
    frontend = settings.FRONTEND_URL.rstrip("/")
    redirect = RedirectResponse(url=f"{frontend}/auth/callback?{urlencode({'code': code})}")
    redirect.set_cookie(
        BINDING_COOKIE,
        binding,
        max_age=CODE_TTL_SECONDS,
        path=_binding_path(),
        httponly=True,
        secure=secure_cookies(),
        samesite="lax",
    )
    return redirect


@router.post("/exchange", status_code=status.HTTP_204_NO_CONTENT, response_model=None)
async def exchange_code(
    body: OAuthCodeExchange,
    request: Request,
    response: Response,
    redis: Redis,
    user_service: AuthUserSvc,
) -> None:
    """Trade the one-time code of a sign-in for the session, set as HttpOnly cookies."""
    require_trusted_origin(request)
    stored = await ask_store(redis.raw.getdel(_code_key(body.code)))
    response.delete_cookie(BINDING_COOKIE, path=_binding_path())
    # The client decodes responses (app/clients/redis.py): "<user id>:<digest of the binding>".
    user_id, _, bound = str(stored or "").partition(":")
    binding = request.cookies.get(BINDING_COOKIE, "")
    if not user_id or not binding or not secrets.compare_digest(bound, _digest(binding)):
        raise AuthenticationError(message="Invalid or expired sign-in code")
    user = await user_service.get_by_id(UUID(user_id))
    if not user.is_active:
        raise AuthenticationError(message="User account is disabled")
    set_session_cookies(response, *issue_session_tokens(user))
{%- else %}
"""OAuth routes - not configured."""
{%- endif %}
