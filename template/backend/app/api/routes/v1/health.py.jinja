"""Health check endpoints.

Provides Kubernetes-compatible health check endpoints:
- /health - Simple liveness check
- /health/live - Detailed liveness probe
- /health/ready - Readiness probe with dependency checks
"""
{%- if use_database or enable_redis %}
# ruff: noqa: I001 - Imports structured for Jinja2 template conditionals
{%- endif %}

import logging
import socket
from typing import Any

from fastapi import APIRouter
from fastapi.responses import JSONResponse
from sqlalchemy import text

{%- if use_database or enable_redis %}
from app.api.deps import {% if use_database %}DBSession{% endif %}{% if use_database and enable_redis %}, {% endif %}{% if enable_redis %}Redis{% endif %}

{%- endif %}
from app.core.config import settings
from app.schemas.base import HealthDetailResponse, HealthResponse
from app.services.health import build_health_response

router = APIRouter()
logger = logging.getLogger(__name__)

# Keelson: the probes are unauthenticated, so a check reports only its status. The reason of
# a failure (driver messages carry host names, user names and versions) goes to the log.
HEALTHY = {"status": "healthy"}
UNHEALTHY = {"status": "unhealthy"}
UNKNOWN = {"status": "unknown"}


def _failed(dependency: str) -> dict[str, str]:
    """Log the exception being handled and return the public status of a failed check."""
    logger.warning("Readiness check failed: %s", dependency, exc_info=True)
    return dict(UNHEALTHY)


@router.get("/health", response_model=HealthResponse)
async def health_check() -> dict[str, Any]:
    """Simple liveness probe - check if application is running.

    This is a lightweight check that should always succeed if the
    application is running. Use this for basic connectivity tests.

    Returns:
        {"status": "healthy"}
    """
    return {
        "status": "healthy",
        "max_upload_size_mb": settings.MAX_UPLOAD_SIZE_MB,
    }


@router.get("/health/live", response_model=HealthDetailResponse)
async def liveness_probe() -> dict[str, Any]:
    """Detailed liveness probe for Kubernetes.

    This endpoint is designed for Kubernetes liveness probes.
    It checks if the application process is alive and responding.
    Failure indicates the container should be restarted.

    Returns:
        Structured response with timestamp and service info.
    """
    return build_health_response(
        status="alive",
        details={"version": getattr(settings, "VERSION", "1.0.0")},
    )


@router.get("/health/ready", response_model=None)
async def readiness_probe(
{%- if use_database %}
    db: DBSession,
{%- endif %}
{%- if enable_redis %}
    redis: Redis,
{%- endif %}
) -> dict[str, Any] | JSONResponse:
    """Readiness probe for Kubernetes.

    This endpoint checks if all dependencies are ready to handle traffic.
    It verifies database connections, Redis, and other critical services.
    Failure indicates traffic should be temporarily diverted.

    Checks performed:
    {%- if use_database %}
    - Database connectivity
    {%- endif %}
    {%- if enable_redis %}
    - Redis connectivity
    {%- endif %}

    Returns:
        Structured response with individual check results.
        Returns 503 if any critical check fails.
    """
    checks: dict[str, dict[str, Any]] = {}

    try:
        await db.execute(text("SELECT 1"))
        checks["database"] = dict(HEALTHY)
    except Exception:
        checks["database"] = _failed("database")

{%- if enable_redis %}
    try:
        if await redis.ping():
            checks["redis"] = dict(HEALTHY)
        else:
            logger.warning("Readiness check failed: redis did not answer the ping")
            checks["redis"] = dict(UNHEALTHY)
    except Exception:
        checks["redis"] = _failed("redis")
{%- endif %}

{%- if enable_rag and vector_store == "milvus" %}
    try:
        with socket.create_connection((settings.MILVUS_HOST, settings.MILVUS_PORT), timeout=2):
            pass
        checks["vector_store"] = dict(HEALTHY)
    except Exception:
        checks["vector_store"] = _failed("vector_store")
{%- elif enable_rag and vector_store == "qdrant" %}
    try:
        with socket.create_connection((settings.QDRANT_HOST, settings.QDRANT_PORT), timeout=2):
            pass
        checks["vector_store"] = dict(HEALTHY)
    except Exception:
        checks["vector_store"] = _failed("vector_store")
{%- elif enable_rag %}
    checks["vector_store"] = dict(UNKNOWN)  # no probe implemented for this store
{%- endif %}

    # LLM provider — config-only check (avoid spending money on a probe call).
    llm_provider = (getattr(settings, "LLM_PROVIDER", None) or "").lower()
    if llm_provider:
        key_field = {
            "openai": "OPENAI_API_KEY",
            "anthropic": "ANTHROPIC_API_KEY",
            "google": "GOOGLE_API_KEY",
            "openrouter": "OPENROUTER_API_KEY",
            # The key is optional here; without the endpoint nothing works.
            "openai_compatible": "OPENAI_COMPATIBLE_BASE_URL",
        }.get(llm_provider)
        api_key = getattr(settings, key_field, None) if key_field else None
        checks["llm"] = dict(HEALTHY if api_key else UNHEALTHY)
    else:
        checks["llm"] = dict(UNKNOWN)

{%- if enable_billing %}
    stripe_key = getattr(settings, "STRIPE_SECRET_KEY", None)
    checks["stripe"] = dict(HEALTHY if stripe_key else UNKNOWN)
{%- endif %}

{%- if use_celery %}
    # Background worker — config-only (a real probe needs an end-to-end ping).
    broker_url = getattr(settings, "CELERY_BROKER_URL", None)
    checks["worker"] = dict(HEALTHY if broker_url else UNKNOWN)
{%- endif %}

    # Determine overall health — only db + redis are critical for readiness.
    critical = {k: v for k, v in checks.items() if k in ("database", "redis")}
    all_healthy = (
        all(check.get("status") == "healthy" for check in critical.values())
        if critical
        else True
    )

    # The admin /system page reads each service from the top level, so flatten
    # the checks alongside the structured `checks` field for K8s probes.
    response_data = build_health_response(
        status="ready" if all_healthy else "not_ready",
        checks=checks,
    )
    response_data.update(checks)

    if not all_healthy:
        return JSONResponse(status_code=503, content=response_data)

    return response_data


# Backward compatibility - keep /ready endpoint
@router.get("/ready", response_model=None)
async def readiness_check(
{%- if use_database %}
    db: DBSession,
{%- endif %}
{%- if enable_redis %}
    redis: Redis,
{%- endif %}
) -> dict[str, Any] | JSONResponse:
    """Readiness check (alias for /health/ready).

    Deprecated: Use /health/ready instead.
    """
    return await readiness_probe(
{%- if use_database %}
        db=db,
{%- endif %}
{%- if enable_redis %}
        redis=redis,
{%- endif %}
    )
