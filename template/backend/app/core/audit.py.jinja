"""Audit log helpers for recording privileged actions.

Keelson changes two things from upstream:

* The entry is written with a plain INSERT, without RETURNING. The application login may
  add audit entries but never read them (app/db/tenancy.py), and PostgreSQL checks a
  RETURNING clause against the read policy, so an ORM flush that fetches ``created_at``
  back was refused.
* A failure raises, and the action is rolled back with it. Upstream logged the error and
  went on, which left the session unusable and the action unrecorded: for ISO/IEC 27001
  (A.8.15) and SOC 2 (CC7.2) an action that cannot be audited should not happen.
"""

from typing import Any
from uuid import UUID

from sqlalchemy import insert

from app.core.logging import without_secrets
from app.db.session import system_session
from app.db.models.audit_log import AppAdminAuditLog


async def record_audit(
    db,
    *,
    actor_user_id: UUID,
    action: str,
    organization_id: UUID | None = None,
    target_type: str | None = None,
    target_id: str | None = None,
    details: dict[str, Any] | None = None,
    ip_address: str | None = None,
) -> None:
    """Add an audit log entry in the caller's transaction; raises if it cannot be written."""
    await db.execute(
        insert(AppAdminAuditLog).values(
            actor_user_id=actor_user_id,
            action=action,
            organization_id=organization_id,
            target_type=target_type,
            target_id=str(target_id) if target_id is not None else None,
            # Keelson: a request body may carry a password or a token; the audit never keeps it.
            details=without_secrets(details),
            ip_address=ip_address,
        )
    )



async def record_refusal(reason: str, **entry: Any) -> None:
    """Keelson: an entry that must outlive the caller's transaction. A refusal is followed by
    an error, which rolls the request back with anything written in it; this entry is written
    and committed in a system session of its own."""
    async with system_session(reason) as db:
        await record_audit(db, **entry)
        await db.commit()

{%- else %}
"""Audit log — not configured (enable_teams=false)."""
{%- endif %}
