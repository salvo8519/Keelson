{%- if enable_oauth %}
"""OpenID Connect clients (Authlib, as upstream), one per configured provider (Keelstone).

The providers come from the settings (app/core/oidc.py). Authorization uses the code flow
with PKCE; Authlib verifies the ID token (signature from the provider's keys, issuer,
audience, expiry and nonce) before the application reads its claims.
"""

from authlib.integrations.starlette_client import OAuth, StarletteOAuth2App

from app.core.config import settings
from app.core.oidc import OidcProvider, configured_providers

oauth = OAuth()

PROVIDERS: dict[str, OidcProvider] = {
    provider.name: provider
    for provider in configured_providers(
        settings.OIDC_PROVIDERS, settings.GOOGLE_CLIENT_ID, settings.GOOGLE_CLIENT_SECRET
    )
}

for _provider in PROVIDERS.values():
    oauth.register(
        name=_provider.name,
        client_id=_provider.client_id,
        client_secret=_provider.client_secret or None,
        server_metadata_url=_provider.discovery_url,
        client_kwargs={"scope": _provider.scopes, "code_challenge_method": "S256"},
    )


def client(name: str) -> StarletteOAuth2App:
    return oauth.create_client(name)  # type: ignore[no-any-return]


def redirect_uri(name: str) -> str:
    """Where the provider sends the user back; register it with the provider."""
    return f"{settings.PUBLIC_API_URL.rstrip('/')}{settings.API_V1_STR}/oauth/{name}/callback"
{%- else %}
"""OAuth module - not configured."""
{%- endif %}
