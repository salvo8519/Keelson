"""Security utilities for JWT authentication."""

import hashlib
import secrets
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from typing import Any
from uuid import UUID

import jwt
from pwdlib import PasswordHash
from pwdlib.exceptions import UnknownHashError
from pwdlib.hashers.argon2 import Argon2Hasher
from pwdlib.hashers.bcrypt import BcryptHasher

from app.core.config import settings

{%- if use_delegated_auth %}

# Validates JWTs minted by an external system. Two modes (chosen at template
# generation time): JWKS (RS/ES asymmetric, IdP-style) or shared-secret HS256.
# Both expose the same `verify_idp_token(token)` API so the rest of the app
# doesn't care which is in use.

{%- if use_shared_secret_jwt %}


def verify_idp_token(token: str) -> dict[str, Any] | None:
    """Validate a JWT signed with the pre-shared HS256 secret.

    Use this when the client backend signs short-lived JWTs for our API with
    a known secret rather than going through a full IdP. The secret lives in
    ``settings.IDP_SHARED_SECRET`` and MUST be high-entropy (rotate it on
    suspected leak; rotation invalidates all in-flight tokens).

    Returns claims dict on success, ``None`` on any verification failure.
    """
    if not settings.IDP_SHARED_SECRET:
        return None
    try:
        return jwt.decode(
            token,
            settings.IDP_SHARED_SECRET,
            algorithms=["HS256"],
            audience=settings.IDP_AUDIENCE or None,
            issuer=settings.IDP_ISSUER or None,
            leeway=30,
            # `aud` and `iss` checks skipped when the corresponding setting
            # is empty (otherwise PyJWT raises MissingRequiredClaimError).
            options={
                "verify_aud": bool(settings.IDP_AUDIENCE),
                "verify_iss": bool(settings.IDP_ISSUER),
            },
        )
    except jwt.PyJWTError:
        return None
{%- else %}

_jwks_client: jwt.PyJWKClient | None = None


def _get_jwks_client() -> jwt.PyJWKClient:
    """Lazy singleton — only built when first delegated request hits."""
    global _jwks_client
    if _jwks_client is None:
        if not settings.IDP_JWKS_URL:
            raise RuntimeError(
                "IDP_JWKS_URL is not set — delegated auth cannot validate tokens."
            )
        _jwks_client = jwt.PyJWKClient(
            settings.IDP_JWKS_URL,
            cache_keys=True,
            lifespan=settings.IDP_JWKS_CACHE_TTL_SECONDS,
        )
    return _jwks_client


def verify_idp_token(token: str) -> dict[str, Any] | None:
    """Validate a JWT issued by the configured IdP.

    Returns the decoded claims dict on success, or ``None`` if any check fails
    (signature, audience, issuer, expiry). Caller decides how to translate
    ``None`` into HTTP 401.

    Notes:
    - Algorithms: any RS256/ES256/etc. published in the JWKS. ``HS256``
      explicitly rejected — use --shared-secret-jwt for HMAC tokens instead.
    - Clock skew: 30 seconds via ``leeway``.
    """
    try:
        client = _get_jwks_client()
        signing_key = client.get_signing_key_from_jwt(token)
        return jwt.decode(
            token,
            signing_key.key,
            algorithms=["RS256", "ES256", "RS384", "ES384", "RS512", "ES512"],
            audience=settings.IDP_AUDIENCE or None,
            issuer=settings.IDP_ISSUER or None,
            leeway=30,
        )
    except (jwt.PyJWTError, jwt.exceptions.PyJWKClientError):
        return None
{%- endif %}
{%- endif %}


# Keelstone: every access and refresh token carries the session version of its user (``ver``),
# the value of ``users.token_epoch`` when it was issued. Raising the version (a password change
# or reset, a password set by an administrator, a deactivation, a sign-out from every device)
# ends every session issued before, as ``magic_link_epoch`` does for sign-in links. A refresh
# token also has an id (``jti``) and the id of its session (``sid``), shared by every refresh
# token the session rotates through, so that signing out ends that session alone, the tokens
# rotated before included (``app/core/revoked_tokens.py``). An access token issued for an
# impersonation names the administrator and their session version in ``act`` (RFC 8693,
# section 4.1): it stops working when the administrator loses the role or signs out everywhere.
ACCESS = "access"
REFRESH = "refresh"


def _encode(claims: dict[str, Any], lifetime: timedelta) -> str:
    claims["exp"] = datetime.now(UTC) + lifetime
    return jwt.encode(claims, settings.SECRET_KEY, algorithm=settings.ALGORITHM)


def create_access_token(
    subject: str | Any,
    *,
    version: int,
    expires_delta: timedelta | None = None,
    actor: Any | None = None,
) -> str:
    """Create a JWT access token for the session ``version`` of the user ``subject``.

    ``actor`` is the administrator of an impersonation (a user): the token names them and the
    session version they are in.
    """
    claims: dict[str, Any] = {"sub": str(subject), "type": ACCESS, "ver": version}
    if actor is not None:
        claims["act"] = {"sub": str(actor.id), "ver": actor.token_epoch}
    lifetime = expires_delta or timedelta(minutes=settings.ACCESS_TOKEN_EXPIRE_MINUTES)
    return _encode(claims, lifetime)


def create_refresh_token(
    subject: str | Any,
    *,
    version: int,
    session_id: str | None = None,
    expires_delta: timedelta | None = None,
) -> str:
    """Create a JWT refresh token for the session ``version`` of the user ``subject``.

    ``session_id`` continues a session (a rotation); without it a new session starts.
    """
    claims: dict[str, Any] = {
        "sub": str(subject),
        "type": REFRESH,
        "ver": version,
        "jti": secrets.token_urlsafe(16),
        "sid": session_id or secrets.token_urlsafe(16),
    }
    lifetime = expires_delta or timedelta(minutes=settings.REFRESH_TOKEN_EXPIRE_MINUTES)
    return _encode(claims, lifetime)


def issue_session_tokens(user: Any, session_id: str | None = None) -> tuple[str, str]:
    """A new access and refresh token for ``user``, in its current session version.

    ``session_id`` is given when a refresh token is rotated: the new one stays in its session.
    """
    return (
        create_access_token(user.id, version=user.token_epoch),
        create_refresh_token(user.id, version=user.token_epoch, session_id=session_id),
    )


@dataclass(frozen=True)
class SessionClaims:
    """The verified claims of an access or refresh token."""

    user_id: UUID
    version: int | None
    actor_id: str | None
    token_id: str | None
    expires_at: int
    actor_version: int | None = None
    session_id: str | None = None

    def is_current_for(self, user: Any) -> bool:
        """The token belongs to an active user's current session."""
        return bool(user.is_active) and self.version == user.token_epoch


def read_session_token(token: str | None, token_type: str) -> SessionClaims | None:
    """The claims of a valid token of ``token_type``, or None (signature, expiry, type, subject)."""
    payload = verify_token(token) if token else None
    if payload is None or payload.get("type") != token_type:
        return None
    try:
        user_id = UUID(str(payload.get("sub")))
    except ValueError:
        return None
    version = payload.get("ver")
    act = payload.get("act")
    actor: dict[str, Any] = act if isinstance(act, dict) else {}
    actor_version = actor.get("ver")
    return SessionClaims(
        user_id=user_id,
        version=version if isinstance(version, int) else None,
        actor_id=str(actor["sub"]) if actor.get("sub") else None,
        token_id=str(payload["jti"]) if payload.get("jti") else None,
        expires_at=int(payload.get("exp", 0)),
        actor_version=actor_version if isinstance(actor_version, int) else None,
        session_id=str(payload["sid"]) if payload.get("sid") else None,
    )


def verify_token(token: str) -> dict[str, Any] | None:
    """Verify a JWT token and return payload."""
    try:
        payload = jwt.decode(
            token,
            settings.SECRET_KEY,
            algorithms=[settings.ALGORITHM],
        )
        return payload
    except jwt.PyJWTError:
        return None


def password_epoch(hashed_password: str | None) -> str:
    """Short digest of a stored password hash, used to bind a reset token to it.

    A JWT cannot be revoked, so a reset link would otherwise stay valid for its
    whole TTL — replayable after the victim has already used it. Embedding this
    digest makes the first successful reset invalidate the token by
    construction: the reset rotates ``hashed_password``, so the digest no longer
    matches. Stateless, so it needs no denylist and no migration.
    """
    return hashlib.sha256((hashed_password or "").encode("utf-8")).hexdigest()[:16]


# Keelstone: lifetimes of the links sent by email, shared with the email texts.
PASSWORD_RESET_TTL = timedelta(hours=1)
MAGIC_LINK_TTL = timedelta(minutes=15)
EMAIL_CHANGE_TTL = timedelta(hours=1)


def create_password_reset_token(
    subject: str | Any,
    current_password_hash: str | None,
    expires_delta: timedelta | None = None,
) -> str:
    """Single-use JWT for password reset.

    Short-lived (1h default). The `type` claim distinguishes it from access /
    refresh / magic-link tokens — a stolen reset token can't be used as an
    access token. The `pwe` claim binds it to the password in force at issue
    time, so redeeming it once invalidates it (see :func:`password_epoch`).
    """
    expire = datetime.now(UTC) + (expires_delta or PASSWORD_RESET_TTL)
    to_encode = {
        "exp": expire,
        "sub": str(subject),
        "type": "password_reset",
        "pwe": password_epoch(current_password_hash),
    }
    return jwt.encode(to_encode, settings.SECRET_KEY, algorithm=settings.ALGORITHM)


def create_magic_link_token(
    subject: str | Any,
    magic_link_epoch: int,
    expires_delta: timedelta | None = None,
) -> str:
    """Sign-in-by-email JWT. Short-lived (15 min default).

    The `mle` claim carries the user's magic-link epoch at issue time.
    Redeeming a link bumps the epoch, so the link that was used — and every
    other link still outstanding for that user — stops validating. This is what
    makes the link single-use; a JWT cannot be revoked any other way.
    """
    expire = datetime.now(UTC) + (expires_delta or MAGIC_LINK_TTL)
    to_encode = {
        "exp": expire,
        "sub": str(subject),
        "type": "magic_link",
        "mle": magic_link_epoch,
    }
    return jwt.encode(to_encode, settings.SECRET_KEY, algorithm=settings.ALGORITHM)


def address_digest(email: str) -> str:
    """Short digest of an e-mail address, used to bind a change link to the address it replaces.

    As :func:`password_epoch` does for a reset: once the change is made the digest no longer
    matches, so the link is single-use; the old address is not written into the link.
    """
    return hashlib.sha256(email.lower().encode("utf-8")).hexdigest()[:16]


def create_email_change_token(user: Any, new_email: str, expires_delta: timedelta | None = None) -> str:
    """Keelstone: the link that confirms ``new_email`` for ``user``, sent to the new address.

    Bound to the user, the new address, the address in force (``cur``, single use) and the
    session version (``ver``): a sign-out from every device or a password change voids it.
    """
    expire = datetime.now(UTC) + (expires_delta or EMAIL_CHANGE_TTL)
    to_encode = {
        "exp": expire,
        "sub": str(user.id),
        "type": "email_change",
        "email": new_email,
        "cur": address_digest(user.email),
        "ver": user.token_epoch,
    }
    return jwt.encode(to_encode, settings.SECRET_KEY, algorithm=settings.ALGORITHM)


def verify_special_token(token: str, expected_type: str) -> dict[str, Any] | None:
    """Verify a non-access JWT (password_reset, magic_link) and require a
    specific `type` claim. Returns payload on success, None otherwise.
    """
    payload = verify_token(token)
    if payload is None:
        return None
    if payload.get("type") != expected_type:
        return None
    return payload


# Keelstone, from the official FastAPI template: new passwords are hashed with Argon2id (RFC 9106,
# OWASP's first choice); bcrypt hashes of earlier versions are still verified and replaced with
# Argon2id at the next sign-in (verify_and_update_password). Passwords are never stored.
password_hash = PasswordHash((Argon2Hasher(), BcryptHasher()))

# Verified when no account matches, so that a sign-in takes the same time whether or not the
# e-mail address is registered (official template).
DUMMY_HASH = (
    "$argon2id$v=19$m=65536,t=3,p=4$MjQyZWE1MzBjYjJlZTI0Yw$"
    "YTU4NGM5ZTZmYjE2NzZlZjY0ZWY3ZGRkY2U2OWFjNjk"
)


def verify_password(plain_password: str, hashed_password: str) -> bool:
    """Verify a password against a hash; an unknown hash format never matches."""
    try:
        return password_hash.verify(plain_password, hashed_password)
    except UnknownHashError:
        return False


def verify_and_update_password(plain_password: str, hashed_password: str) -> tuple[bool, str | None]:
    """Verify a password; when it matches an outdated hash, also return its Argon2id hash."""
    try:
        return password_hash.verify_and_update(plain_password, hashed_password)
    except UnknownHashError:
        return False, None


def get_password_hash(password: str) -> str:
    """Hash a password with Argon2id."""
    return password_hash.hash(password)
