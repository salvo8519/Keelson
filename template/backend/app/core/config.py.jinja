    POSTGRES_HOST: str = "localhost"
    POSTGRES_PORT: int = 5432
    POSTGRES_USER: str = "postgres"
    POSTGRES_PASSWORD: str = ""
    POSTGRES_DB: str = "{{ project_slug }}"

    # Keelson: the application login serves requests under row level security (app/db/tenancy.py);
    # POSTGRES_USER owns the tables and runs migrations and explicit system work. The
    # migration creates the application login with this password.
    POSTGRES_APP_USER: str = "{{ project_slug }}_app"
    POSTGRES_APP_PASSWORD: str = "change-me-app-password"

    def _postgres_url(self, driver: str, user: str, password: str) -> str:
        # Keelson: credentials are escaped (upstream broke on passwords with @, : or /).
        return (
            f"postgresql+{driver}://{quote(user, safe='')}:{quote(password, safe='')}"
            f"@{self.POSTGRES_HOST}:{self.POSTGRES_PORT}/{self.POSTGRES_DB}"
        )

    @computed_field  # type: ignore[prop-decorator]
    @property
    def DATABASE_URL(self) -> str:
        """Async URL of the owner login: migrations and system work."""
        return self._postgres_url("asyncpg", self.POSTGRES_USER, self.POSTGRES_PASSWORD)

    @computed_field  # type: ignore[prop-decorator]
    @property
    def APP_DATABASE_URL(self) -> str:
        """Async URL of the application login: requests, under row level security."""
        return self._postgres_url("asyncpg", self.POSTGRES_APP_USER, self.POSTGRES_APP_PASSWORD)

    @computed_field  # type: ignore[prop-decorator]
    @property
    def DATABASE_URL_SYNC(self) -> str:
        """Build sync PostgreSQL connection URL (for Alembic).

        The driver is named because a bare ``postgresql://`` means psycopg 3 on
        SQLAlchemy 2.1 but psycopg2 on 2.0, which SQLModel pins.
        """
        return self._postgres_url("psycopg2", self.POSTGRES_USER, self.POSTGRES_PASSWORD)

    DB_POOL_SIZE: int = {{ db_pool_size }}
    DB_MAX_OVERFLOW: int = {{ db_max_overflow }}
    DB_POOL_TIMEOUT: int = {{ db_pool_timeout }}



{%- if use_jwt or (enable_admin_panel and admin_require_auth) or enable_oauth %}

    SECRET_KEY: str = "change-me-in-production-use-openssl-rand-hex-32"

    # Keelson: keys for secrets stored in the database (connector credentials, MCP tokens),
    # newest first, comma separated; separate from SECRET_KEY, which signs tokens. Empty in
    # development: SECRET_KEY is used. Generate one with: openssl rand -hex 32
    DATA_ENCRYPTION_KEYS: Annotated[list[str], NoDecode] = []

    @field_validator("DATA_ENCRYPTION_KEYS", mode="before")
    @classmethod
    def split_data_keys(cls, v: object) -> object:
        return [part.strip() for part in v.split(",") if part.strip()] if isinstance(v, str) else v

    @field_validator("DATA_ENCRYPTION_KEYS")
    @classmethod
    def require_data_keys_in_production(cls, v: list[str], info: ValidationInfo) -> list[str]:
        env = info.data.get("ENVIRONMENT", "local") if info.data else "local"
        if env in DEPLOYED_ENVIRONMENTS and not v:
            raise ValueError(f"DATA_ENCRYPTION_KEYS must be set in {env}: openssl rand -hex 32")
        if any(len(key) < 32 for key in v):
            raise ValueError("each DATA_ENCRYPTION_KEYS entry must be at least 32 characters")
        return v

    @field_validator("SECRET_KEY")
    @classmethod
    def validate_secret_key(cls, v: str) -> str:
        """Validate SECRET_KEY is secure in production."""
        if len(v) < 32:
            raise ValueError("SECRET_KEY must be at least 32 characters long")
        return v
