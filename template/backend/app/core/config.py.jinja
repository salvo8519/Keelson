# Same slug rule as a user connection (app/schemas/mcp_connection.py). The name
# becomes the server's tool prefix in the agent, so an unconstrained name could
# collapse two servers onto one prefix — and the second would then be dropped
# from every chat turn. Reject it at startup instead.
MCP_SERVER_NAME_PATTERN = r"^[a-z0-9][a-z0-9-]{0,31}$"


class McpServerConfig(BaseModel):
    """One deployment-managed MCP server (see MCP_SERVERS below)."""

    name: str = Field(pattern=MCP_SERVER_NAME_PATTERN)
    url: str
    headers: dict[str, str] = {}
    # None = expose every tool the server offers.
    allowed_tools: list[str] | None = None
{%- endif %}


# Keelson: secrets that must be real wherever the application is deployed, one rule for all
# of them. A value is refused when it is empty, a stand-in from this file or .env.example
# ("change-me...", "...xxx") or a well-known password. Settings absent from a project, and
# optional ones left unset (None), are skipped.
DEPLOYED_ENVIRONMENTS = frozenset({"staging", "production"})
SECRETS_WHEN_DEPLOYED = (
    "SECRET_KEY",
    "API_KEY",
    "POSTGRES_PASSWORD",
    "POSTGRES_APP_PASSWORD",
    "CHANNEL_ENCRYPTION_KEY",
    "REDIS_PASSWORD",
    "ARQ_REDIS_PASSWORD",
)
_PLACEHOLDER_MARKERS = ("change-me", "changeme", "changethis", "xxx")
_WELL_KNOWN_SECRETS = frozenset({"postgres", "password", "admin", "secret", "redis", "root"})


def is_placeholder_secret(value: str) -> bool:
    """True for a value that only stands in for a secret."""
    lowered = value.strip().lower()
    return (
        not lowered
        or lowered in _WELL_KNOWN_SECRETS
        or any(marker in lowered for marker in _PLACEHOLDER_MARKERS)
    )


def find_env_file() -> Path | None:
    """Find .env file in current or parent directories."""
    current = Path.cwd()
    for path in [current, current.parent]:
        env_file = path / ".env"
        if env_file.exists():
            return env_file
    return None


