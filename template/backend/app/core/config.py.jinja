    @computed_field  # type: ignore[prop-decorator]
    @property
    def rag(self) -> "RAGSettings":
        """Build RAG-specific settings."""
        {%- if use_all_pdf_parsers %}
        pdf_parser = PdfParser(
            method=self.PDF_PARSER,
            api_key=self.LLAMAPARSE_API_KEY,
            tier=self.LLAMAPARSE_TIER,
            liteparse_ocr_server_url=self.LITEPARSE_OCR_SERVER_URL or None,
            liteparse_ocr_language=self.LITEPARSE_OCR_LANGUAGE,
            liteparse_timeout_seconds=self.LITEPARSE_TIMEOUT_SECONDS,
        )
        {%- elif use_llamaparse %}
        pdf_parser = PdfParser(api_key=self.LLAMAPARSE_API_KEY, tier=self.LLAMAPARSE_TIER)
        {%- elif use_liteparse %}
        pdf_parser = PdfParser(
            liteparse_ocr_server_url=self.LITEPARSE_OCR_SERVER_URL or None,
            liteparse_ocr_language=self.LITEPARSE_OCR_LANGUAGE,
            liteparse_timeout_seconds=self.LITEPARSE_TIMEOUT_SECONDS,
        )
        {%- else %}
        pdf_parser = PdfParser()
        {%- endif %}

        return RAGSettings(
            collection_name=self.RAG_DEFAULT_COLLECTION,
            chunk_size=self.RAG_CHUNK_SIZE,
            chunk_overlap=self.RAG_CHUNK_OVERLAP,
            chunking_strategy=self.RAG_CHUNKING_STRATEGY,
            enable_hybrid_search=self.RAG_HYBRID_SEARCH,
            enable_ocr=self.RAG_ENABLE_OCR,
            embeddings_config=EmbeddingsConfig(model=self.EMBEDDING_MODEL),
            document_parser=DocumentParser(),
            pdf_parser=pdf_parser,
{%- if enable_rag_image_description %}
            enable_image_description=self.RAG_ENABLE_IMAGE_DESCRIPTION,
            image_description_model=self.RAG_IMAGE_DESCRIPTION_MODEL,
{%- endif %}
        )

{%- endif %}

    @model_validator(mode="after")
    def refuse_placeholder_secrets(self) -> "Settings":
        """Keelson: a deployed environment starts only with real secrets."""
        if self.ENVIRONMENT not in DEPLOYED_ENVIRONMENTS:
            return self
        placeholders = [
            name
            for name in SECRETS_WHEN_DEPLOYED
            if isinstance(value := getattr(self, name, None), str) and is_placeholder_secret(value)
        ]
        if any(is_placeholder_secret(key) for key in getattr(self, "DATA_ENCRYPTION_KEYS", [])):
            placeholders.append("DATA_ENCRYPTION_KEYS")
        if placeholders:
            raise ValueError(
                f"{', '.join(placeholders)} must be set to real secrets in {self.ENVIRONMENT}: "
                "openssl rand -hex 32"
            )
        return self

