{%- if use_github_actions %}
name: CI

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

# Keelson: jobs get a read-only token unless they ask for more (the Pages deployment).
permissions:
  contents: read

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Install uv
        uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
        with:
          version: "{{ uv_version }}"

      - name: Set up Python
        run: uv python install {{ python_version }}

      - name: Install dependencies
        run: uv sync --locked --directory backend --dev

      - name: Run ruff check
        run: uv run --directory backend ruff check app tests cli

      - name: Run ruff format check
        run: uv run --directory backend ruff format app tests cli --check

      - name: Run ty
        run: uv run --directory backend ty check

      - name: Check translations
        run: uv run --directory backend python -m app.core.i18n_catalog check

  test:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: test_db
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{%- if enable_redis %}
      redis:
        image: valkey/valkey:9-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "valkey-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{%- endif %}

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Install uv
        uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
        with:
          version: "{{ uv_version }}"

      - name: Set up Python
        run: uv python install {{ python_version }}

      - name: Install dependencies
        run: uv sync --locked --directory backend --dev

      - name: Run tests
        run: uv run --directory backend pytest tests/ -v --cov=app --cov-report=xml
        env:
          POSTGRES_HOST: localhost
          POSTGRES_PORT: 5432
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: test_db
{%- if enable_redis %}
          REDIS_HOST: localhost
          REDIS_PORT: 6379
{%- endif %}

      - name: Upload coverage to Codecov
        uses: codecov/codecov-action@303a32d7a59b442fa8d48b6a1cc6825c09c847a5 # v7.1.1
        with:
          files: ./backend/coverage.xml
          fail_ci_if_error: false

{%- if use_frontend %}

  test-frontend:
    # Keelson: the official React frontend (Biome, translations, tsc and Vite). Its Playwright
    # suite needs a running stack and is not part of this job.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Setup Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "{{ bun_version }}"

      - name: Install dependencies
        run: bun install --frozen-lockfile
        working-directory: frontend

      - name: Run Biome
        run: bunx biome check ./
        working-directory: frontend

      - name: Check translations
        run: bun run i18n:check
        working-directory: frontend

      - name: Build
        run: bun run build
        working-directory: frontend
{%- endif %}

  api-contract:
    # Keelson: openapi/openapi.json is the contract of the API. It must match the code, a pull
    # request must not break it (oasdiff, against the target branch), and the frontend client
    # must be generated from it. See the documentation, Reference > API.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0 # the target branch, without a token kept for a later fetch

      - name: Install uv
        uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
        with:
          version: "{{ uv_version }}"

      - name: Set up Python
        run: uv python install {{ python_version }}

      - name: Install backend dependencies
        run: uv sync --locked --directory backend

      - name: The contract matches the code
        run: make openapi-check

      # Keelson: the same pinned, checksum-verified oasdiff as the GitLab pipeline. The branch
      # name goes through the environment, never into the script text.
      - name: No breaking change against the target branch
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ '{{' }} github.base_ref {{ '}}' }}
        run: sh scripts/openapi-breaking.sh "origin/$BASE_REF"
{%- if use_frontend %}

      - name: Setup Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "{{ bun_version }}"

      - name: The frontend client is generated from the contract
        working-directory: frontend
        run: |
          bun install --frozen-lockfile
          bun run generate-client
          bun run lint
          git diff --exit-code -- src/client || {
            echo "The frontend client is out of date: run make client and commit the result."
            exit 1
          }
{%- endif %}

  docs:
    # Keelson: the documentation site (Zensical). The API and settings reference is generated
    # from the code; the build is strict (broken links fail) and translations must be current.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Install uv
        uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
        with:
          version: "{{ uv_version }}"

      - name: Set up Python
        run: uv python install {{ python_version }}

      - name: Install backend dependencies
        run: uv sync --locked --directory backend

      - name: Check translations
        run: make docs-check

      - name: Build the documentation
        run: make docs

      - name: Upload the site
        if: github.event_name == 'push'
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: site

  pages:
    # Publishes the documentation from the default branch (Settings > Pages > Source: GitHub
    # Actions).
    if: github.event_name == 'push' && github.ref_name == github.event.repository.default_branch
    needs: [docs]
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ '{{' }} steps.deployment.outputs.page_url {{ '}}' }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1
  security:
    name: Security Scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0 # the secret scan reads the whole history

      - name: Install uv
        uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
        with:
          version: "{{ uv_version }}"

      - name: Set up Python
        run: uv python install {{ python_version }}

      - name: Install dependencies
        run: uv sync --locked --directory backend --dev

      - name: Run pip-audit
        run: uv run pip-audit --require-hashes=false --progress-spinner=off
        working-directory: backend

      # Keelson: secrets committed by mistake, in the whole history (gitleaks, pinned).
      - name: Scan the history for secrets
        run: |
          docker run --rm -v "$PWD:/repo" ghcr.io/gitleaks/gitleaks:v8.30.1 \
            git /repo --redact --no-banner --exit-code 1

      # Keelson: agent skills are text an agent follows. Each one is pinned (commit and content
      # digest) and scanned before it is installed; a blocking finding fails the job.
      - name: Verify and scan the agent skills
        run: |
          python3 scripts/agent_skills.py install
          python3 scripts/agent_skills.py scan
{%- if use_frontend %}

      - name: Setup Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "{{ bun_version }}"
      # Keelson: known vulnerabilities in the frontend dependencies.
      - name: Audit the frontend dependencies
        working-directory: frontend
        run: |
          bun install --frozen-lockfile
          bun audit --audit-level=high
{%- endif %}

      # Keelson: a software bill of materials (CycloneDX) for every build of the default branch.
      - name: Software bill of materials
        if: github.event_name == 'push'
        uses: anchore/sbom-action@dfcb83b97731532d72be422cbc51ee64adb6fd56 # v0.24.4
        with:
          path: .
          format: cyclonedx-json
          artifact-name: sbom.cdx.json

{%- if enable_docker %}

  docker:
    runs-on: ubuntu-latest
    needs: [lint, test]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1

      - name: Build Docker image
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: ./backend
          push: false
          load: true
          tags: {{ project_slug }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: {{ project_slug }}:latest
          format: table
          # Keelson: a fixable critical or high vulnerability in the image fails the build.
          exit-code: 1
          ignore-unfixed: true
          severity: CRITICAL,HIGH
{%- endif %}
{%- else %}
# GitHub Actions CI is disabled for this project
{%- endif %}
