{%- if enable_docker %}
# Production configuration
{%- if include_traefik_service %}
# with Traefik reverse proxy
{%- elif include_traefik_labels %}
# with external Traefik (connect to traefik-public network)
{%- elif include_nginx_service %}
# with Nginx reverse proxy
{%- elif include_nginx_config %}
# with external Nginx (config template provided)
{%- else %}
# without reverse proxy (ports exposed directly)
{%- endif %}
#
# Usage:
#   1. Fill backend/.env with real production secrets (cp backend/.env.example
#      backend/.env if it doesn't exist yet). The same file is used for dev and
#      prod — there is no separate .env.prod.
#   2. Run: make prod   (or: docker compose --env-file backend/.env -f docker-compose.prod.yml up -d)
{%- if include_traefik_service %}
#
# Prerequisites:
#   1. Configure backend/.env with DOMAIN, ACME_EMAIL and TRAEFIK_DASHBOARD_AUTH
#      (htpasswd -nB admin, every "$" doubled); Compose stops when one is missing
#   2. Ensure ports 80 and 443 are available
#   3. Generate passwords: openssl rand -hex 32
{%- elif include_traefik_labels %}
#
# Prerequisites:
#   1. Create external traefik-public network: docker network create traefik-public
#   2. Run your Traefik instance connected to traefik-public network
#   3. Configure backend/.env with DOMAIN
{%- elif include_nginx_service %}
#
# Prerequisites:
#   1. Place SSL certificates in nginx/ssl/ directory:
#      - nginx/ssl/cert.pem (certificate)
#      - nginx/ssl/key.pem (private key)
#   2. Configure backend/.env with DOMAIN
#   3. Ensure ports 80 and 443 are available
{%- elif include_nginx_config %}
#
# Prerequisites:
#   1. Configure your external Nginx using nginx/nginx.conf as reference
#   2. Configure backend/.env with DOMAIN
{%- endif %}

services:
{%- if include_traefik_service %}
  traefik:
    image: traefik:v3.7
    container_name: {{ project_slug }}_traefik
    command:
      - "--api.dashboard=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.network=traefik-public"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      # Redirect HTTP to HTTPS
      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
      # Let's Encrypt
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.letsencrypt.acme.email=${ACME_EMAIL:?ACME_EMAIL is required (the Let's Encrypt account)}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
      # Access logs
      - "--accesslog=true"
      - "--accesslog.bufferingsize=100"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - traefik_letsencrypt:/letsencrypt
    networks:
      - traefik-public
    labels:
      # Dashboard
      - "traefik.enable=true"
      - "traefik.http.routers.{{ project_slug }}-traefik.rule=Host(`traefik.${DOMAIN:?DOMAIN is required}`)"
      - "traefik.http.routers.{{ project_slug }}-traefik.entrypoints=websecure"
      - "traefik.http.routers.{{ project_slug }}-traefik.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{ project_slug }}-traefik.service=api@internal"
      - "traefik.http.routers.{{ project_slug }}-traefik.middlewares={{ project_slug }}-auth"
      - "traefik.http.middlewares.{{ project_slug }}-auth.basicauth.users=${TRAEFIK_DASHBOARD_AUTH:?TRAEFIK_DASHBOARD_AUTH is required (htpasswd -nB admin)}"
      # Security headers middleware
      - "traefik.http.middlewares.{{ project_slug }}-security-headers.headers.stsSeconds=31536000"
      - "traefik.http.middlewares.{{ project_slug }}-security-headers.headers.stsIncludeSubdomains=true"
      - "traefik.http.middlewares.{{ project_slug }}-security-headers.headers.stsPreload=true"
      - "traefik.http.middlewares.{{ project_slug }}-security-headers.headers.contentTypeNosniff=true"
      - "traefik.http.middlewares.{{ project_slug }}-security-headers.headers.browserXssFilter=true"
      - "traefik.http.middlewares.{{ project_slug }}-security-headers.headers.referrerPolicy=strict-origin-when-cross-origin"
      - "traefik.http.middlewares.{{ project_slug }}-security-headers.headers.frameDeny=true"
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
{%- endif %}

{%- if include_nginx_service %}
  nginx:
    image: nginx:alpine
    container_name: {{ project_slug }}_nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/ssl:/etc/nginx/ssl:ro
    networks:
      - backend-internal
    depends_on:
      - app
{%- if use_frontend %}
      - frontend
{%- endif %}
    healthcheck:
      test: ["CMD", "nginx", "-t"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 128M
{%- endif %}

  app:
    build:
      context: ./backend
      dockerfile: Dockerfile
    # Keelstone: one image for the API and the workers. The workers used the development image
    # (:dev), so production ran whatever had last been built for development.
    image: {{ project_slug }}_backend:prod
    container_name: {{ project_slug }}_backend
    volumes:
      - media_data:/app/media
{%- if use_chromadb %}
      - chroma_data:/app/chroma_data
{%- endif %}
    env_file:
      - ./backend/.env
{%- if enable_file_storage %}
      # Keelstone: documents in the Garage service (S3 keys in backend/.env).
      - ./garage/storage.env
{%- endif %}
    environment:
      - DEBUG=false
      - ENVIRONMENT=production
      - POSTGRES_HOST=db
{%- if include_traefik_service or include_nginx_service %}
      # The proxy's network (networks below); only it may set the client address and scheme.
      - FORWARDED_ALLOW_IPS=${PROXY_NETWORK_SUBNET:-{{ proxy_network_subnet }}}
{%- elif include_traefik_labels %}
      # The subnet of the external traefik-public network: docker network inspect traefik-public
      - FORWARDED_ALLOW_IPS=${FORWARDED_ALLOW_IPS:?FORWARDED_ALLOW_IPS is required (subnet of traefik-public)}
{%- endif %}
{%- if enable_redis %}
      - REDIS_HOST=redis
{%- endif %}
{%- if use_milvus %}
      - MILVUS_HOST=milvus
      - MILVUS_PORT=19530
{%- endif %}
{%- if use_qdrant %}
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6333
{%- endif %}
{%- if use_celery %}
      - CELERY_BROKER_URL=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/0
      - CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/0
{%- endif %}
{%- if use_taskiq %}
      - TASKIQ_BROKER_URL=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/1
      - TASKIQ_RESULT_BACKEND=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/1
{%- endif %}
    # Keelstone: websockets-sansio as in development (the default implementation breaks the
    # chat WebSocket), and the client address and scheme from the proxy. Uvicorn trusts the
    # X-Forwarded-* headers only from the addresses in FORWARDED_ALLOW_IPS (environment above).
    command: uvicorn app.main:app --host 0.0.0.0 --port {{ backend_port }} --workers 4 --ws websockets-sansio --proxy-headers
{%- if include_traefik_labels %}
    networks:
      - traefik-public
      - backend-internal
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ project_slug }}-api.rule=Host(`api.${DOMAIN:?DOMAIN is required}`)"
      - "traefik.http.routers.{{ project_slug }}-api.entrypoints=websecure"
      - "traefik.http.routers.{{ project_slug }}-api.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{ project_slug }}-api.middlewares={{ project_slug }}-security-headers@docker"
      - "traefik.http.services.{{ project_slug }}-api.loadbalancer.server.port={{ backend_port }}"
      - "traefik.docker.network=traefik-public"
{%- elif include_nginx_service %}
    networks:
      - backend-internal
    # No ports exposed - nginx handles external traffic
{%- else %}
    networks:
      - backend-internal
    ports:
      - "{{ backend_port }}:{{ backend_port }}"
{%- endif %}
    depends_on:
      db:
        condition: service_healthy
{%- if enable_redis %}
      redis:
        condition: service_healthy
{%- endif %}
{%- if use_milvus %}
      milvus:
        condition: service_healthy
{%- endif %}
{%- if use_qdrant %}
      qdrant:
        condition: service_healthy
{%- endif %}
{%- if enable_file_storage %}
      garage-init:
        condition: service_completed_successfully
{%- endif %}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.5'
          memory: 256M


  db:
    image: postgres:16-alpine
    container_name: {{ project_slug }}_db
    environment:
      - POSTGRES_USER=${POSTGRES_USER:-postgres}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required}
      - POSTGRES_DB=${POSTGRES_DB:-{{ project_slug }}}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    # NO external ports - only accessible within backend-internal network
    networks:
      - backend-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M

{%- if enable_redis %}

  redis:
    image: valkey/valkey:9-alpine
    container_name: {{ project_slug }}_redis
    # Keelstone: the password reaches Valkey as a Compose secret (a file in /run/secrets), written
    # to a configuration file readable by the valkey user only; the image's entrypoint then
    # drops root. On the command line (`--requirepass`) it was visible in the process list and
    # in `docker inspect`. The health check reads it into REDISCLI_AUTH for the same reason.
    command:
      - sh
      - -c
      - >-
        umask 077 &&
        printf 'requirepass "%s"\n' "$$(cat /run/secrets/redis_password)" > /tmp/valkey.conf &&
        chown valkey:valkey /tmp/valkey.conf &&
        exec docker-entrypoint.sh valkey-server /tmp/valkey.conf
    secrets:
      - redis_password
    # NO external ports - only accessible within backend-internal network
    volumes:
      - redis_data:/data
    networks:
      - backend-internal
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=\"$$(cat /run/secrets/redis_password)\" valkey-cli ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
      # A restarted container would otherwise report its last status - such as
      # an unhealthy one from a crash loop - before its first check runs.
      start_period: 10s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
{%- endif %}

{%- if use_milvus %}

  etcd:
    image: quay.io/coreos/etcd:v3.7.2
    container_name: {{ project_slug }}_etcd
    volumes:
      - etcd_data:/var/lib/etcd
    networks:
      - backend-internal
    healthcheck:
      test: ["CMD", "etcdctl", "endpoint", "health"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 128M

  minio:
    image: minio/minio:RELEASE.2024-09-22T00-33-43Z
    container_name: {{ project_slug }}_minio
    command: server /data --console-address ":9001"
    # NO external ports - only accessible within backend-internal network
    volumes:
      - minio_data:/data
    environment:
      - MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:?MINIO_ROOT_PASSWORD is required}
    networks:
      - backend-internal
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 10s
      retries: 5
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M

  milvus:
    image: milvusdb/milvus:v2.6.25
    container_name: {{ project_slug }}_milvus
    command: ["milvus", "run", "standalone"]
    # NO external ports - only accessible within backend-internal network
    volumes:
      - milvus_data:/var/lib/milvus
    environment:
      - ETCD_ENDPOINTS=etcd:2379
      - MINIO_ADDRESS=minio:9000
    depends_on:
      etcd:
        condition: service_healthy
      minio:
        condition: service_healthy
    networks:
      - backend-internal
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9091/healthz"]
      # Milvus standalone needs querycoord/datacoord/proxy to converge before
      # /healthz returns 200 — first boot can take 60-180s on Apple Silicon.
      start_period: 90s
      interval: 30s
      timeout: 10s
      retries: 10
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1G
{%- endif %}

{%- if use_qdrant %}

  qdrant:
    image: qdrant/qdrant:v1.19.2
    container_name: {{ project_slug }}_qdrant
    # NO external ports in production - only accessible within backend-internal network
    volumes:
      - qdrant_data:/qdrant/storage
    networks:
      - backend-internal
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:6333/healthz"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
{%- endif %}

{%- if use_celery %}

  celery_worker:
    image: {{ project_slug }}_backend:prod
    pull_policy: never
    # No container_name: it must be unique, and this service runs `replicas: 2`.
    volumes:
      - media_data:/app/media
{%- if use_chromadb %}
      - chroma_data:/app/chroma_data
{%- endif %}
    command: celery -A app.worker.celery_app worker --loglevel=warning --concurrency=4
    env_file:
      - ./backend/.env
{%- if enable_file_storage %}
      # Keelstone: documents in the Garage service (S3 keys in backend/.env).
      - ./garage/storage.env
{%- endif %}
    environment:
      - DEBUG=false
      - ENVIRONMENT=production
{%- if enable_redis %}
      - REDIS_HOST=redis
{%- endif %}
{%- if use_milvus %}
      - MILVUS_HOST=milvus
      - MILVUS_PORT=19530
{%- endif %}
{%- if use_qdrant %}
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6333
{%- endif %}
      - CELERY_BROKER_URL=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/0
      - CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/0
    networks:
      - backend-internal
    depends_on:
      app:
        condition: service_started
      redis:
        condition: service_healthy
      db:
        condition: service_healthy
{%- if use_milvus %}
      milvus:
        condition: service_healthy
{%- endif %}
    restart: unless-stopped
    deploy:
      replicas: 2
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 256M

  celery_beat:
    image: {{ project_slug }}_backend:prod
    pull_policy: never
    container_name: {{ project_slug }}_celery_beat
    command: celery -A app.worker.celery_app beat --loglevel=warning
    env_file:
      - ./backend/.env
    environment:
      - DEBUG=false
      - ENVIRONMENT=production
{%- if enable_redis %}
      - REDIS_HOST=redis
{%- endif %}
{%- if use_milvus %}
      - MILVUS_HOST=milvus
      - MILVUS_PORT=19530
{%- endif %}
{%- if use_qdrant %}
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6333
{%- endif %}
      - CELERY_BROKER_URL=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/0
      - CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/0
    networks:
      - backend-internal
    depends_on:
      app:
        condition: service_started
      redis:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 128M

  flower:
    image: {{ project_slug }}_backend:prod
    pull_policy: never
    container_name: {{ project_slug }}_flower
    command: celery -A app.worker.celery_app flower --port=5555
    env_file:
      - ./backend/.env
    environment:
      - DEBUG=false
      - ENVIRONMENT=production
      - REDIS_HOST=redis
      - CELERY_BROKER_URL=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/0
      - CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/0
      - FLOWER_BASIC_AUTH=${FLOWER_USER:-admin}:${FLOWER_PASSWORD:?FLOWER_PASSWORD is required}
{%- if include_traefik_labels %}
    networks:
      - traefik-public
      - backend-internal
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ project_slug }}-flower.rule=Host(`flower.${DOMAIN:?DOMAIN is required}`)"
      - "traefik.http.routers.{{ project_slug }}-flower.entrypoints=websecure"
      - "traefik.http.routers.{{ project_slug }}-flower.tls.certresolver=letsencrypt"
      - "traefik.http.services.{{ project_slug }}-flower.loadbalancer.server.port=5555"
      - "traefik.docker.network=traefik-public"
{%- elif include_nginx_service %}
    networks:
      - backend-internal
    # No ports exposed - nginx handles external traffic
{%- else %}
    networks:
      - backend-internal
    ports:
      - "5555:5555"
{%- endif %}
    depends_on:
      app:
        condition: service_started
      redis:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 128M
{%- endif %}

{%- if use_taskiq %}

  taskiq_worker:
    image: {{ project_slug }}_backend:prod
    pull_policy: never
    # No container_name: it must be unique, and this service runs `replicas: 2`.
    volumes:
      - media_data:/app/media
{%- if use_chromadb %}
      - chroma_data:/app/chroma_data
{%- endif %}
    command: taskiq worker app.worker.taskiq_worker:broker --workers 4
    env_file:
      - ./backend/.env
{%- if enable_file_storage %}
      # Keelstone: documents in the Garage service (S3 keys in backend/.env).
      - ./garage/storage.env
{%- endif %}
    environment:
      - DEBUG=false
      - ENVIRONMENT=production
      - POSTGRES_HOST=db
{%- if enable_redis %}
      - REDIS_HOST=redis
{%- endif %}
{%- if use_milvus %}
      - MILVUS_HOST=milvus
      - MILVUS_PORT=19530
{%- endif %}
{%- if use_qdrant %}
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6333
{%- endif %}
      - TASKIQ_BROKER_URL=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/1
      - TASKIQ_RESULT_BACKEND=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/1
    networks:
      - backend-internal
    depends_on:
      app:
        condition: service_started
      redis:
        condition: service_healthy
      db:
        condition: service_healthy
{%- if use_milvus %}
      milvus:
        condition: service_healthy
{%- endif %}
    restart: unless-stopped
    deploy:
      replicas: 2
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 256M

  taskiq_scheduler:
    image: {{ project_slug }}_backend:prod
    pull_policy: never
    container_name: {{ project_slug }}_taskiq_scheduler
    command: taskiq scheduler app.worker.taskiq_worker:scheduler
    env_file:
      - ./backend/.env
    environment:
      - DEBUG=false
      - ENVIRONMENT=production
{%- if enable_redis %}
      - REDIS_HOST=redis
{%- endif %}
{%- if use_milvus %}
      - MILVUS_HOST=milvus
      - MILVUS_PORT=19530
{%- endif %}
{%- if use_qdrant %}
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6333
{%- endif %}
      - TASKIQ_BROKER_URL=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/1
      - TASKIQ_RESULT_BACKEND=redis://:${REDIS_PASSWORD:?REDIS_PASSWORD is required}@redis:6379/1
    networks:
      - backend-internal
    depends_on:
      app:
        condition: service_started
      redis:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 128M
{%- endif %}

{%- if use_arq %}

  arq_worker:
    image: {{ project_slug }}_backend:prod
    pull_policy: never
    container_name: {{ project_slug }}_arq_worker
    volumes:
      - media_data:/app/media
{%- if use_chromadb %}
      - chroma_data:/app/chroma_data
{%- endif %}
    command: arq app.worker.arq_app.WorkerSettings
    env_file:
      - ./backend/.env
{%- if enable_file_storage %}
      # Keelstone: documents in the Garage service (S3 keys in backend/.env).
      - ./garage/storage.env
{%- endif %}
    environment:
      - DEBUG=false
      - ENVIRONMENT=production
      - POSTGRES_HOST=db
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_APP_PASSWORD=${POSTGRES_APP_PASSWORD}
{%- if enable_redis %}
      - REDIS_HOST=redis
      - REDIS_PASSWORD=${REDIS_PASSWORD}
{%- endif %}
{%- if use_milvus %}
      - MILVUS_HOST=milvus
      - MILVUS_PORT=19530
{%- endif %}
{%- if use_qdrant %}
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6333
{%- endif %}
      - ARQ_REDIS_HOST=redis
      - ARQ_REDIS_PORT=6379
      - ARQ_REDIS_DB=2
    networks:
      - backend-internal
    depends_on:
      app:
        condition: service_started
      redis:
        condition: service_healthy
      db:
        condition: service_healthy
{%- if use_milvus %}
      milvus:
        condition: service_healthy
{%- endif %}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
{%- endif %}

{%- if use_frontend %}

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      # Keelstone: the React frontend (Vite) reads the API address at build time, from
      # VITE_API_URL; it must be reachable from the browser. Upstream passed the variables of
      # its Next.js frontend, which this one does not read. Rebuild after changing it.
      args:
{%- if include_traefik_labels or include_nginx_service %}
        - VITE_API_URL=${VITE_API_URL:-https://api.${DOMAIN:?DOMAIN is required}}
{%- else %}
        - VITE_API_URL=${VITE_API_URL:-http://${PUBLIC_HOST:-localhost}:{{ backend_port }}}
{%- endif %}
    container_name: {{ project_slug }}_frontend
{%- if include_traefik_labels %}
    networks:
      - traefik-public
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ project_slug }}-frontend.rule=Host(`${DOMAIN:?DOMAIN is required}`)"
      - "traefik.http.routers.{{ project_slug }}-frontend.entrypoints=websecure"
      - "traefik.http.routers.{{ project_slug }}-frontend.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{ project_slug }}-frontend.middlewares={{ project_slug }}-security-headers@docker"
      # nginx serves the built frontend on port 80 (frontend/Dockerfile).
      - "traefik.http.services.{{ project_slug }}-frontend.loadbalancer.server.port=80"
      - "traefik.docker.network=traefik-public"
{%- elif include_nginx_service %}
    networks:
      - backend-internal
    # No ports exposed - nginx handles external traffic
{%- else %}
    networks:
      - backend-internal
    ports:
      - "{{ frontend_port }}:80"
{%- endif %}
    depends_on:
      - app
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
{%- endif %}

{%- if enable_file_storage %}

  # Keelstone: S3-compatible object storage for documents (Garage by Deuxfleurs, AGPLv3, run as
  # a separate service and never linked). GARAGE_RPC_SECRET, GARAGE_ADMIN_TOKEN, S3_ACCESS_KEY
  # and S3_SECRET_KEY are required in backend/.env (see docs/en/concepts/document-storage.md).
  garage:
    image: {{ garage_image }}
    container_name: {{ project_slug }}_garage
    environment: &garage-secrets
      GARAGE_RPC_SECRET: ${GARAGE_RPC_SECRET:?GARAGE_RPC_SECRET is required (openssl rand -hex 32)}
      GARAGE_ADMIN_TOKEN: ${GARAGE_ADMIN_TOKEN:?GARAGE_ADMIN_TOKEN is required (openssl rand -hex 32)}
    volumes:
      - ./garage/garage.toml:/etc/garage.toml:ro
      - garage_meta:/var/lib/garage/meta
      - garage_data:/var/lib/garage/data
    # NO external ports - only accessible within backend-internal network
    networks:
      - backend-internal
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M

  garage-init:
    image: {{ project_slug }}_backend:prod
    pull_policy: never
    container_name: {{ project_slug }}_garage_init
    command: {{ project_slug }} cmd garage-bootstrap
    env_file:
      - ./backend/.env
      - ./garage/storage.env
    # The same values the garage service receives: the bootstrap refuses weak ones, and the API
    # waits for the bootstrap, so a stack with the development values of Garage does not start.
    environment:
      <<: *garage-secrets
      ENVIRONMENT: production
    networks:
      - backend-internal
    depends_on:
      - garage
    restart: "no"
{%- endif %}

networks:
{%- if include_traefik_service %}
  traefik-public:
    driver: bridge
    # Keelstone: a known subnet, the only source the API trusts for X-Forwarded-* headers.
    ipam:
      config:
        - subnet: ${PROXY_NETWORK_SUBNET:-{{ proxy_network_subnet }}}
{%- elif include_traefik_labels %}
  traefik-public:
    external: true
{%- endif %}
  backend-internal:
    driver: bridge
    internal: true
{%- if include_nginx_service %}
    ipam:
      config:
        - subnet: ${PROXY_NETWORK_SUBNET:-{{ proxy_network_subnet }}}
{%- endif %}
{%- if enable_redis %}

secrets:
  # The password of Valkey, read from the environment of `docker compose` (backend/.env or
  # .env.prod-local through --env-file) and mounted as a file, never in the container's Env.
  redis_password:
    environment: REDIS_PASSWORD
{%- endif %}

volumes:
  media_data:
{%- if enable_file_storage %}
  garage_meta:
  garage_data:
{%- endif %}
{%- if use_chromadb %}
  chroma_data:
{%- endif %}
{%- if include_traefik_service %}
  traefik_letsencrypt:
{%- endif %}
  postgres_data:
{%- if enable_redis %}
  redis_data:
{%- endif %}
{%- if use_milvus %}
  etcd_data:
  minio_data:
  milvus_data:
{%- endif %}
{%- if use_qdrant %}
  qdrant_data:
{%- endif %}
{%- else %}
# Docker is disabled for this project
{%- endif %}
