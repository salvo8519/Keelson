# Agent skills published by the maintainers of the components of this project.
# Install or refresh: python scripts/agent_skills.py install   (check: ... check)
# Only official skills are listed, and only for the components this project uses.
# Git sources are pinned to a commit; package sources follow the installed version.
{%- set backend_python = "backend/.venv/bin/python" %}

[[skill]]
name = "fastapi"
maintainer = "FastAPI"
license = "MIT"
path = "{{ 'fastapi/' if keelson_dev | default(false) }}.agents/skills/fastapi"
{%- if keelson_dev | default(false) %}
repository = "https://github.com/fastapi/fastapi"
commit = "05e6df7e906c3decba377c37548019973f40bf15"
{%- else %}
package = "fastapi"
python = "{{ backend_python }}"
{%- endif %}

