{%- if enable_docker and use_frontend %}
# Frontend (React, from the official FastAPI template), built and served by nginx.
# Usage: docker compose -f docker-compose.frontend.yml up -d --build
#
# The backend must be running first (docker compose up -d). VITE_API_URL is baked into the
# bundle at build time and must be reachable by the browser: set PUBLIC_HOST when you open the
# app from another machine, then rebuild.

services:
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        - VITE_API_URL=${VITE_API_URL:-http://${PUBLIC_HOST:-localhost}:{{ backend_port }}}
    container_name: {{ project_slug }}_frontend
    ports:
      - "{{ frontend_port }}:80"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost/"]
      interval: 30s
      timeout: 10s
      start_period: 10s
      retries: 3
{%- else %}
# Frontend is disabled for this project
{%- endif %}
