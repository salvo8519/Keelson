{%- if enable_docker %}
# Keelson: the production stack on this machine, as a rehearsal before a deployment.
#
#   make prod-local        build, start, migrate; secrets generated in .env.prod-local
#   make prod-local-down   stop (data volumes are kept)
#
# Same images, same settings and the same validations as production (ENVIRONMENT=production),
# with three differences: random secrets generated locally, plain HTTP on localhost, and the
# ports published directly on 127.0.0.1 instead of behind Traefik with TLS. Not a deployment.

services:
{%- if include_traefik_service %}
  traefik:
    # Not started: the API and the frontend are published on localhost below.
    profiles: ["proxy"]
{%- endif %}

  app:
    env_file:
      - ./backend/.env
{%- if enable_file_storage %}
      - ./garage/storage.env
{%- endif %}
      - ./.env.prod-local
    environment:
      - FRONTEND_URL=http://localhost:{{ frontend_port }}
      - CORS_ORIGINS=["http://localhost:{{ frontend_port }}"]
{%- if enable_oauth %}
      - PUBLIC_API_URL=http://localhost:{{ backend_port }}
{%- endif %}
    # Published on the loopback interface only: the rehearsal is not reachable from the network.
    ports:
      - "127.0.0.1:{{ backend_port }}:{{ backend_port }}"
{%- for worker in (["celery_worker", "celery_beat"] if use_celery else []) + (["taskiq_worker", "taskiq_scheduler"] if use_taskiq else []) + (["arq_worker"] if use_arq else []) %}

  {{ worker }}:
    env_file:
      - ./backend/.env
{%- if enable_file_storage and worker in ("celery_worker", "taskiq_worker", "arq_worker") %}
      - ./garage/storage.env
{%- endif %}
      - ./.env.prod-local
{%- endfor %}
{%- if enable_file_storage %}

  # Garage reads its secrets from .env.prod-local through the interpolation of
  # docker-compose.prod.yml; the bootstrap reads the S3 key from the same file.
  garage-init:
    env_file:
      - ./backend/.env
      - ./garage/storage.env
      - ./.env.prod-local
{%- endif %}
{%- if use_frontend %}

  frontend:
    build:
      args:
        - VITE_API_URL=http://localhost:{{ backend_port }}
    ports:
      - "127.0.0.1:{{ frontend_port }}:80"
{%- endif %}
{%- endif %}
