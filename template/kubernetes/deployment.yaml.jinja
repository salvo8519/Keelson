{%- if enable_kubernetes %}
# Deployment for {{ project_name }} Backend
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_slug }}-backend
  namespace: {{ project_slug }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    app.kubernetes.io/component: backend
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ project_slug }}
      app.kubernetes.io/component: backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ project_slug }}
        app.kubernetes.io/component: backend
{%- if enable_prometheus %}
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "{{ backend_port }}"
        prometheus.io/path: "/metrics"
{%- endif %}
    spec:
      containers:
        - name: backend
          image: {{ project_slug }}:latest
          imagePullPolicy: Always
          ports:
            - containerPort: {{ backend_port }}
              name: http
          envFrom:
            - configMapRef:
                name: {{ project_slug }}-config
            - secretRef:
                name: {{ project_slug }}-secrets
          resources:
            requests:
              memory: "256Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "500m"
          livenessProbe:
            httpGet:
              path: /api/v1/health
              port: {{ backend_port }}
            initialDelaySeconds: 10
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /api/v1/ready
              port: {{ backend_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          volumeMounts:
            - name: media-data
              mountPath: /app/media
{%- if use_chromadb %}
            - name: chroma-data
              mountPath: /app/chroma_data
{%- endif %}
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
      volumes:
        - name: media-data
          persistentVolumeClaim:
            claimName: {{ project_slug }}-media
{%- if use_chromadb %}
        - name: chroma-data
          persistentVolumeClaim:
            claimName: {{ project_slug }}-chroma
{%- endif %}
      restartPolicy: Always

---
{%- if use_celery %}
# Celery Worker Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_slug }}-celery-worker
  namespace: {{ project_slug }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    app.kubernetes.io/component: celery-worker
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ project_slug }}
      app.kubernetes.io/component: celery-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ project_slug }}
        app.kubernetes.io/component: celery-worker
    spec:
      containers:
        - name: celery-worker
          image: {{ project_slug }}:latest
          imagePullPolicy: Always
          command: ["celery", "-A", "app.worker.celery_app", "worker", "--loglevel=info"]
          envFrom:
            - configMapRef:
                name: {{ project_slug }}-config
            - secretRef:
                name: {{ project_slug }}-secrets
          resources:
            requests:
              memory: "256Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "500m"
      restartPolicy: Always

---
# Celery Beat Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_slug }}-celery-beat
  namespace: {{ project_slug }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    app.kubernetes.io/component: celery-beat
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ project_slug }}
      app.kubernetes.io/component: celery-beat
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ project_slug }}
        app.kubernetes.io/component: celery-beat
    spec:
      containers:
        - name: celery-beat
          image: {{ project_slug }}:latest
          imagePullPolicy: Always
          command: ["celery", "-A", "app.worker.celery_app", "beat", "--loglevel=info"]
          envFrom:
            - configMapRef:
                name: {{ project_slug }}-config
            - secretRef:
                name: {{ project_slug }}-secrets
          resources:
            requests:
              memory: "128Mi"
              cpu: "50m"
            limits:
              memory: "256Mi"
              cpu: "200m"
      restartPolicy: Always
{%- endif %}

{%- if use_taskiq %}
---
# Taskiq Worker Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_slug }}-taskiq-worker
  namespace: {{ project_slug }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    app.kubernetes.io/component: taskiq-worker
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ project_slug }}
      app.kubernetes.io/component: taskiq-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ project_slug }}
        app.kubernetes.io/component: taskiq-worker
    spec:
      containers:
        - name: taskiq-worker
          image: {{ project_slug }}:latest
          imagePullPolicy: Always
          command: ["taskiq", "worker", "app.worker.taskiq_worker:broker", "--workers", "2"]
          envFrom:
            - configMapRef:
                name: {{ project_slug }}-config
            - secretRef:
                name: {{ project_slug }}-secrets
          resources:
            requests:
              memory: "256Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "500m"
      restartPolicy: Always
---
# Taskiq Scheduler Deployment (Keelstone: exactly one replica, so each schedule fires once)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_slug }}-taskiq-scheduler
  namespace: {{ project_slug }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    app.kubernetes.io/component: taskiq-scheduler
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ project_slug }}
      app.kubernetes.io/component: taskiq-scheduler
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ project_slug }}
        app.kubernetes.io/component: taskiq-scheduler
    spec:
      containers:
        - name: taskiq-scheduler
          image: {{ project_slug }}:latest
          imagePullPolicy: Always
          command: ["taskiq", "scheduler", "app.worker.taskiq_worker:scheduler"]
          envFrom:
            - configMapRef:
                name: {{ project_slug }}-config
            - secretRef:
                name: {{ project_slug }}-secrets
          resources:
            requests:
              memory: "128Mi"
              cpu: "50m"
            limits:
              memory: "256Mi"
              cpu: "250m"
      restartPolicy: Always
{%- endif %}

{%- if use_arq %}
---
# ARQ Worker Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_slug }}-arq-worker
  namespace: {{ project_slug }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    app.kubernetes.io/component: arq-worker
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ project_slug }}
      app.kubernetes.io/component: arq-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ project_slug }}
        app.kubernetes.io/component: arq-worker
    spec:
      containers:
        - name: arq-worker
          image: {{ project_slug }}:latest
          imagePullPolicy: Always
          command: ["arq", "app.worker.arq_app.WorkerSettings"]
          envFrom:
            - configMapRef:
                name: {{ project_slug }}-config
            - secretRef:
                name: {{ project_slug }}-secrets
          resources:
            requests:
              memory: "256Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "500m"
      restartPolicy: Always
{%- endif %}
{%- else %}
# Kubernetes is disabled for this project
{%- endif %}
