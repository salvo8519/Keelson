{%- if enable_kubernetes %}
# Ingress for {{ project_name }}
# Configure your domain and TLS settings before deploying
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ project_slug }}-ingress
  namespace: {{ project_slug }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    app.kubernetes.io/component: ingress
  annotations:
    # Nginx Ingress Controller annotations
    nginx.ingress.kubernetes.io/proxy-body-size: "10m"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "60"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "60"
{%- if enable_rate_limiting %}
    # Rate limiting (adjust as needed)
    nginx.ingress.kubernetes.io/limit-rps: "100"
    nginx.ingress.kubernetes.io/limit-connections: "50"
{%- endif %}
    # Uncomment for Let's Encrypt with cert-manager
    # cert-manager.io/cluster-issuer: "letsencrypt-prod"
spec:
  ingressClassName: nginx
  # Uncomment for TLS
  # tls:
  #   - hosts:
  #       - api.example.com
  #     secretName: {{ project_slug }}-tls
  rules:
    - host: api.example.com  # Replace with your domain
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ project_slug }}-backend
                port:
                  number: {{ backend_port }}
{%- else %}
# Kubernetes is disabled for this project
{%- endif %}
