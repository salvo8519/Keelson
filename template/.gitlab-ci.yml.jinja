{%- if use_gitlab_ci %}
# GitLab CI/CD Pipeline for {{ project_name }}

stages:
  - lint
  - test
  - docs
  - security
{%- if enable_docker %}
  - build
{%- endif %}

variables:
  PYTHON_VERSION: "{{ python_version }}"
  # Keelstone: the uv release is pinned, and every job installs the versions recorded in uv.lock.
  UV_VERSION: "{{ uv_version }}"
  PIP_CACHE_DIR: "$CI_PROJECT_DIR/.cache/pip"
  UV_CACHE_DIR: "$CI_PROJECT_DIR/.cache/uv"

# Cache configuration
.cache_config: &cache_config
  cache:
    key: "$CI_COMMIT_REF_SLUG"
    paths:
      - .cache/pip
      - .cache/uv
      - backend/.venv

# Base Python job template
.python_base:
  image: python:${PYTHON_VERSION}-slim
  before_script:
    - pip install "uv==$UV_VERSION"
    - cd backend
    - uv sync --locked --dev
  <<: *cache_config

# =============================================================================
# Lint Stage
# =============================================================================

ruff-check:
  stage: lint
  extends: .python_base
  script:
    - uv run ruff check app tests cli
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

ruff-format:
  stage: lint
  extends: .python_base
  script:
    - uv run ruff format app tests cli --check
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

ty:
  stage: lint
  extends: .python_base
  script:
    - uv run ty check
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

i18n-check:
  stage: lint
  extends: .python_base
  script:
    - uv run python -m app.core.i18n_catalog check
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

# Keelstone: openapi/openapi.json is the contract of the API. It must match the code, and a merge
# request must not break it (scripts/openapi-breaking.sh: pinned oasdiff, checksum verified).
api-contract:
  stage: lint
  extends: .python_base
  variables:
    GIT_DEPTH: "0"
  script:
    - uv run python ../scripts/openapi.py check
    - |
      if [ "$CI_PIPELINE_SOURCE" = "merge_request_event" ]; then
        cd "$CI_PROJECT_DIR"
        apt-get update -qq && apt-get install -y -qq curl git >/dev/null
        git fetch --depth=1 origin "$CI_MERGE_REQUEST_TARGET_BRANCH_NAME"
        sh scripts/openapi-breaking.sh "origin/$CI_MERGE_REQUEST_TARGET_BRANCH_NAME"
      fi
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
{%- if use_frontend %}

# Keelstone: the official React frontend (Biome, translations, tsc and Vite). Its Playwright
# suite needs a running stack and is not part of this job.
frontend:
  stage: lint
  image: oven/bun:{{ bun_version }}
  before_script:
    - cd frontend
    - bun install --frozen-lockfile
  script:
    - bunx biome check ./
    - bun run i18n:check
    - bun run build
    # Keelstone: known vulnerabilities in the frontend dependencies.
    - bun audit --audit-level=high
  cache:
    key: "$CI_COMMIT_REF_SLUG-frontend"
    paths:
      - frontend/node_modules
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
{%- endif %}

# =============================================================================
# Test Stage
# =============================================================================

test:
  stage: test
  image: python:${PYTHON_VERSION}-slim
  services:
    - name: postgres:16-alpine
      alias: postgres
      variables:
        POSTGRES_USER: postgres
        POSTGRES_PASSWORD: postgres
        POSTGRES_DB: test_db
{%- if enable_redis %}
    - name: valkey/valkey:9-alpine
      alias: redis
{%- endif %}
  variables:
    POSTGRES_HOST: postgres
    POSTGRES_PORT: "5432"
    POSTGRES_USER: postgres
    POSTGRES_PASSWORD: postgres
    POSTGRES_DB: test_db
{%- if enable_redis %}
    REDIS_HOST: redis
    REDIS_PORT: "6379"
{%- endif %}
  before_script:
    - pip install "uv==$UV_VERSION"
    - cd backend
    - uv sync --locked --dev
  script:
    - uv run pytest tests/ -v --cov=app --cov-report=xml --cov-report=term-missing
  coverage: '/(?i)total.*? (100(?:\.0+)?\%|[1-9]?\d(?:\.\d+)?\%)$/'
  artifacts:
    reports:
      coverage_report:
        coverage_format: cobertura
        path: backend/coverage.xml
    expire_in: 1 week
  <<: *cache_config
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

# =============================================================================
# Security Stage
# =============================================================================

security-scan:
  stage: security
  extends: .python_base
  script:
    # pip-audit is a dev dependency, at the version recorded in uv.lock.
    - uv run pip-audit --require-hashes=false --progress-spinner=off
    # Keelstone: agent skills are pinned (commit and content digest) and scanned before install.
    - apt-get update -qq && apt-get install -y -qq git >/dev/null
    - cd "$CI_PROJECT_DIR" && python3 scripts/agent_skills.py install && python3 scripts/agent_skills.py scan
  # Keelstone: a known vulnerability or a refused skill fails the pipeline (upstream allowed it).
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

# Keelstone: secrets committed by mistake, in the whole history (gitleaks, pinned).
secret-scan:
  stage: security
  image:
    name: ghcr.io/gitleaks/gitleaks:v8.30.1
    entrypoint: [""]
  variables:
    GIT_DEPTH: "0"
  script:
    - gitleaks git "$CI_PROJECT_DIR" --redact --no-banner --exit-code 1
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

{%- if enable_docker %}

# =============================================================================
# Build Stage
# =============================================================================

docker-build:
  stage: build
  image: docker:24
  services:
    - docker:24-dind
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  before_script:
    - docker info
  script:
    - docker build -t {{ project_slug }}:$CI_COMMIT_SHORT_SHA ./backend
    - docker tag {{ project_slug }}:$CI_COMMIT_SHORT_SHA {{ project_slug }}:latest
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

# Optional: Push to GitLab Container Registry
