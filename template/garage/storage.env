# Object storage settings of the Compose stacks: the Garage service on the internal network.
# No secret here: S3_ACCESS_KEY and S3_SECRET_KEY come from backend/.env (production) or
# development.env (development).
STORAGE_BACKEND=s3
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ADDRESSING_STYLE=path
GARAGE_ADMIN_URL=http://garage:3903
